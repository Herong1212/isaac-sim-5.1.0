{
    "version": 1,
    "apiVersion": "1.0",
    "name": "Simple Controller",
    "interactionProfile": "/interaction_profiles/khr/simple_controller",
    "bindings": [
        {
            "devices": [
                {
                    "devicePath": "/user/hand/left",
                    "deviceType": "controller"
                },
                {
                    "devicePath": "/user/hand/right",
                    "deviceType": "controller"
                }
            ],
            "inputs": [
                {
                    "input": "select",
                    "gestures": [
                        "click"
                    ]
                },
                {
                    "input": "menu",
                    "gestures": [
                        "click"
                    ]
                }
            ],
            "poses": [
                {
                    "pose": "grip"
                },
                {
                    "pose": "aim"
                },
                {
                    "pose": "grip_surface",
                    "apiVersion": "1.1"
                },
                {
                    "pose": "grip_surface",
                    "extension": "XR_KHR_maintenance1"
                },
                {
                    "pose": "palm_ext",
                    "extension": "XR_EXT_palm_pose"
                },
                {
                    "pose": "pinch_ext",
                    "extension": "XR_EXT_hand_interaction"
                },
                {
                    "pose": "poke_ext",
                    "extension": "XR_EXT_hand_interaction"
                }
            ],
            "outputs": [
                {
                    "output": "haptic"
                }
            ],
            "defaultPose": "aim"
        }
    ]
}
