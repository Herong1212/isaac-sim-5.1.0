    def OmniGraphNode "Template_omni_physx_graph_ImmediateComputeGeometryRaycastHits" (
        docs="""Compute geometry intersections with an input ray (currently supports mesh prims)"""
    )
    {
        token node:type = "omni.physx.graph.ImmediateComputeGeometryRaycastHits"
        int node:typeVersion = 1

        # 7 attributes
        custom bool inputs:bothSides = false (
            docs="""Sets whether backfaces of meshes should be included in checks."""
        )
        custom token inputs:direction (
            docs="""Ray direction vector"""
        )
        custom uint inputs:execIn (
            docs="""Input execution"""
        )
        custom token inputs:origin (
            docs="""Ray origin"""
        )
        custom rel inputs:prims (
            docs="""Prims of interest (currently only supports mesh prims). 
Note: if this input is present, the Prims bundle input is ignored."""
        )
        custom rel inputs:primsBundle (
            docs="""The prims of interest as a bundle. It must be a bundle with one or more prim children.
Currently only meshes prim are supported (sourcePrimType == 'Mesh').
From each Mesh prim child reads:
 - 'sourcePrimPath'
 - 'sourcePrimType'
 - 'points'
 - 'faceVertexIndices'
 - 'faceVertexCounts'
 - 'worldMatrix'
 - 'sourcePrimPath'
(and optionally 'holeIndices', 'orientation', 'meshKey' and 'physics:approximation') attributes"""
        )
        custom token inputs:raycastRange (
            docs="""Raycast distance. Use negative for infinite. If omitted, infinity is used."""
        )

        # 6 attributes
        custom float[] outputs:distances (
            docs="""A list of distances from the origin to the points hit."""
        )
        custom uint outputs:execOut (
            docs="""Output execution"""
        )
        custom int[] outputs:faceIndexes (
            docs="""A list of the face indexes of the points hit."""
        )
        custom normal3f[] outputs:normals (
            docs="""A list of surface normals of the points hit."""
        )
        custom point3f[] outputs:positions (
            docs="""A list of positions of the points hit."""
        )
        custom rel outputs:primsHit (
            docs="""A list of prims that are hit by the input ray."""
        )
    }
