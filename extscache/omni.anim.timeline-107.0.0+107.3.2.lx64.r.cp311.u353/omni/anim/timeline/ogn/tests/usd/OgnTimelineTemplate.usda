#usda 1.0
(
    doc ="""Generated from node description file OgnTimeline.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_anim_Timeline" (
        docs="""Timeline Node is a node that lets you create animation curve(s), plays back and samples the value(s) along its time to output values."""
    )
    {
        token node:type = "omni.anim.Timeline"
        int node:typeVersion = 2

        # 10 attributes
        custom double inputs:framerate = 24.0 (
            docs="""Playback frame rate"""
        )
        custom double inputs:length = 10.0 (
            docs="""Duration of the Timeline node in seconds"""
        )
        custom bool inputs:loop = false (
            docs="""Whether animation should loop when reaches the end (or beginning if playing backwards)"""
        )
        custom double inputs:newTime = 0.0 (
            docs="""New time to set then "Set New Time" is triggered"""
        )
        custom uint inputs:play (
            docs="""Play the timeline from current time"""
        )
        custom uint inputs:playFromStart (
            docs="""Play the timeline from start"""
        )
        custom uint inputs:reverse (
            docs="""Play the timeline backwards from current time"""
        )
        custom uint inputs:reverseFromEnd (
            docs="""Play the timeline backwards from end"""
        )
        custom uint inputs:setNewTime (
            docs="""Set timeline to new time defined in "New Time" input"""
        )
        custom uint inputs:stop (
            docs="""Stop playback at current time"""
        )

        # 2 attributes
        custom uint outputs:finished (
            docs="""The Timeline node has finished the playback"""
        )
        custom uint outputs:updated (
            docs="""The Timeline node is ticked and output value(s) resampled and updated"""
        )
    }
}
