        custom int inputs:numberOfPoints = 10 (
            docs="""Number of points to randomly sample on the curve (if nothing is connected to the uValue input)"""
        )
        custom int inputs:randomSeed = 0 (
            docs="""Seed for random number generator for u-value distribution (if nothing is connected to the uValue input)"""
        )
        custom int inputs:samplingMode = 0 (
            docs="""Sampling mode: 0 -- sample from an input array connect to the uValues input, 1 -- sample from a random distribution generated using the timeBasedSeed, randomSeed, and numberOfPoints inputs"""
        )
        custom bool inputs:timeBasedSeed = false (
            docs="""If true, random seed will vary with time; if false random numbers will be the same each frame."""
        )
        custom float[] inputs:uValues = [] (
            docs="""Parametric values from zero to one at which to sample points on the curve"""
        )

        # 2 attributes
        custom float3[] outputs:points (
            docs="""Point on input curve"""
        )
        custom float3[] outputs:tangents (
            docs="""Curve tangent at point"""
        )

        # 5 attributes
        custom int state:prevNumberOfPoints (
