#usda 1.0
(
    doc ="""Generated from node description file OgnGetCurveData.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_genproc_core_GetCurveData" (
        docs="""Extract curve data from the first curve found in the input bundle.  If the input bundle contains ramp and tag data, e.g. from an upstream TagPrimsFromRamp  node, the ramp will be evaluated and used to add a tag corresponding to each point."""
    )
    {
        token node:type = "omni.genproc.core.GetCurveData"
        int node:typeVersion = 1

        # 6 attributes
        custom rel inputs:curvesBundle (
            docs="""Bundle containing curves data"""
        )
        custom token inputs:rampInterpolationsName = "ramp_interpolations" (
            docs="""Name of bundle attribute containing ramp interpolations. 
            If no such attribute exists, the tags output will be empty."""
        )
        custom token inputs:rampPositionsName = "ramp_positions" (
            docs="""Name of bundle attribute containing ramp positions. 
            If no such attribute exists, the tags output will be empty."""
        )
        custom token inputs:rampTagsName = "tags" (
            docs="""Name of bundle attribute containing ramp tags. 
            If no such attribute exists, the tags output will be empty."""
        )
        custom token inputs:rampValuesName = "ramp_values" (
            docs="""Name of bundle attribute containing ramp values. 
            If no such attribute exists, the tags output will be empty."""
        )
        custom int inputs:samplesPerSegment = 100 (
            docs="""Number of points in each curve segment's tessellation"""
        )

        # 4 attributes
        custom float3[] outputs:points (
            docs="""Vertices along the curve"""
        )
        custom token[] outputs:tags (
            docs="""Per-point tag value, provided only if valid ramp data is provided in the input bundle"""
        )
        custom float3[] outputs:tangents (
            docs="""Curve tangents at each vertex"""
        )
        custom float[] outputs:uValues (
            docs="""Parametric value from zero to one along the curve for each vertex"""
        )

        # 5 attributes
        custom token state:prevRampInterpolationsName (
            docs="""Previous rampInterpolationsName value for recompute test"""
        )
        custom token state:prevRampPositionsName (
            docs="""Previous rampPositionsName value for recompute test"""
        )
        custom token state:prevRampTagsName (
            docs="""Previous rampTagsName value for recompute test"""
        )
        custom token state:prevRampValuesName (
            docs="""Previous rampValuesName value for recompute test"""
        )
        custom int state:prevSamplesPerSegment (
            docs="""Previous samplesPerSegment value for recompute test"""
        )
    }
}
