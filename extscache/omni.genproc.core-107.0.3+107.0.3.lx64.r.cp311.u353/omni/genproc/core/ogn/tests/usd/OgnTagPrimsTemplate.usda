def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_genproc_core_TagPrims" (
        docs="""Add tag attribute to prims in bundle"""
    )
    {
        token node:type = "omni.genproc.core.TagPrims"
        int node:typeVersion = 1

        # 3 attributes
        custom rel inputs:bundle (
            docs="""Multiple Prims in Bundle input"""
        )
        custom token inputs:tagName = "tag" (
            docs="""Name of tag attribute that will be added to prims"""
        )
        custom token inputs:tagValue = "" (
            docs="""Value to be assigned to tag"""
        )

        # 1 attribute
        custom rel outputs_bundle (
            docs="""Multiple Prims in Bundle with tag added"""
        )

        # 2 attributes
        custom token state:prevTagName (
            docs="""Previous tagName value for recompute test"""
        )
        custom token state:prevTagValue (
            docs="""Previous tagValue value for recompute test"""
        )
    }
}
