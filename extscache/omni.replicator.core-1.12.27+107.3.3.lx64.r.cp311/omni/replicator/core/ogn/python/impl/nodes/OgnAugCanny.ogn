{
    "AugCanny": {
        "version": 1,
        "scheduling": "compute-on-request",
        "description": "This node applies the Canny algorithm to retrieve edges from an RGB image.",
        "language": "Python",
        "cudaPointers": "cpu",
        "categories": {
            "Replicator": "AugCanny"
        },
        "state": {
            "$comment": ["Internal state"]
        },
        "inputs": {
            "exec": {
                "type": "execution",
                "description": "Trigger"
            },
            "data": {
                "type": "uchar[]",
                "memoryType": "cuda",
                "description": "Buffer array data",
                "default": []
            },
            "dataPtr": {
                "type": "uint64",
                "description": "Pointer to the raw data (cuda device pointer or host pointer)",
                "default": 0
            },
            "cudaDeviceIndex": {
                "type": "int",
                "description": "Index of the device where the data lives (-1 for host data)",
                "default": -1
            },
            "strides": {
                "type": "int[2]",
                "description": "Strides (in bytes) ([0,0] if the input is a buffer)"
            },
            "bufferSize": {
                "type": "uint",
                "description": "Size (in bytes) of the buffer (0 if the input is a texture)"
            },
            "width": {
                "type": "uint",
                "description": "Width"
            },
            "height": {
                "type": "uint",
                "description": "Height"
            },
            "format": {
                "type": "uint64",
                "description": "Format"
            },
            "thresholdLow": {
                "type": "float",
                "description": "Low threshold for the hysteresis procedure",
                "default": 50.0
            },
            "thresholdHigh": {
                "type": "float",
                "description": "High threshold for the hysteresis procedure",
                "default": 100.0
            }
        },
        "outputs": {
            "exec": {
                "type": "execution",
                "description": "Trigger"
            },
            "dataPtr": {
                "type": "uint64",
                "description": "Pointer to the raw data (cuda device pointer or host pointer)",
                "default": 0
            },
            "cudaDeviceIndex": {
                "type": "int",
                "description": "Index of the device where the data lives (-1 for host data)",
                "default": -1
            },
            "bufferSize": {
                "type": "uint",
                "description": "Size (in bytes) of the buffer (0 if the input is a texture)"
            },
            "height": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "width": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "strides": {
                "type": "int[2]",
                "description": "Strides (in bytes) ([0,0] if the input is a buffer)"
            }
        }
    }
}
