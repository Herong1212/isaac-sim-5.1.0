{
    "OgnSampleOmniPBR": {
        "version": 1,
        "language": "python",
        "categories": {"Replicator:Core": "Core Replicator nodes"},
        "description": "Randomizes the texture of the specified prims.",
        "scheduling": "compute-on-request",
        "metadata":
        {
           "uiName": "Texture Randomizer"
        },
        "state": {
            "$comment": ["Internal state to store materials"]
        },
        "inputs": {
            "prims": {
                "description": ["Prim(s) to set OmniPBR material"],
                "type": "target"
            },
            "diffuseTexture": {
                "description": ["Paths to the diffuse textures to be sampled"],
                "type": "token[]"
            },
            "textureScale": {
                "description": ["Diffuse textures scaling factor"],
                "type": "float[2][]"
            },
            "textureRotate": {
                "description": ["Diffuse textures rotating factor"],
                "type": "float[]"
            },
            "diffuse": {
                "description": ["Diffuse colour"],
                "type": "colorf[3][]"
            },
            "metallicTexture": {
                "description": ["Paths to the metallic textures to be sampled"],
                "type": "token[]"
            },
            "metallic": {
                "description": ["Metallic value"],
                "type": "float[]"
            },
            "roughnessTexture": {
                "description": ["Paths to the roughness textures to be sampled"],
                "type": "token[]"
            },
            "roughness": {
                "description": ["Roughness value"],
                "type": "float[]"
            },
            "mode": {
                "description": ["Specifies how to apply randomized materials. Choose from [prims, meshes]"],
                "type": "token",
                "default": "prims"
            },
            "projectUVW": {
                "description": ["When enabled, UV coordinates will be generated by projecting them from a coordinate system."],
                "type": "bool",
                "default": false
            },
            "execIn": {
                "description": ["exec"],
                "type": "execution"
            }
        },
        "outputs": {
            "execOut": {
                "description": ["exec"],
                "type": "execution"
            }
        }
    }
}
