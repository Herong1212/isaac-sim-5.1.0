{
    "SemanticSegmentation": {
        "version": 1,
        "scheduling": "compute-on-request",
        "description": "This node outputs the semantic segmentation.",
        "language": "Python",
        "cudaPointers": "cpu",
        "categories": {"Replicator:Annotators": "Replicator annotator nodes."},
        "state": {
            "$comment": ["Internal state"]
        },
        "inputs": {
            "exec": {
                "type": "execution",
                "description": "Trigger"
            },
            "instanceSegmentationPtr": {
                "type": "uint64",
                "description": "Pointer to the raw instance segmetation data",
                "default": 0
            },
            "instanceSegmentationStrides": {
                "type": "int[2]",
                "description": "Strides (in bytes) for InstanceSegmentationSD."
            },
            "instanceSegmentationCudaDeviceIndex": {
                "type": "int",
                "description": "Index of the device where the data lives (-1 for host data) for instance segmentationSD",
                "default": -1
            },
            "semanticFilterName": {
                "type": "token",
                "description": "name of Semantic Filter to use",
                "default": ""
            },
            "mapping": {
                "type": "string",
                "description": "Optional mapping enforcing semantics to specific IDs or colors.",
                "default": "{}"
            },
            "ids": {
                "type": "uint[]",
                "description": "Unoccluded semantic u ids (or color, if `colorize` is set to True)."
            },
            "labels": {
                "type": "token[]",
                "description": "Prim path of the prim."
            },
            "semantics": {
                "type": "token[]",
                "description": "Semantic labels that correspond to the ids."
            },
            "bufferSize": {
                "type": "uint",
                "description": "Size (in bytes) of the buffer (0 if the input is a texture)"
            },
            "height": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "width": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "colorize": {
                "type": "bool",
                "description" : "If true, convert semantic IDs into colors.",
                "default": false
            }
        },
        "outputs": {
            "exec": {
                "type": "execution",
                "description": "Trigger"
            },
            "dataPtr": {
                "type": "uint64",
                "description": "Pointer to the raw data (host pointer)",
                "default": 0
            },
            "strides": {
                "type": "int[2]",
                "description": "Strides (in bytes)."
            },
            "dataShape": {
                "type": "int[]",
                "description": "Desired dimensions of output array"
            },
            "cudaDeviceIndex": {
                "type": "int",
                "description": "Index of the device where the data lives (-1 for host data)",
                "default": -1
            },
            "ids": {
                "type": "uint[]",
                "description": "Unoccluded semantic u ids (or color, if `colorize` is set to True)."
            },
            "labels": {
                "type": "token[]",
                "description": "Prim path of the prim."
            },
            "bufferSize": {
                "type": "uint",
                "description": "Size (in bytes) of the buffer (0 if the input is a texture)"
            },
            "height": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "width": {
                "type": "uint",
                "description": "Shape of the data"
            },
            "dataType": {
                "type": "token",
                "description": "Defines the data type",
                "default": "uint8"
            },
            "_legacyIDs": {
                "type": "bool",
                "description": "If True, ids will be converted to strings for backwards compatibility",
                "default": true
            }
        }
    }
}
