export float3 ProjectNormal(
    //normalmap_texture
    uniform texture_2d normalmap_texture = texture_2d() [[
        anno::display_name("Normal Map"),
        anno::in_group("Geometry"),
        anno::description("Projects a normal map along an axis. Masks by the alpha mask in RBGA.")
    ]],
    // Projection Primvars
    uniform string projection_position = string("projection_position") [[
        anno::display_name("Projection Position"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_quat = string("projection_quat") [[
        anno::display_name("Projection Quaternion"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_scale = string("projection_scale") [[
        anno::display_name("Projection Scale"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_unitscale = string("projection_unitscale") [[
        anno::display_name("Projection StageMetersPerUnit"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]]
)
[[ anno::display_name("Project Normals"),
   anno::thumbnail(".thumbs/hex.png"),
   anno::in_group("Replicator"),
   anno::author("NVIDIA CORPORATION")]]
   {
    // Get the primvars for the projection
    float3 p_position = ::scene::data_lookup_float3(projection_position, float3(1.0));
    float3 p_scale = ::scene::data_lookup_float3(projection_scale, float3(1.0));
    float4 p_quat = ::scene::data_lookup_float4(projection_quat, float4(1.0));
    float p_unitscale = ::scene::data_lookup_float(projection_unitscale, float(0.01));

    // Use quat to get forward, up, right vectors for projection
    float3 p_right = mul_quat_by_vector(p_quat, float3(1.0,0.0,0.0));
    float3 p_up = mul_quat_by_vector(p_quat, float3(0.0,1.0,0.0));
    float3 p_forward = mul_quat_by_vector(p_quat, float3(0.0,0.0,-1.0));
    
    //
    float2 uv = projectionuvs(p_position, p_scale, p_forward, p_right, p_up, p_unitscale);

    // Mask out normals that face away from the projection
    float normal_clip = math::ceil(math::max(math::dot(state::normal(), p_right*-1.0) * -1.0f, 0.0f));

    float xmax = (uv.x >= 1.0) ? 0.0 : 1.0;
    float xmin = (uv.x <= 0.0) ? 0.0 : 1.0;
    float ymax = (uv.y >= 1.0) ? 0.0 : 1.0;
    float ymin = (uv.y <= 0.0) ? 0.0 : 1.0;
    float uv_bounds = xmax * xmin * ymax * ymin * normal_clip;

    float4 normaltex_pixel = tex::lookup_float4(normalmap_texture, uv, tex::wrap_clamp, tex::wrap_clamp, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);
    
    float3 u = math::normalize((p_forward * remap(normaltex_pixel.x, 0.0, 1.0, -1.0, 1.0)) + (p_up * remap(normaltex_pixel.y, 0.0, 1.0, -1.0, 1.0)) + (p_right * normaltex_pixel.z));
    float3 t = state::normal();
    float3 axis = float3(0.0, 0.0, 1.0);
    float3 s = (p_forward * axis.x) + (p_up * axis.y) + (p_right * axis.z);

    float3 normal_pixel = math::lerp(state::normal(), reorient_normal(t, u, s), normaltex_pixel.w * uv_bounds);
    return float3(normal_pixel.x, normal_pixel.y, normal_pixel.z);
}


export float ProjectMask(
    //mask_texture
    uniform texture_2d mask_texture = texture_2d() [[
        anno::display_name("Mask Map"),
        anno::in_group("Geometry"),
        anno::description("Projects a normal map along an axis. Masks by the alpha mask in RBGA.")
    ]],
    // Projection Primvars
    uniform string projection_position = string("projection_position") [[
        anno::display_name("Projection Position"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_quat = string("projection_quat") [[
        anno::display_name("Projection Quaternion"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_scale = string("projection_scale") [[
        anno::display_name("Projection Scale"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]],
    uniform string projection_unitscale = string("projection_unitscale") [[
        anno::display_name("Projection StageMetersPerUnit"),
        anno::in_group("Projection"),
        anno::usage("normal")
    ]]
)
[[ anno::display_name("Project Mask"),
   anno::thumbnail(".thumbs/hex.png"),
   anno::in_group("Replicator"),
   anno::author("NVIDIA CORPORATION")]]
   {
    // Get the primvars for the projection
    float3 p_position = ::scene::data_lookup_float3(projection_position, float3(1.0));
    float3 p_scale = ::scene::data_lookup_float3(projection_scale, float3(1.0));
    float4 p_quat = ::scene::data_lookup_float4(projection_quat, float4(1.0));
    float p_unitscale = ::scene::data_lookup_float(projection_unitscale, float(0.01));

    // Use quat to get forward, up, right vectors for projection
    float3 p_right = mul_quat_by_vector(p_quat, float3(1.0,0.0,0.0));
    float3 p_up = mul_quat_by_vector(p_quat, float3(0.0,1.0,0.0));
    float3 p_forward = mul_quat_by_vector(p_quat, float3(0.0,0.0,-1.0));
    
    //
    float2 uv = projectionuvs(p_position, p_scale, p_forward, p_right, p_up, p_unitscale);

    // Mask out normals that face away from the projection
    float normal_clip = math::ceil(math::max(math::dot(state::normal(), p_right*-1.0) * -1.0f, 0.0f));

    float xmax = (uv.x >= 1.0) ? 0.0 : 1.0;
    float xmin = (uv.x <= 0.0) ? 0.0 : 1.0;
    float ymax = (uv.y >= 1.0) ? 0.0 : 1.0;
    float ymin = (uv.y <= 0.0) ? 0.0 : 1.0;
    float uv_bounds = xmax * xmin * ymax * ymin * normal_clip;

    float3 masktex_pixel = tex::lookup_float3(mask_texture, uv, tex::wrap_clamp, tex::wrap_clamp, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);  
    return float(masktex_pixel.x * uv_bounds);
}

export float InfiniteMask(
    //mask_texture
    uniform texture_2d mask_texture = texture_2d() [[
        anno::display_name("Mask Map"),
        anno::in_group("Geometry"),
        anno::description("Projects a normal map along an axis. Masks by the alpha mask in RBGA.")
    ]],
	float hextile_texturescale = float(5.0)
	[[
		anno::display_name("Hex Tile Texture Scale"),
		anno::description(""),
		anno::in_group("Infinite Tile")
	]],
	float hextile_hardness = float(6.0)
	[[
		anno::display_name("Hex Tile Blend Hardness"),
		anno::description(""),
		anno::in_group("Infinite Tile")
	]],
	float hextile_scale = float(0.5)
	[[
		anno::display_name("Hex Tile Scale"),
		anno::description(""),
		anno::in_group("Infinite Tile")
	]],
	float2 hextile_scalelimits = float2(0.75, 1.25)
	[[
		anno::display_name("Hex Tile Scale Limits"),
		anno::description(""),
		anno::in_group("Infinite Tile")
	]],
	float2 hextile_rotlimits = float2(0.0, 2 * math::PI)
	[[
		anno::display_name("Hex Tile Rotation Limits"),
		anno::description(""),
		anno::in_group("Infinite Tile")
	]]
)
[[ anno::display_name("Infinite Texture Mask"),
   anno::thumbnail(".thumbs/hex.png"),
   anno::in_group("Replicator"),
   anno::author("NVIDIA CORPORATION")]]
   {

    
    // Calculate the projection UVs
    float2 uv = float2(state::texture_coordinate(0).x, state::texture_coordinate(0).y) * hextile_texturescale;
	hextile_sample hexstruct = hextile(uv, hextile_scale, hextile_hardness, hextile_rotlimits, hextile_scalelimits);

    // ############### Get Depth Blend
	float ht0_depth = tex::lookup_float(mask_texture, hexstruct.uv_0, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);
	float ht1_depth = tex::lookup_float(mask_texture, hexstruct.uv_1, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);
	float ht2_depth = tex::lookup_float(mask_texture, hexstruct.uv_2, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);

	// Save the weights from the alpha of the diffuse
	float3 alpha = float3(hexstruct.w_0, hexstruct.w_1, hexstruct.w_2) * (float3(ht0_depth, ht1_depth, ht2_depth) + 0.1);
	float3 alphapow = math::pow(alpha, 10.0);
	float alphasum = alphapow.x + alphapow.y + alphapow.z;
	float3 alphapow2 = alphapow / alphasum;

	// ############### Get Diffuse
	float3 ht0_diffuse = tex::lookup_float3(mask_texture, hexstruct.uv_0, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);
	float3 ht1_diffuse = tex::lookup_float3(mask_texture, hexstruct.uv_1, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);
	float3 ht2_diffuse = tex::lookup_float3(mask_texture, hexstruct.uv_2, tex::wrap_repeat, tex::wrap_repeat, float2(0.0, 1.0), float2(0.0, 1.0), 0.0);



	float3 blended_diff = (alphapow2.x * ht0_diffuse) + (alphapow2.y * ht1_diffuse) + (alphapow2.z * ht2_diffuse);
    return float(blended_diff.x);
}