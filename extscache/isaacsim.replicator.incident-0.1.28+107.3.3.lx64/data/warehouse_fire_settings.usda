                        float secondOrderBlendThreshold = 0.001
                    }

                    def FlowAdvectionChannelParams "temperature"
                    {
                        float damping = 0
                        float fade = 0
                        float secondOrderBlendFactor = 0.9
                        float secondOrderBlendThreshold = 0.001
                    }

                    def FlowAdvectionChannelParams "fuel"
                    {
                        float damping = 0
