                    float ignitionTemp = 0.05
                    float smokePerBurn = 3
                    float tempPerBurn = 5

                    def FlowAdvectionChannelParams "velocity"
                    {
                        float damping = 0.01
                        float fade = 0.01
                        float secondOrderBlendFactor = 0.5
                        float secondOrderBlendThreshold = 0.001
                    }

                    def FlowAdvectionChannelParams "divergence"
                    {
                        float damping = 0.01
