[report]
exclude_lines =
    # NOTE: regex cannot start with # in this file

    # default exclude regex
    (pragma|PRAGMA)[:\s]?\s*(no|NO)\s*(cover|COVER)

    # warp excluded lines
    ^\s*@wp
    ^\s*@warp

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain about abstract methods, they aren't run:
    @(abc\.)?abstractmethod
