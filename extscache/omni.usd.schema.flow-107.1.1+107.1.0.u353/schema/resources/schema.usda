)
uint64 nanoVdbCoupleRateVelocityFirstElement = 0 (
	displayName = "Couple Rate First Element"
	displayGroup = "NanoVDB Velocity Channel"
	doc = """Word offset applied when reading nanoVdbCoupleRateVelocities array."""
)
asset nanoVdbVelocities:assetPath = @@ (
