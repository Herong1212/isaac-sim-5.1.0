#usda 1.0
(
	subLayers = [
	@usdGeom/schema.usda@
	]
)

over "GLOBAL" (
	customData = {
	string libraryName = "flowSchema"
	string libraryPath = "flowSchema"
	bool skipCodeGeneration = true
	}
)
{

}

class FlowBase "FlowBase"
(
	inherits = </Typed>
)
{
	int layer = 0 (
	displayName = "Layer"
	displayGroup = "Common"
	doc = """Layer ID selects what emitters interact with what simulation"""
)
int level = 0 (
	displayName = "Level"
	displayGroup = "Common"
	doc = """Base Flow Level"""
)
}

class FlowEmitterSphere "FlowEmitterSphere"
(
	inherits = </FlowBase>
)
{
bool enabled = true (
	displayName = "Enabled"
	displayGroup = "Sphere Emitter"
	doc = """Boolean to enable/disable emitter"""
)

float3 position = (0.000000, 0.000000, 0.000000) (
	displayName = "Position"
	displayGroup = "Sphere Emitter"
	doc = """Local space position of sphere center."""
)
float allocationScale = 1.000000 (
	displayName = "Allocation Scale"
	displayGroup = "Sphere Emitter"
	doc = """1.0 allocates blocks needed to contain box. 0.0 disables allocation. Values higher than 1.0 can be used to add additional padding."""
)
bool applyPostPressure = false (
	displayName = "Apply Post Pressure"
	displayGroup = "Sphere Emitter"
	doc = """If true, apply velocity after pressure solve. This is useful for collision, as it allows hard enforcement of velocity inside moving bodies."""
)
bool multisample = false (
	displayName = "Multisample"
	displayGroup = "Sphere Emitter"
	doc = """Test sphere overlap at 8 locations instead of 1"""
)
uint numSubSteps = 1 (
	displayName = "Num Sub Steps"
	displayGroup = "Sphere Emitter"
	doc = """Substeps per simulation update. More steps produce a smoother result with moving emitters."""
)
float physicsVelocityScale = 0.000000 (
	displayName = "Physics Velocity Scale"
	displayGroup = "Sphere Emitter"
	doc = """If set to 1.0, the body velocity will be added to the target velocity. This is useful for collision effects, where the body velocity and grid cell velocity should align."""
)
float radius = 10.0 (
	displayName = "Radius"
	displayGroup = "Sphere Emitter"
	doc = """radius of sphere"""
)
bool radiusIsWorldSpace = 1 (
	displayName = "Radius Is World Space"
	displayGroup = "Sphere Emitter"
	doc = """If true, do not apply xform scale to radius"""
)
# Temperature
float temperature = 0.500000 (
	displayName = "Temperature"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target temperature value."""
)
float coupleRateTemperature = 2.000000 (
	displayName = "Couple Rate Temperature"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for the temperature channel."""
)
# Fuel
float fuel = 0.800000 (
	displayName = "Fuel"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target fuel value."""
)
float coupleRateFuel = 2.000000 (
	displayName = "Couple Rate Fuel"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for the fuel channel."""
)
# Burn
float burn = 0.000000 (
	displayName = "Burn"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target burn value."""
)
float coupleRateBurn = 0.000000 (
	displayName = "Couple Rate Burn"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for burn channel."""
)
# Smoke
float smoke = 0.000000 (
	displayName = "Smoke"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target smoke value."""
)
float coupleRateSmoke = 0.000000 (
	displayName = "Couple Rate Smoke"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for the smoke channel."""
)
# Velocity
float3 velocity = (0.000000, 0.000000, 400.000000) (
	displayName = "Velocity"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target velocity value."""
)
float coupleRateVelocity = 2.000000 (
	displayName = "Couple Rate Velocity"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for the velocity channel."""
)
bool velocityIsWorldSpace = false (
	displayName = "Velocity Is World Space"
	displayGroup = "Sphere Emitter Channels"
	doc = """If true, do not rotate velocity by xform"""
)
# Divergence
float divergence = 0.000000 (
	displayName = "Divergence"
	displayGroup = "Sphere Emitter Channels"
	doc = """Target divergence value."""
)
float coupleRateDivergence = 0.000000 (
	displayName = "Couple Rate Divergence"
	displayGroup = "Sphere Emitter Channels"
	doc = """Couple rate for divergence channel."""
)
}

class FlowEmitterBox "FlowEmitterBox"
(
	inherits = </FlowBase>
)
{
bool enabled = true (
	displayName = "Enabled"
	displayGroup = "Box Emitter"
	doc = """Boolean to enable/disable emitter"""
)
float3 position = (0.000000, 0.000000, 0.000000) (
	displayName = "Position"
	displayGroup = "Box Emitter"
	doc = """Local space position of box center."""
)
float3 halfSize = (10.000000, 10.000000, 10.000000) (
	displayName = "Half Size"
	displayGroup = "Box Emitter"
	doc = """Half of box width/height/depth in local units"""
)
float allocationScale = 1.000000 (
	displayName = "Allocation Scale"
	displayGroup = "Box Emitter"
	doc = """1.0 allocates blocks needed to contain box. 0.0 disables allocation. Values higher than 1.0 can be used to add additional padding."""
)
bool applyPostPressure = false (
	displayName = "Apply Post Pressure"
	displayGroup = "Box Emitter"
	doc = """If true, apply velocity after pressure solve. This is useful for collision, as it allows hard enforcement of velocity inside moving bodies."""
)
bool multisample = false (
	displayName = "Multisample"
	displayGroup = "Box Emitter"
	doc = """Test sphere overlap at 8 locations instead of 1"""
)
rel physicsCollisionPrim (
	displayName = "Physics Collision Prim"
	displayGroup = "Box Emitter"
	doc = """Rel to prim including physics collision convex hulls."""
)
bool isPhysicsCollision = 0 (
	displayName = "Is Physics Collision"
	displayGroup = "Box Emitter"
	doc = """If true, broadcast to all Flow layers with physics collision enabled."""
)
bool allLayers = 0 (
	displayName = "All Layers"
	displayGroup = "Box Emitter"
	doc = """If true, broadcast to all active Flow layers."""
)
float physicsVelocityScale = 0.000000 (
	displayName = "Physics Velocity Scale"
	displayGroup = "Box Emitter"
	doc = """If set to 1.0, the body velocity will be added to the target velocity. This is useful for collision effects, where the body velocity and grid cell velocity should align."""
)
float4[] clippingPlanes = [] (
	displayName = "Clipping Planes"
	displayGroup = "Box Emitter"
	doc = """List of clipping planes in local space."""
)
uint[] clippingPlaneCounts = [] (
	displayName = "Clipping Plane Counts"
	displayGroup = "Box Emitter"
	doc = """Count of clipping planes for each convex hull in clippingPlanes."""
)
# Temperature
float temperature = 0.500000 (
	displayName = "Temperature"
	displayGroup = "Box Emitter Channels"
	doc = """Target temperature value."""
)
float coupleRateTemperature = 2.000000 (
	displayName = "Couple Rate Temperature"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for the temperature channel."""
)
# Fuel
float fuel = 0.800000 (
	displayName = "Fuel"
	displayGroup = "Box Emitter Channels"
	doc = """Target fuel value."""
)
float coupleRateFuel = 2.000000 (
	displayName = "Couple Rate Fuel"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for the fuel channel."""
)
# Burn
float burn = 0.000000 (
	displayName = "Burn"
	displayGroup = "Box Emitter Channels"
	doc = """Target burn value."""
)
float coupleRateBurn = 0.000000 (
	displayName = "Couple Rate Burn"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for burn channel."""
)
# Smoke
float smoke = 0.000000 (
	displayName = "Smoke"
	displayGroup = "Box Emitter Channels"
	doc = """Target smoke value."""
)
float coupleRateSmoke = 0.000000 (
	displayName = "Couple Rate Smoke"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for the smoke channel."""
)
# Velocity
float3 velocity = (0.000000, 0.000000, 400.000000) (
	displayName = "Velocity"
	displayGroup = "Box Emitter Channels"
	doc = """Target velocity value."""
)
bool velocityIsWorldSpace = false (
	displayName = "Velocity Is World Space"
	displayGroup = "Box Emitter Channels"
	doc = """If true, do not rotate velocity by xform"""
)
float coupleRateVelocity = 2.000000 (
	displayName = "Couple Rate Velocity"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for the velocity channel."""
)
# Divergence
float divergence = 0.000000 (
	displayName = "Divergence"
	displayGroup = "Box Emitter Channels"
	doc = """Target divergence value."""
)
float coupleRateDivergence = 0.000000 (
	displayName = "Couple Rate Divergence"
	displayGroup = "Box Emitter Channels"
	doc = """Couple rate for divergence channel."""
)
}

class FlowEmitterPoint "FlowEmitterPoint"
(
	inherits = </FlowBase>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Point Emitter"
	doc = """Boolean to enable/disable emitter"""
)
int levelCount = 1 (
	displayName = "Level Count"
	displayGroup = "Point Emitter"
	doc = """If greater than 1, point emitter will attempt to select Flow level with closest cell size alignment to point width."""
)
bool followVisibility = 0 (
	displayName = "Follow Visibility"
	displayGroup = "Point Emitter"
	doc = """If true, if USD visibility is invisible, emitter will be disabled"""
)
bool allocateMask = 1 (
	displayName = "Allocate Mask"
	displayGroup = "Point Emitter"
	doc = """Default allocation behavior. If true and allocateMasks is empty, all points will trigger allocation."""
)
uint[] pointAllocateMasks = [] (
	displayName = "Point Allocate Masks"
	displayGroup = "Point Emitter"
	doc = """Optional array of allocate settings per point."""
)
bool applyPostPressure = 0 (
	displayName = "Apply Post Pressure"
	displayGroup = "Point Emitter"
	doc = """If true, apply velocity after pressure solve. This is useful for collision, as it allows hard enforcement of velocity inside moving bodies."""
)
uint numSubSteps = 1 (
	displayName = "Num Sub Steps"
	displayGroup = "Point Emitter"
	doc = """If numSubSteps > 1, Interpolates point position using velocity"""
)
bool updateCoarseDensity = 0 (
	displayName = "Update Coarse Density"
	displayGroup = "Point Emitter"
	doc = """If true, update coarse density for the block covered by this emitter"""
)
float3[] pointPositions = [] (
	displayName = "Point Positions"
	displayGroup = "Point Emitter"
	doc = """Array of local space positions. Determines total point count."""
)
float[] pointWidths = [] (
	displayName = "Point Widths"
	displayGroup = "Point Emitter"
	doc = """Array of local space widths. Used with autoLayerCount only for now."""
)
float widthScale = 1 (
	displayName = "Width Scale"
	displayGroup = "Point Emitter"
	doc = """Scale value to apply to pointWidths before use. Works with levelCount to select level."""
)
rel pointsPrim (
	displayName = "Points Prim"
	displayGroup = "Point Emitter"
	doc = """Optional relationship to UsdGeomPoint, to source arrays"""
)
float3[] pointColors = [] (
	displayName = "Point Colors"
	displayGroup = "Point Emitter"
	doc = """Array of temperature, fuel, burn values, used for color with ray march in raw mode."""
)
bool colorIsSrgb = 0 (
	displayName = "Color Is Srgb"
	displayGroup = "Point Emitter"
	doc = """If true, perform color correction on temperature, fuel, burn channels"""
)
# streaming
bool enableStreaming = 0 (
	displayName = "Enable"
	displayGroup = "Point Emitter Streaming"
	doc = """If true, only apply streamingBatchSize per frame"""
)
bool streamClearAtStart = 0 (
	displayName = "Stream Clear At Start"
	displayGroup = "Point Emitter Streaming"
	doc = """If true, clears entire layer when streaming start"""
)
uint streamingBatchSize = 1048576 (
	displayName = "Streaming Batch Size"
	displayGroup = "Point Emitter Streaming"
	doc = """If streaming is enabled, point count emitted per simulate step"""
)
bool streamOnce = 0 (
	displayName = "Stream Once"
	displayGroup = "Point Emitter Streaming"
	doc = """If true, apply each point to the grid only once"""
)

# Temperature
float temperatureScale = 1 (
	displayName = "Temperature Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for temperature and pointTemperatures"""
)
float temperature = 2 (
	displayName = "Temperature"
	displayGroup = "Point Emitter Channels"
	doc = """Default target temperature value."""
)
float coupleRateTemperature = 200 (
	displayName = "Couple Rate Temperature"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for temperature channel."""
)
float[] pointTemperatures = [] (
	displayName = "Point Temperatures"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target temperature values for each position."""
)
float[] pointCoupleRateTemperatures = [] (
	displayName = "Point Couple Rate Temperatures"
	displayGroup = "Point Emitter Channels"
	doc = """Array of temperature couple rates for each position."""
)
# Fuel
float fuelScale = 1 (
	displayName = "Fuel Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for fuel and pointFuels"""
)
float fuel = 2 (
	displayName = "Fuel"
	displayGroup = "Point Emitter Channels"
	doc = """Default target fuel value."""
)
float coupleRateFuel = 200 (
	displayName = "Couple Rate Fuel"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for fuel channel."""
)

float[] pointFuels = [] (
	displayName = "Point Fuels"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target fuel values for each position."""
)
float[] pointCoupleRateFuels = [] (
	displayName = "Point Couple Rate Fuels"
	displayGroup = "Point Emitter Channels"
	doc = """Array of fuel couple rate for each position."""
)
# Burn
float burnScale = 1 (
	displayName = "Burn Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for burn and pointBurns."""
)
float burn = 0 (
	displayName = "Burn"
	displayGroup = "Point Emitter Channels"
	doc = """Default target burn value."""
)
float coupleRateBurn = 0 (
	displayName = "Couple Rate Burn"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for burn channel"""
)
float[] pointBurns = [] (
	displayName = "Point Burns"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target burn values for each position."""
)
float[] pointCoupleRateBurns = [] (
	displayName = "Point Couple Rate Burns"
	displayGroup = "Point Emitter Channels"
	doc = """Array of burn couple rates for each position."""
)
# Smoke
float smokeScale = 1 (
	displayName = "Smoke Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for smoke and pointSmokes"""
)
float smoke = 2 (
	displayName = "Smoke"
	displayGroup = "Point Emitter Channels"
	doc = """Default target smoke value."""
)
float coupleRateSmoke = 200 (
	displayName = "Couple Rate Smoke"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for smoke channel."""
)
float[] pointSmokes = [] (
	displayName = "Point Smokes"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target smoke values for each position"""
)
float[] pointCoupleRateSmokes = [] (
	displayName = "Point Couple Rate Smokes"
	displayGroup = "Point Emitter Channels"
	doc = """Array of smoke couple rates for each position."""
)
# Velocity
float velocityScale = 1 (
	displayName = "Velocity Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for velocity and pointVelocities"""
)
bool velocityIsWorldSpace = 0 (
	displayName = "Velocity Is World Space"
	displayGroup = "Point Emitter Channels"
	doc = """If true, do not rotate velocity by xform"""
)
float3 velocity = (0, 0, 100) (
	displayName = "Velocity"
	displayGroup = "Point Emitter Channels"
	doc = """Default target velocity value."""
)
float coupleRateVelocity = 200 (
	displayName = "Couple Rate Velocity"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for velocity channel."""
)
float3[] pointVelocities = [] (
	displayName = "Point Velocities"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target velocity values for each position."""
)
float[] pointCoupleRateVelocities = [] (
	displayName = "Point Couple Rate Velocities"
	displayGroup = "Point Emitter Channels"
	doc = """Array of velocity couple rates for each position."""
)
# Divergence
float divergenceScale = 1 (
	displayName = "Divergence Scale"
	displayGroup = "Point Emitter Channels"
	doc = """Multiplier for divergence and pointDivergences."""
)
float divergence = 0 (
	displayName = "Divergence"
	displayGroup = "Point Emitter Channels"
	doc = """Default target divergence value."""
)
float coupleRateDivergence = 0 (
	displayName = "Couple Rate Divergence"
	displayGroup = "Point Emitter Channels"
	doc = """Default couple rate for divergence channel."""
)
float[] pointDivergences = [] (
	displayName = "Point Divergences"
	displayGroup = "Point Emitter Channels"
	doc = """Array of target divergence values for each position."""
)
float[] pointCoupleRateDivergences = [] (
	displayName = "Point Couple Rate Divergences"
	displayGroup = "Point Emitter Channels"
	doc = """Array of divergence couple rates for each position."""
)
}

