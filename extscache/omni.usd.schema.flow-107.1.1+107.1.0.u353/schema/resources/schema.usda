)
asset nanoVdbCoupleRateVelocities:assetPath = @@ (
	displayName = "Couple Rate Asset Path"
	displayGroup = "NanoVDB Velocity Channel"
	doc = """Optional path to OpenVDB/NanoVDB asset to use. Overrides nanoVdbCoupleRateVelocities."""
)
token nanoVdbVelocities:gridName = "" (
	displayName = "Grid Name"
	displayGroup = "NanoVDB Velocity Channel"
	doc = """Grid name to search for in NanoVDB data structure."""
)
token nanoVdbCoupleRateVelocities:gridName = "" (
	displayName = "Couple Rate Grid Name"
	displayGroup = "NanoVDB Velocity Channel"
	doc = """Grid name to search for in NanoVDB data structure."""
)
# NanoVDB Divergence Channel
