class FlowSimulate "FlowSimulate"
(
	inherits = </FlowBase>
)
{
bool forceSimulate = 0 (
	displayName = "Force Simulate"
	displayGroup = "Simulate"
	doc = """Force simulate, even if timeline is paused."""
)
bool simulateWhenPaused = 0 (
	displayName = "Simulate When Paused"
	displayGroup = "Simulate"
	doc = """Run simulation even if deltaTime is 0.0."""
)
uint blockMinLifetime = 4 (
	displayName = "Block Min Lifetime"
	displayGroup = "Simulate"
	doc = """Minimum lifetime of any allocate block. Avoids premature deactivation caused by GPU readback delay."""
)
float densityCellSize = 0.5 (
	displayName = "Density Cell Size"
	displayGroup = "Simulate"
	doc = """Size of density cells in world units. By default velocity cell size is twice density cell size."""
)
int levelCount = 1 (
	displayName = "Level Count"
	displayGroup = "Simulate"
	doc = """When Level Count > 1, additional levels are created at different resolutions."""
)
float levelCellSizeMultiplier = 0.5 (
	displayName = "Level Cell Size Multiplier"
	displayGroup = "Simulate"
	doc = """When Level Count > 0, controls how cell size increases/decreases with each level."""
)
bool autoCellSize = 0 (
	displayName = "Auto Cell Size"
	displayGroup = "Simulate"
	doc = """If true, Flow will increase cell size as needed to avoid running out of blocks."""
)
bool enableLowPrecisionDensity = 0 (
	displayName = "Enable Low Precision Density"
	displayGroup = "Simulate"
	doc = """Use 8-bit channels for temperature, fuel, burn, smoke"""
)
bool enableLowPrecisionVelocity = 0 (
	displayName = "Enable Low Precision Velocity"
	displayGroup = "Simulate"
	doc = """Use 8-bit channels for velocity, divergence"""
)
bool enableLowPrecisionRescale = 0 (
	displayName = "Enable Low Precision Rescale"
	displayGroup = "Simulate"
	doc = """Rescale at reduced quality to reduce VRAM usage."""
)
bool enableSmallBlocks = 0 (
	displayName = "Enable Small Blocks"
	displayGroup = "Simulate"
	doc = """Use 16x8x8 density cell blocks instead of the default 32x16x16"""
)
bool enableVariableTimeStep = 0 (
	displayName = "Enable Variable Time Step"
	displayGroup = "Simulate"
	doc = """Take step every frame. Can cause inconsistent simulation behavior for highly variable time step values, but useful when frame time is fixed already."""
)
bool forceClear = 0 (
	displayName = "Force Clear"
	displayGroup = "Simulate"
	doc = """Kills all active block allocations in this layer"""
)
bool forceDisableCoreSimulation = 0 (
	displayName = "Force Disable Core Simulation"
	displayGroup = "Simulate"
	doc = """Disable most simulation components. Emitters still function."""
)
bool forceDisableEmitters = 0 (
	displayName = "Force Disable Emitters"
	displayGroup = "Simulate"
	doc = """Disable all emitters in this layer"""
)
bool clearOnRescale = 0 (
	displayName = "Clear On Rescale"
	displayGroup = "Simulate"
	doc = """If cell size is changed, clear instead of migrating."""
)
bool interpolateTimeSteps = 0 (
	displayName = "Interpolate Time Steps"
	displayGroup = "Simulate"
	doc = """Useful for motion blur in movie capture. Produces sub-frames between full simulation steps."""
)
uint maxStepsPerSimulate = 1 (
	displayName = "Max Steps Per Simulate"
	displayGroup = "Simulate"
	doc = """Limit on steps per frame to avoid excessive steps when application is running slow."""
)
bool physicsCollisionEnabled = 0 (
	displayName = "Physics Collision Enabled"
	displayGroup = "Simulate"
	doc = """If true, enable collision for prims using the USD physics collision applied schema."""
)
bool physicsConvexCollision = 1 (
	displayName = "Physics Convex Collision"
	displayGroup = "Simulate"
	doc = """If true, use the PhysX convex collision hulls for Flow collision. Requires PhysX to be actively simulating."""
)
float stepsPerSecond = 60 (
	displayName = "Steps Per Second"
	displayGroup = "Simulate"
	doc = """Simulation update rate"""
)
float timeScale = 1 (
	displayName = "Time Scale"
	displayGroup = "Simulate"
	doc = """Scales input time. Useful for slomo."""
)
uint velocitySubSteps = 1 (
	displayName = "Velocity Sub Steps"
	displayGroup = "Simulate"
	doc = """Higher values improve behavior with high speed effects, at the cost of performance."""
)
}

class FlowAdvectionCombustionParams "FlowAdvectionCombustionParams"
(
	inherits = </Typed>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Advection Combustion Params"
	doc = """Boolean to enable/disable advection."""
)
bool combustionEnabled = 1 (
	displayName = "Combustion Enabled"
	displayGroup = "Advection Combustion Params"
	doc = """If false, only buoyancyMaxSmoke and buoyancyPerSmoke are active"""
)
bool downsampleEnabled = 1 (
	displayName = "Downsample Enabled"
	displayGroup = "Advection Combustion Params"
	doc = """Boolean to enable/disable downsample. Downsample needed for SummaryAllocate"""
)
bool forceFadeEnabled = 0 (
	displayName = "Force Fade Enabled"
	displayGroup = "Advection Combustion Params"
	doc = """If true, fade will be applied even if advection is disabled"""
)
bool globalFetch = 0 (
	displayName = "Global Fetch"
	displayGroup = "Advection Combustion Params"
	doc = """Improves advection quality for high velocities, with some increase in runtime cost. (Can remove some banding artifacts)"""
)
float3 gravity = (0, 0, -100) (
	displayName = "Gravity"
	displayGroup = "Advection Combustion Params"
	doc = """Used to determine the up direction for buoyancy."""
)
float coolingRate = 1.5 (
	displayName = "Cooling Rate"
	displayGroup = "Advection Combustion Params"
	doc = """Temperature fade, applied on a per cell level. (Not conduction/convection.)"""
)
float ignitionTemp = 0.05 (
	displayName = "Ignition Temp"
	displayGroup = "Advection Combustion Params"
	doc = """Minimum temperature for combustion."""
)
float tempPerBurn = 5 (
	displayName = "Temp Per Burn"
	displayGroup = "Advection Combustion Params"
	doc = """Temperature increase relative to burn amount."""
)
float fuelPerBurn = 0.25 (
	displayName = "Fuel Per Burn"
	displayGroup = "Advection Combustion Params"
	doc = """Fuel consumed relative to burn amount. Lower values will make a given amount of fuel last longer."""
)
float burnPerTemp = 4 (
	displayName = "Burn Per Temp"
	displayGroup = "Advection Combustion Params"
	doc = """Rate of burn relative to temperature. Higher burn values affect fuel consumption and divergence (expansion) terms."""
)
float smokePerBurn = 3 (
	displayName = "Smoke Per Burn"
	displayGroup = "Advection Combustion Params"
	doc = """Smoke increase relative to burn amount."""
)
float divergencePerBurn = 0 (
	displayName = "Divergence Per Burn"
	displayGroup = "Advection Combustion Params"
	doc = """Expansion relative to burn amount. Units comparable to velocity in terms of scale. Higher values produce visible expansion, but can remove detail."""
)
float buoyancyPerTemp = 2 (
	displayName = "Buoyancy Per Temp"
	displayGroup = "Advection Combustion Params"
	doc = """Upward force relative to temperature. Higher values help produce mushroom effects."""
)
float buoyancyPerSmoke = 0 (
	displayName = "Buoyancy Per Smoke"
	displayGroup = "Advection Combustion Params"
	doc = """Buoyant force per unit smoke, default 0.0"""
)
float buoyancyMaxSmoke = 1 (
	displayName = "Buoyancy Max Smoke"
	displayGroup = "Advection Combustion Params"
	doc = """Smoke clamp value applied before computing smoke buoyancy, default 1.0"""
)
}

class FlowAdvectionChannelParams "FlowAdvectionChannelParams"
(
	inherits = </Typed>
)
{
float damping = 0 (
	displayName = "Damping"
	displayGroup = "Advection Channel Params"
	doc = """Reduce channel proportional to current value. Valid range is 0 to 1, where 1 takes the value to 0 immediately."""
)
float fade = 0 (
	displayName = "Fade"
	displayGroup = "Advection Channel Params"
	doc = """Reduce channel at a constant rate per second. Valid range is 0 to infinity effectively."""
)
float secondOrderBlendFactor = 0.9 (
	displayName = "Second Order Blend Factor"
	displayGroup = "Advection Channel Params"
	doc = """Second order correction factor. Value range is 0.0 to 1.0. 0.5 is generally a safe default. Higher values increase the sharpness, but comes with potentially banding artifacts. Use extra caution with velocity, where effects are even more pronounced."""
)
float secondOrderBlendThreshold = 0.001 (
	displayName = "Second Order Blend Threshold"
	displayGroup = "Advection Channel Params"
	doc = """Minimum value to apply second order correction. Reduces simulation cost for cells near zero, with minimal/zero visual artifacts."""
)
}

class FlowVorticityParams "FlowVorticityParams"
(
	inherits = </Typed>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Vorticity Params"
	doc = """Boolean to enable/disable vorticity confinement."""
)
float forceScale = 0.6 (
	displayName = "Force Scale"
	displayGroup = "Vorticity Params"
	doc = """Control intensity of effect"""
)
float temperatureMask = 0 (
	displayName = "Temperature Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied relative to temperature value in grid."""
)
float fuelMask = 0 (
	displayName = "Fuel Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied relative to fuel value in grid."""
)
float burnMask = 0 (
	displayName = "Burn Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied relative to burn value in grid."""
)
float smokeMask = 0 (
	displayName = "Smoke Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied relative to smoke value in grid."""
)
float velocityMask = 1 (
	displayName = "Velocity Mask"
	displayGroup = "Vorticity Params"
	doc = """Velocity log mask, works together with velocityLogScale. Makes local linear velocity a requirement for forces to be applied. The log part makes the force applied with respect to velocity a diminishing return to avoid instability."""
)
float velocityLinearMask = 0 (
	displayName = "Velocity Linear Mask"
	displayGroup = "Vorticity Params"
	doc = """Makes force directly proportional to local velocity. Math: velocityLinearMask * speed"""
)
float velocityLogScale = 1 (
	displayName = "Velocity Log Scale"
	displayGroup = "Vorticity Params"
	doc = """This primarily exists to allow rescaling of Flow effects to different coordinate systems."""
)
float constantMask = 0 (
	displayName = "Constant Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied without respect to local velocity."""
)
float densityMask = 0 (
	displayName = "Density Mask"
	displayGroup = "Vorticity Params"
	doc = """Allows force to be applied relative to divergence (Parameter name should be fixed.)"""
)
}

class FlowPressureParams "FlowPressureParams"
(
	inherits = </Typed>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Pressure Params"
	doc = """Boolean to enable/disable the pressure solver."""
)
}

class FlowSummaryAllocateParams "FlowSummaryAllocateParams"
(
	inherits = </Typed>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Summary Allocate Params"
	doc = """If false, SummaryAllocate allocates no blocks."""
)
bool enableNeighborAllocation = 1 (
	displayName = "Enable Neighbor Allocation"
	displayGroup = "Summary Allocate Params"
	doc = """If false, SummaryAllocate preserves active blocks, but does not attempt allocation of new blocks."""
)
float smokeThreshold = 0.02 (
	displayName = "Smoke Threshold"
	displayGroup = "Summary Allocate Params"
	doc = """Minimum smoke to keep a block active."""
)
float speedThreshold = 1 (
	displayName = "Speed Threshold"
	displayGroup = "Summary Allocate Params"
	doc = """Minimum speed to keep a block active, given speedThresholdMinSmoke is satisfied."""
)
float speedThresholdMinSmoke = 0 (
	displayName = "Speed Threshold Min Smoke"
	displayGroup = "Summary Allocate Params"
	doc = """Minimum smoke value for speedThreshold to apply."""
)
}

class FlowSparseNanoVdbExportParams "FlowSparseNanoVdbExportParams"
(
	inherits = </Typed>
)
{
bool enabled = 0 (
	displayName = "Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables NanoVDB export. If false, zero NanoVDB export will occur."""
)
bool statisticsEnabled = 1 (
	displayName = "Statistics Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, compute min/max/ave values on exported VDBs."""
)
bool temperatureEnabled = 0 (
	displayName = "Temperature Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of temperature channel to NanoVDB."""
)
bool fuelEnabled = 0 (
	displayName = "Fuel Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of fuel channel to NanoVDB."""
)
bool burnEnabled = 0 (
	displayName = "Burn Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of burn channel to NanoVDB."""
)
bool smokeEnabled = 1 (
	displayName = "Smoke Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of smoke channel to NanoVDB."""
)
bool rgbaEnabled = 0 (
	displayName = "RGBA Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of temperature, fuel, burn, and smoke channels as vec4f NanoVDB."""
)
bool rgbEnabled = 0 (
	displayName = "RGB Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of temperature, fuel, burn channels as vec3f NanoVDB."""
)
bool velocityEnabled = 0 (
	displayName = "Velocity Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of velocity channel to NanoVDB."""
)
bool divergenceEnabled = 0 (
	displayName = "Divergence Enabled"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true, enables export of divergence channel to NanoVDB."""
)
bool enableLowPrecisionRgba = 0 (
	displayName = "Enable Low Precision RGBA"
	displayGroup = "NanoVDB Export Settings"
	doc = """If true and rgbaEnabled is true, then will export temperature, fuel, burn, and smoke channels as RGBA8 NanoVDB."""
)
bool readbackEnabled = 0 (
	displayName = "Enabled"
	displayGroup = "Readback"
	doc = """If true, copy VDBs back to CPU. If false, VDBs will be GPU access only."""
)
bool readbackClearOnStart = 1 (
	displayName = "Clear On Start"
	displayGroup = "Readback"
	doc = """If true, readbackDirectory will be cleared of Flow VDB files at start of simulation."""
)
bool readbackClearOnStop = 1 (
	displayName = "Clear On Stop"
	displayGroup = "Readback"
	doc = """If true, readbackDirectory will be cleared of Flow VDB files at stop of simulation."""
)
asset readbackDirectory = @@ (
	displayName = "Directory"
	displayGroup = "Readback"
	doc = """Target directory for VDB files."""
)
bool readbackOpenVDB = 1 (
	displayName = "OpenVDB"
	displayGroup = "Readback"
	doc = """If true, convert NanoVDB to OpenVDB format for storage on disk."""
)
rel readbackMaterial (
	displayName = "Material"
	displayGroup = "Readback"
	doc = """Optional path to an OmniVolumeDensity material. Will automatically configure USD timeSamples necessary to play cache."""
)
}

class FlowOffscreen "FlowOffscreen"
(
	inherits = </FlowBase>
)
{
}

class FlowShadowParams "FlowShadowParams"
(
	inherits = </Typed>
)
{
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Shadow Params"
	doc = """Boolean to enable/disable self shadowing."""
)

float attenuation = 0.045 (
	displayName = "Attenuation"
	displayGroup = "Shadow Params"
	doc = """Rate of light blockage. Higher values increase self shadow effect."""
)
bool coarsePropagate = 1 (
	displayName = "Coarse Propagate"
	displayGroup = "Shadow Params"
	doc = """Compute shadows at 2x2x2 coarser grid. Provides good quality at a much lower runtime cost."""
)
bool isPointLight = 0 (
	displayName = "Is Point Light"
	displayGroup = "Shadow Params"
	doc = """If true, point light, else directional light."""
)
float3 lightDirection = (1, 1, 1) (
	displayName = "Light Direction"
	displayGroup = "Shadow Params"
	doc = """Direction to light."""
)
float3 lightPosition = (0, 0, 0) (
	displayName = "Light Position"
	displayGroup = "Shadow Params"
	doc = """Point light position."""
)
float minIntensity = 0.125 (
	displayName = "Min Intensity"
	displayGroup = "Shadow Params"
	doc = """Provide ambient level"""
)
uint numSteps = 16 (
	displayName = "Num Steps"
	displayGroup = "Shadow Params"
	doc = """Number of steps per self shadow ray, divide by 2 when coarsePropagate is enabled."""
)
float stepOffsetScale = 1 (
	displayName = "Step Offset Scale"
	displayGroup = "Shadow Params"
	doc = """Ray march offset to avoid a cell shadowing itself."""
)
float stepSizeScale = 0.75 (
	displayName = "Step Size Scale"
	displayGroup = "Shadow Params"
	doc = """Ray march step size relative to cell size. Higher values increase quality and performance cost."""
)
bool enableRawMode = 0 (
	displayName = "Enable Raw Mode"
	displayGroup = "Shadow Params"
	doc = """If true, do not apply colormap, pass raw density xyzw as color"""
)
bool rawModeIsosurface = 1 (
	displayName = "Raw Mode Isosurface"
	displayGroup = "Shadow Params"
	doc = """If true, smoke channel is used as threshold for a surface, with smoke > 0.5 being inside the surface."""
)
bool rawModeNormalize = 1 (
	displayName = "Raw Mode Normalize"
	displayGroup = "Shadow Params"
	doc = """If true, temperature/fuel/burn (RGB) channels are normalized by smoke channel. Used with point clouds."""
)
float colormapXMin = 0.0 (
	displayName = "Colormap X Min"
	displayGroup = "Shadow Params"
	doc = """Minimum X value for colormap, where X is normally temperature."""
)
float colormapXMax = 1.0 (
	displayName = "Colormap X Max"
	displayGroup = "Shadow Params"
	doc = """Maximum X value for colormap, where X is normally temperature."""
)
}

class FlowRayMarchColormapParams "FlowRayMarchColormapParams"
(
	inherits = </Typed>
)
{
float colorScale = 2.5 (
	displayName = "Color Scale"
	displayGroup = "Colormap Params"
	doc = """Multiplier applied to RGB components."""
)
float[] colorScalePoints = [1, 1, 1, 1, 1, 1] (
	displayName = "Color Scale Points"
	displayGroup = "Colormap Params"
	doc = """Multipliers of control points applied to RGB component in control point."""
)
uint resolution = 32 (
	displayName = "Resolution"
	displayGroup = "Colormap Params"
	doc = """Number of texels in colormap."""
)
float4[] rgbaPoints = [(0.9, 0.9, 0.9, 0.004902), (0.9, 0.9, 0.9, 0.904902), (0.9, 0.9, 0.9, 0.904902), (0.9, 0.9, 0.9, 0.904902), (0.9, 0.9, 0.9, 0.04902), (0.9, 0.9, 0.9, 0.904902)] (
	displayName = "RGBA Points"
	displayGroup = "Colormap Params"
	doc = """RGBA values of control points, RGB can be over 1.0 for HDR effects."""
)
float[] xPoints = [0, 0.05, 0.15, 0.6, 0.85, 1] (
	displayName = "X Points"
	displayGroup = "Colormap Params"
	doc = """X coordinates of control points, maps to temperature. Valid over 0 to 1."""
)
}


class FlowDebugVolumeParams "FlowDebugVolumeParams"
(
	inherits = </Typed>
)
{
