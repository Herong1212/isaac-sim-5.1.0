	displayName = "Enable Speed As Temperature"
	displayGroup = "Debug Volume Params"
	doc = """Write speed value to temperature channel, to visualize in ray march."""
)
bool enableVelocityAsDensity = 0 (
	displayName = "Enable Velocity As Density"
	displayGroup = "Debug Volume Params"
	doc = """Write abs() of velocity channels to density xyz to visualize in ray march."""
)
bool enableDivergenceAsSmoke = 0 (
	displayName = "Enable Divergence As Smoke"
	displayGroup = "Debug Volume Params"
	doc = """Write divergence channel to smoke to visualize in ray march."""
)
bool outputScaleBySmoke = 0 (
	displayName = "Output Scale by Smoke"
	displayGroup = "Debug Volume Params"
	doc = """If true, output temperature, fuel, burn are multiplied by smoke. Useful with rayMarch raw mode."""
)
float3 velocityScale = (0.01, 0.01, 0.01) (
	displayName = "Velocity Scale"
	displayGroup = "Debug Volume Params"
	doc = """Scale applied to velocity to control brightness for ray march result."""
)
float outputTemperatureScale = 1.0 (
	displayName = "Output Temperature Scale"
	displayGroup = "Debug Volume Params"
	doc = """Scale applied to temperature output value."""
)
float outputFuelScale = 1.0 (
	displayName = "Output Fuel Scale"
	displayGroup = "Debug Volume Params"
	doc = """Scale applied to fuel output value."""
)
float outputBurnScale = 1.0 (
	displayName = "Output Burn Scale"
	displayGroup = "Debug Volume Params"
	doc = """Scale applied to burn output value."""
)
float outputSmokeScale = 1.0 (
	displayName = "Output Smoke Scale"
	displayGroup = "Debug Volume Params"
	doc = """Scale applied to smoke output value."""
)
float outputTemperatureOffset = 0.0 (
	displayName = "Output Temperature Offset"
	displayGroup = "Debug Volume Params"
	doc = """Offset applied to temperature output value."""
)
float outputFuelOffset = 0.0 (
	displayName = "Output Fuel Offset"
	displayGroup = "Debug Volume Params"
	doc = """Offset applied to fuel output value."""
)
float outputBurnOffset = 0.0 (
	displayName = "Output Burn Offset"
	displayGroup = "Debug Volume Params"
	doc = """Offset applied to burn output value."""
)
float outputSmokeOffset = 0.0 (
	displayName = "Output Smoke Offset"
	displayGroup = "Debug Volume Params"
	doc = """Offset applied to smoke output value."""
)
float4 slicePlane = (1.0, 0.0, 0.0, 0.0) (
	displayName = "Slice Plane"
	displayGroup = "Debug Volume Params"
	doc = """If slicePlaneThickness is nonzero, plane used to control visible cross section."""
)
float slicePlaneThickness = 0.0 (
	displayName = "Slice Plane Thickness"
	displayGroup = "Debug Volume Params"
	doc = """If greater than zero, thickness of visible cross section. If less than zero, thickness of removed cross section."""
)
}


class FlowRender "FlowRender"
(
	inherits = </FlowBase>
)
{
}


class FlowRayMarchParams "FlowRayMarchParams"
(
	inherits = </Typed>
)
{
bool enableBlockWireframe = 0 (
	displayName = "Enable Block Wireframe"
	displayGroup = "Ray March Params"
	doc = """Visualizes active blocks for debug purposes"""
)
bool enableRawMode = 0 (
	displayName = "Enable Raw Mode"
	displayGroup = "Ray March Params"
	doc = """If true, do not apply colormap, pass raw density xyzw as color"""
)
bool rawModeIsosurface = 1 (
	displayName = "Raw Mode Isosurface"
	displayGroup = "Ray March Params"
	doc = """If true, smoke channel is used as threshold for a surface, with smoke > 0.5 being inside the surface."""
)
bool rawModeNormalize = 1 (
	displayName = "Raw Mode Normalize"
	displayGroup = "Ray March Params"
	doc = """If true, temperature/fuel/burn (RGB) channels are normalized by smoke channel. Used with point clouds."""
)
float attenuation = 0.05 (
	displayName = "Attenuation"
	displayGroup = "Ray March Params"
	doc = """Rate of light blockage. Higher values make the volume look more opaque"""
)
float shadowFactor = 1 (
	displayName = "Shadow Factor"
	displayGroup = "Ray March Params"
	doc = """The degree to which the z shadow channel scales the RGB channels from the colormap. 1.0 is default. 0.0 disables self shadowing effectively."""
)
float colorScale = 1 (
	displayName = "Color Scale"
	displayGroup = "Ray March Params"
	doc = """Multiplier applied to RGB values during ray march"""
)
float stepSizeScale = 0.75 (
	displayName = "Step Size Scale"
	displayGroup = "Ray March Params"
	doc = """Ray march step size relative to cell size. Higher values increase quality and performance cost."""
)
float colormapXMin = 0.0 (
	displayName = "Colormap X Min"
	displayGroup = "Ray March Params"
	doc = """Minimum X value for colormap, where X is normally temperature."""
)
float colormapXMax = 1.0 (
	displayName = "Colormap X Max"
	displayGroup = "Ray March Params"
	doc = """Maximum X value for colormap, where X is normally temperature."""
)
}

class FlowRayMarchCloudParams "FlowRayMarchCloudParams"
(
	inherits = </Typed>
)
{
bool enableCloudMode = 0 (
	displayName = "Enable Cloud Mode"
	displayGroup = "Ray March Cloud Params"
	doc = """If true, default ray march is disabled, these settings are used instead."""
)
float3 ambientColor = (0.4, 0.55, 0.9) (
	displayName = "Ambient Color"
	displayGroup = "Ray March Cloud Params"
	doc = """Color in shadowed regions."""
)
float ambientMultiplier = 1 (
	displayName = "Ambient Multiplier"
	displayGroup = "Ray March Cloud Params"
	doc = """Scale to adjust brightness of ambient color."""
)
float3 attenuationMultiplier = (1, 1, 1) (
	displayName = "Attenuation Multiplier"
	displayGroup = "Ray March Cloud Params"
	doc = """Controls how fast cloud shadows go dark."""
)
float densityMultiplier = 0.5 (
	displayName = "Density Multiplier"
	displayGroup = "Ray March Cloud Params"
	doc = """Scales input density."""
)
int numShadowSteps = 10 (
	displayName = "Num Shadow Steps"
	displayGroup = "Ray March Cloud Params"
	doc = """More steps can improve quality, but add performance cost."""
)
float shadowStepMultiplier = 1 (
	displayName = "Shadow Step Multiplier"
	displayGroup = "Ray March Cloud Params"
	doc = """Larger steps cover more of world space, at risk of artifacts."""
)
float3 sunDirection = (1, 1, 1) (
	displayName = "Sun Direction"
	displayGroup = "Ray March Cloud Params"
	doc = """Direction to sun."""
)
float3 volumeBaseColor = (1.1, 1, 0.95) (
	displayName = "Volume Base Color"
	displayGroup = "Ray March Cloud Params"
	doc = """Base color for scattering."""
)
float volumeColorMultiplier = 1 (
	displayName = "Volume Color Multiplier"
	displayGroup = "Ray March Cloud Params"
	doc = """Scale to adjust brightness of volume base color."""
)
}

class FlowRenderSettingsParams "FlowRenderSettingsParams"
(
	inherits = </Typed>
)
{
bool enableAutoApply = 1 (
	displayName = "Enable Auto Apply"
	displayGroup = "Render Setting Votes"
	doc = """If true, global settings will be automatically applied based this prim and others with enableAutoApply=true"""
)
bool flowEnabled = 1 (
	displayName = "Flow Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should be enabled in the renderer"""
)
int maxBlocks = 0 (
	displayName = "Max Blocks"
	displayGroup = "Render Setting Votes"
	doc = """Recommended minimum global maxBlocks setting"""
)
bool rayTracedShadowsEnabled = 0 (
	displayName = "Ray Traced Shadows Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should contribute to ray traced shadows"""
)
bool rayTracedReflectionsEnabled = 1 (
	displayName = "Ray Traced Reflections Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should contribute to ray traced reflections"""
)
bool rayTracedTranslucencyEnabled = 1 (
	displayName = "Ray Traced Translucency Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should render in translucency pass rather than composite"""
)
bool pathTracingEnabled = 1 (
	displayName = "Path Tracing Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes Flow should render in path tracing pass rather than composite"""
)
bool pathTracingShadowsEnabled = 0 (
	displayName = "Path Tracing Shadows Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should contribute to path traced shadows"""
)
bool compositeEnabled = 1 (
	displayName = "Composite Enabled"
	displayGroup = "Render Setting Votes"
	doc = """If true, votes that Flow should composite onto scene if not rendered some other way"""
)
}

class FlowPointCloud "FlowPointCloud"
(
	inherits = </Typed>
)
{
bool attributeCopyEnabled = 1 (
	displayName = "Enable Attribute Copy"
	displayGroup = "Flow Point Cloud"
	doc = """If true, FlowPointCloud attributes will override child Flow prim attributes."""
)
bool enabled = 1 (
	displayName = "Enabled"
	displayGroup = "Flow Point Cloud"
	doc = """If false, voxels will be cleared."""
)
bool autoCellSize = 1 (
	displayName = "Auto Cell Size"
	displayGroup = "Flow Point Cloud"
	doc = """If true, cellSize will increase as needed to stay within Flow max blocks."""
)
int levelCount = 1 (
	displayName = "Level Count"
	displayGroup = "Flow Point Cloud"
	doc = """When Level Count > 1, additional levels are created at different resolutions."""
)
float cellSize = 0.015625 (
	displayName = "Cell Size"
	displayGroup = "Flow Point Cloud"
	doc = """Minimum voxel width. Exact voxel width if autoCellSize is false."""
)
bool enableLowPrecision = 1 (
	displayName = "Enable Low Precision"
	displayGroup = "Flow Point Cloud"
	doc = """If true, use 8-bit channels for color."""
)
bool updateWhilePaused = 1 (
	displayName = "Update While Paused"
	displayGroup = "Flow Point Cloud"
	doc = """If true, update Flow volume even while timeline is paused."""
)
bool fadeEnabled = 0 (
	displayName = "Fade Enabled"
	displayGroup = "Flow Point Cloud"
	doc = """If true, fade voxel values over time."""
)
float fadeRate = 1 (
	displayName = "Fade Rate"
	displayGroup = "Flow Point Cloud"
	doc = """Fade rate in units / second"""
)
bool enableSmallBlocks = 0 (
	displayName = "Enable Small Blocks"
	displayGroup = "Flow Point Cloud"
	doc = """Use 16x8x8 cell blocks instead of the default 32x16x16"""
)
float rayMarchAttenuation = 10 (
	displayName = "Ray March Attenuation"
	displayGroup = "Flow Point Cloud"
	doc = """Higher values make point cloud more opaque."""
)
float rayMarchColorScale = 10 (
	displayName = "Ray March Color Scale"
	displayGroup = "Flow Point Cloud"
	doc = """Scale to apply to color during ray march. Needed because of tonemapping."""
)
bool enableStreaming = 1 (
	displayName = "Enable Streaming"
	displayGroup = "Flow Point Cloud"
	doc = """If true, load point data over multiple frames. Better performance."""
)
bool streamOnce = 1 (
	displayName = "Stream Once"
	displayGroup = "Flow Point Cloud"
	doc = """If true, stop streaming once all points are voxelized."""
)
bool streamClearAtStart = 1 (
	displayName = "Stream Clear at Start"
	displayGroup = "Flow Point Cloud"
	doc = """If true, clear old voxels before streaming new."""
)
uint streamingBatchSize = 4194304 (
	displayName = "Streaming Batch Size"
	displayGroup = "Flow Point Cloud"
	doc = """Points per streaming update, helps control cost per frame vs total frames to load."""
)
bool colorIsSrgb = 1 (
	displayName = "Color is SRGB"
	displayGroup = "Flow Point Cloud"
	doc = """If true, treat source color data as SRGB color space instead of linear color space."""
)
bool followVisibility = 1 (
	displayName = "Follow Visibility"
	displayGroup = "Flow Point Cloud"
	doc = """If true, enable or disable Flow emitters to align to render visibility setting."""
)
float widthScale = 1 (
	displayName = "Width Scale"
	displayGroup = "Flow Point Cloud"
	doc = """Scale to apply to point width before level selection."""
)
float coupleRate = 100000000 (
	displayName = "Couple Rate"
	displayGroup = "Flow Point Cloud"
	doc = """Lower values move voxel values to point values more slowly."""
)
}
