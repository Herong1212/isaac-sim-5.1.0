class FlowShadowParams "FlowShadowParams"
{
    float attenuation = 0.045 (
        displayGroup = "Shadow Params"
        displayName = "Attenuation"
        doc = "Rate of light blockage. Higher values increase self shadow effect."
    )
    bool coarsePropagate = 1 (
        displayGroup = "Shadow Params"
        displayName = "Coarse Propagate"
        doc = "Compute shadows at 2x2x2 coarser grid. Provides good quality at a much lower runtime cost."
    )
    float colormapXMax = 1 (
        displayGroup = "Shadow Params"
        displayName = "Colormap X Max"
        doc = "Maximum X value for colormap, where X is normally temperature."
    )
    float colormapXMin = 0 (
        displayGroup = "Shadow Params"
        displayName = "Colormap X Min"
        doc = "Minimum X value for colormap, where X is normally temperature."
    )
    bool enabled = 1 (
        displayGroup = "Shadow Params"
        displayName = "Enabled"
        doc = "Boolean to enable/disable self shadowing."
    )
    bool enableRawMode = 0 (
        displayGroup = "Shadow Params"
        displayName = "Enable Raw Mode"
        doc = "If true, do not apply colormap, pass raw density xyzw as color"
    )
    bool isPointLight = 0 (
        displayGroup = "Shadow Params"
        displayName = "Is Point Light"
        doc = "If true, point light, else directional light."
    )
    float3 lightDirection = (1, 1, 1) (
        displayGroup = "Shadow Params"
        displayName = "Light Direction"
        doc = "Direction to light."
    )
    float3 lightPosition = (0, 0, 0) (
        displayGroup = "Shadow Params"
        displayName = "Light Position"
        doc = "Point light position."
    )
    float minIntensity = 0.125 (
        displayGroup = "Shadow Params"
        displayName = "Min Intensity"
        doc = "Provide ambient level"
    )
    uint numSteps = 16 (
        displayGroup = "Shadow Params"
        displayName = "Num Steps"
        doc = "Number of steps per self shadow ray, divide by 2 when coarsePropagate is enabled."
    )
    bool rawModeIsosurface = 1 (
        displayGroup = "Shadow Params"
        displayName = "Raw Mode Isosurface"
        doc = "If true, smoke channel is used as threshold for a surface, with smoke > 0.5 being inside the surface."
    )
    bool rawModeNormalize = 1 (
        displayGroup = "Shadow Params"
        displayName = "Raw Mode Normalize"
        doc = "If true, temperature/fuel/burn (RGB) channels are normalized by smoke channel. Used with point clouds."
    )
    float stepOffsetScale = 1 (
        displayGroup = "Shadow Params"
        displayName = "Step Offset Scale"
        doc = "Ray march offset to avoid a cell shadowing itself."
    )
    float stepSizeScale = 0.75 (
        displayGroup = "Shadow Params"
        displayName = "Step Size Scale"
        doc = "Ray march step size relative to cell size. Higher values increase quality and performance cost."
    )
}

