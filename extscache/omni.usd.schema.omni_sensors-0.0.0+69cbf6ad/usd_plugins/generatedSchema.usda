class "OmniSensorGenericLidarCoreAPI" (
    apiSchemas = ["OmniSensorAPI", "OmniSensorEncryptionAPI", "OmniSensorGenericLidarCoreEmitterStateAPI:s001"]
    doc = "API Defines generic lidar using Core model"
)
{
    float omni:sensor:Core:aspectRatio = 1 (
        doc = "Aspect ratio of the detector"
    )
    token omni:sensor:Core:auxOutputType = "NONE" (
        allowedTokens = ["NONE", "BASIC", "EXTRA", "FULL"]
        doc = "sets the desired level of detail of the output auxiliary data; Runtime changes not supported, yet."
    )
    float omni:sensor:Core:avgPowerW = 0.002 (
        doc = "Average power per emitter in watts"
    )
    float omni:sensor:Core:azimuthErrorMean = 0 (
        doc = "Mean value of the azimuth error in degrees"
    )
    float omni:sensor:Core:azimuthErrorStd = 0.005 (
        doc = "Standard deviation of the azimuth error in degrees"
    )
    float omni:sensor:Core:beamWaistHorM = 0.002 (
        doc = "Beam waist horizontal of the sensor in meters"
    )
    float omni:sensor:Core:beamWaistVerM = 0.002 (
        doc = "Beam waist vertical of the sensor in meters"
    )
    float omni:sensor:Core:bitDepthResolution = 65536 (
        doc = "Bit depth resolution of the sensor"
    )
    float omni:sensor:Core:calibrationGain = 40 (
        doc = "Calibration gain of the sensor"
    )
    float[] omni:sensor:Core:customFrameOfReferenceTrafo = [0, 0, 0, 0, 0, 0] (
        doc = "used only if outputFrameOfReference = CUSTOM. defines the transformation for the custom frame of reference. structured as [x,y,z,roll,pitch,yaw]; Runtime changes not supported, yet."
    )
    float omni:sensor:Core:divergenceHorDeg = 0 (
        doc = "Divergence horizontal of the sensor in degrees"
    )
    float omni:sensor:Core:divergenceVerDeg = 0 (
        doc = "Divergence vertical of the sensor in degrees"
    )
    float omni:sensor:Core:effectiveApertureSizeM = 0.01 (
        doc = "Effective aperture size of the sensor in meters"
    )
    token omni:sensor:Core:elementsCoordsType = "SPHERICAL" (
        allowedTokens = ["CARTESIAN", "SPHERICAL"]
        doc = "sets the desired coordinate system for the output basic elements (not auxiliary data)); Runtime changes not supported, yet."
    )
    float omni:sensor:Core:elevationErrorMean = 0 (
        doc = "Mean value of the elevation error in degrees"
    )
    float omni:sensor:Core:elevationErrorStd = 0 (
        doc = "Standard deviation of the elevation error in degrees"
    )
    string omni:sensor:Core:emitterStatesFile = "" (
        doc = "File containing the emitter states of the sensor; Not supported, yet."
    )
    float omni:sensor:Core:farRangeM = 200 (
        doc = "Maximum range of the sensor in meters"
    )
    float omni:sensor:Core:focusDistM = 0.15 (
        doc = "Focus distance of the sensor in meters"
    )
    float[] omni:sensor:Core:intensityMappingDecoding = [] (
        doc = "Intensity mapping decoding; Changing the number of elements at runtime is not supported."
    )
    float[] omni:sensor:Core:intensityMappingEncoding = [] (
        doc = "Intensity mapping encoding; Changing the number of elements at runtime is not supported."
    )
    token omni:sensor:Core:intensityMappingType = "LINEAR" (
        allowedTokens = ["LINEAR", "NONLINEAR", "NONLINEAR_ENCODING_ONLY", "NONLINEAR_DECODING_ONLY"]
        doc = "Intensity mapping type"
    )
    token omni:sensor:Core:intensityProcessing = "NORMALIZATION" (
        allowedTokens = ["RAW", "NORMALIZATION", "CORRECTION"]
        doc = "Intensity processing mode"
    )
    float omni:sensor:Core:intensityScalePercent = 255 (
        doc = "Intensity scale percent"
    )
    float omni:sensor:Core:maxAzimuthROI = 400 (
        doc = "End azimuth point of the ROI part of the pattern -- in sensor market model frame"
    )
    uint omni:sensor:Core:maxReturns = 2 (
        doc = "Maximum number of returns of the sensor; Runtime changes not supported, yet."
    )
    float omni:sensor:Core:minAzimuthROI = 400 (
        doc = "Start azimuth point of the ROI part of the pattern -- in sensor market model frame"
    )
    float omni:sensor:Core:minDistBetweenEchosM = 0.4 (
        doc = "Minimum distance between two echos in meters"
    )
    float omni:sensor:Core:minReflectance = 0.1 (
        doc = "Minimum reflectance value of an object for a guarantueed Pointcloud at minReflectionRange"
    )
    float omni:sensor:Core:minReflectionRangeM = 200 (
        doc = "Minimum range for a guaranteed detection of an object with minReflectance"
    )
    float omni:sensor:Core:Msquared = 1.4 (
        doc = "M squared value of the sensor"
    )
    float omni:sensor:Core:nearRangeM = 0.3 (
        doc = "Minimum range of the sensor in meters"
    )
    uint omni:sensor:Core:numberOfChannels = 128 (
        doc = "Number of channels of the sensor; Runtime changes not supported, yet."
    )
    uint omni:sensor:Core:numberOfEmitters = 128 (
        doc = "Number of emitters of the sensor; Runtime changes not supported, yet."
    )
    uint omni:sensor:Core:numLines = 0 (
        doc = "Number of lines of the sensor; Runtime changes not supported, yet."
    )
    uint[] omni:sensor:Core:numRaysPerLine = [] (
        doc = "Number of points per line of the sensor; Has numLines elements; Changing the number of elements at runtime is not supported."
    )
    float[] omni:sensor:Core:originErrorMean = [0, 0, 0] (
        doc = "Mean value of the origin error in meters"
    )
    float[] omni:sensor:Core:originErrorStd = [0, 0, 0] (
        doc = "Standard deviation of the origin error in meters"
    )
    token omni:sensor:Core:outputFrameOfReference = "SENSOR" (
        allowedTokens = ["SENSOR", "WORLD", "CUSTOM"]
        doc = "sets the desired frame of reference for all outputs (including auxiliary data); Runtime changes not supported, yet."
    )
    token omni:sensor:Core:outputMotionCompensationState = "NONCOMPENSATED" (
        allowedTokens = ["NONCOMPENSATED", "COMPENSATED"]
        doc = "sets the desired motion compensation state for all outputs (including auxiliary data); Runtime changes not supported, yet."
    )
    float omni:sensor:Core:pixelPitch = 40 (
        doc = "Pixel pitch of the detector"
    )
    uint omni:sensor:Core:pulseTimeNs = 6 (
        doc = "Pulse time of the sensor in ns"
    )
    float omni:sensor:Core:quantumEfficiency = 0.9 (
        doc = "Quantum efficiency of the detector"
    )
    float omni:sensor:Core:rangeAccuracyM = 0.02 (
        doc = "Range accuracy of the sensor in meters"
    )
    uint omni:sensor:Core:rangeCount = 0 (
        doc = "Number of range regions of the emitters"
    )
    float omni:sensor:Core:rangeOffsetM = 0 (
        doc = "Range for which objects are invisible -- useful for sensors inside objects"
    )
    float omni:sensor:Core:rangeResolutionM = 0.004 (
        doc = "Range resolution of the sensor in meters"
    )
    float[] omni:sensor:Core:rangesMaxM = [] (
        doc = "Maximum ranges of the emitters in meters; Has rangeCount elements; Changing the number of elements at runtime is not supported."
    )
    float[] omni:sensor:Core:rangesMinM = [] (
        doc = "Minimum ranges of the emitters in meters; Has rangeCount elements; Changing the number of elements at runtime is not supported."
    )
    token omni:sensor:Core:rayType = "IDEALIZED" (
        allowedTokens = ["IDEALIZED", "GAUSSIAN_BEAM", "UNIFORM_BEAM"]
        doc = "Ray type of the sensor; Runtime changes not supported, yet."
    )
    float omni:sensor:Core:reflectionPowerFraction = 0.5 (
        doc = "Fraction of the reflection power for multiple returns."
    )
    uint omni:sensor:Core:reportRateBaseHz = 36000 (
        doc = "Report rate base of the sensor in Hz; Runtime changes not supported, yet."
    )
    token omni:sensor:Core:rotationDirection = "CW" (
        allowedTokens = ["CW", "CCW"]
        doc = "Rotation direction of the sensor -- only for rotary sensors"
    )
    uint omni:sensor:Core:scanRateBaseHz = 10 (
        doc = "Scan rate base of the sensor in Hz; Runtime changes not supported, yet."
    )
    token omni:sensor:Core:scanType = "ROTARY" (
        allowedTokens = ["ROTARY", "SOLID_STATE"]
        doc = "Scanning principle of the sensor; Runtime changes not supported, yet."
    )
    bool omni:sensor:Core:skipDroppingInvalidPoints = 0 (
        doc = "when false the model will drop invalid points; Runtime changes not supported, yet."
    )
    float omni:sensor:Core:startAzimuthOffsetDeg = 0 (
        doc = "Start azimuth offset angle of the sensor in degrees -- in sensor market model frame"
    )
    uint omni:sensor:Core:stateResolutionStep = 1 (
        doc = "State resolution step of the sensor -- Handles switching between states"
    )
    float omni:sensor:Core:transmissionPowerFraction = 1 (
        doc = "Fraction of the transmission power for multiple returns."
    )
    float omni:sensor:Core:validEndAzimuthDeg = 360 (
        doc = "Valid end azimuth angle of the sensor in degrees -- in sensor market model frame"
    )
    float omni:sensor:Core:validStartAzimuthDeg = 0 (
        doc = "Valid start azimuth angle of the sensor in degrees -- in sensor market model frame"
    )
    float omni:sensor:Core:waveLengthNm = 903 (
        doc = "Wavelength of the sensor in nm"
    )
    string omni:sensor:marketName = "Generic"
    string omni:sensor:modelName = "LidarCore"
    string omni:sensor:modelVendor = "NVIDIA"
    string omni:sensor:modelVersion = "0.0.0"
    float omni:sensor:tickRate = 10
}

class "OmniSensorGenericRadarWpmDmatScanCfgAPI" (
    doc = "API Defines generic radar scan configuration"
)
{
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:azBins = 12 (
        doc = "number of azimuth bins of the scan"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:azimuthRadNoiseMean = 0 (
        doc = "mean value of the azimuth noise in radians"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:azimuthRadNoiseSDev = 0 (
        doc = "standard deviation of the azimuth noise in radians"
    )
    bool omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:binsFromSpec = 1 (
        doc = "deduce number of bins from spec parameters"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:boreAzResDeg = 1.3 (
        doc = "azimuth resolution of the scan in degrees at bore sight"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:boreElResDeg = 5 (
        doc = "elavation resolution of the scan in degrees at bore sight"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarAznG = 0 (
        doc = "cfar number of guard cells for the scan in azimuth dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarAznT = 1 (
        doc = "cfar number of test cells for the scan in azimuth dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarElnG = 0 (
        doc = "cfar number of guard cells for the scan in elevation dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarElnT = 1 (
        doc = "cfar number of test cells for the scan in elevation dimension"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarMinVal = 7e-17 (
        doc = "minimum energy value in a bin to be used in cfar detection"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarNoiseMean = 0 (
        doc = "noise mean value for cfar detection"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarNoiseSDev = 0 (
        doc = "noise standard deviation value for cfar detection"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarOffset = 1 (
        doc = "cfar threshold offset value (multiplier)"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarRnG = 0 (
        doc = "cfar number of guard cells for the scan in range dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarRnT = 1 (
        doc = "cfar number of test cells for the scan in range dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarVnG = 0 (
        doc = "cfar number of guard cells for the scan in velocity dimension"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:cfarVnT = 1 (
        doc = "cfar number of test cells for the scan in velocity dimension"
    )
    bool omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:detValFromBinIdx = 0 (
        doc = "calculate detection value from bin index of the detection peak"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:elBins = 2 (
        doc = "number of elevation bins of the scan"
    )
    token omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:elevMode = "FULL_EL" (
        allowedTokens = ["NO_EL", "POS_EL", "FULL_EL"]
        doc = "elevation mode"
    )
    bool omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:enAngAliasing = 0 (
        doc = "enable angular aliasing"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:maxAzAngDeg = 66 (
        doc = "max azimuth angle of the scan in degrees; Runtime changes not supported, yet."
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:maxElAngDeg = 20 (
        doc = "max elevation angle of the scan in degrees; Runtime changes not supported, yet."
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:maxRangeM = 200 (
        doc = "max detection range of the scan in meters"
    )
    float[] omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:maxVelMpsSequence = [50, 55] (
        doc = "max unambiguous velocity sequence of the scan in meters per second"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:powerFactor = 1 (
        doc = "power factor for the scan tx power"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:rangeNoiseMean = 0 (
        doc = "mean value of the range noise in meters"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:rangeNoiseSDev = 0 (
        doc = "standard deviation of the range noise in meters"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:rangeResM = 0.4 (
        doc = "range resolution of the scan in meters"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:raysPerDeg = 8 (
        doc = "ray tracing density; Runtime changes not supported, yet."
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:rBins = 112 (
        doc = "number of range bins of the scan"
    )
    float[] omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:rcsTuningCoefficients = [-12, 150, 0] (
        doc = "RCS tuning polynomial coefficients. 0: detections with RCS in dBsm lower than this threshold will be removed; 1: multiplied with RCS before conversion to dBsm. Set to 1 if no change is needed; 2: standard deviation of rcs noise in dBsm. Set to 0 if no noise is needed."
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:timeOffsetUsec = 0 (
        doc = "time offset of the scan from the frame time to simulate non-equidistant scans"
    )
    uint omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:vBins = 160 (
        doc = "number of velocity bins of the scan"
    )
    float omni:sensor:WpmDmat:scan:__INSTANCE_NAME__:velResMps = 0.147 (
        doc = "velocity resolution of the scan in meters per second"
    )
}

class "OmniSensorGenericRadarWpmDmatAPI" (
    apiSchemas = ["OmniSensorAPI", "OmniSensorEncryptionAPI", "OmniSensorGenericRadarWpmDmatScanCfgAPI:s001"]
    doc = "API Defines generic radar using WpmDMAT model"
)
{
    string omni:sensor:marketName = "Generic"
    string omni:sensor:modelName = "RadarWPMDMAT"
    string omni:sensor:modelVendor = "NVIDIA"
    string omni:sensor:modelVersion = "0.0.0"
    float omni:sensor:tickRate = 20 (
        doc = "desired framerate of the radar; Runtime changes not supported, yet."
    )
    token omni:sensor:WpmDmat:antennaGainMode = "COSINEFALLOFF" (
        allowedTokens = ["CONSTANT", "COSINEFALLOFF"]
        doc = "antenna gain profile"
    )
    token omni:sensor:WpmDmat:auxOutputType = "NONE" (
        allowedTokens = ["NONE", "BASIC"]
        doc = "sets the desired level of detail of the output auxiliary data; Runtime changes not supported, yet."
    )
    token omni:sensor:WpmDmat:cfarMode = "2D" (
        allowedTokens = ["2D", "4D"]
        doc = "cfar processing mode"
    )
    float[] omni:sensor:WpmDmat:customFrameOfReferenceTrafo = [0, 0, 0, 0, 0, 0] (
        doc = "used only if outputFrameOfReference = CUSTOM. defines the transformation for the custom frame of reference. structured as [x,y,z,roll,pitch,yaw]; Runtime changes not supported, yet."
    )
    token omni:sensor:WpmDmat:elementsCoordsType = "SPHERICAL" (
        allowedTokens = ["CARTESIAN", "SPHERICAL"]
        doc = "sets the desired coordinate system for the output basic elements (not auxiliary data)); Runtime changes not supported, yet."
    )
    uint omni:sensor:WpmDmat:instanceTimeOffsetUsec = 5000 (
        doc = "time offset of this radar instance to simulate continuous firing in a group of radars; Runtime changes not supported, yet."
    )
    token omni:sensor:WpmDmat:outputFrameOfReference = "SENSOR" (
        allowedTokens = ["SENSOR", "WORLD", "CUSTOM"]
        doc = "sets the desired frame of reference for all outputs (including auxiliary data); Runtime changes not supported, yet."
    )
    uint omni:sensor:WpmDmat:traceTreeDepth = 3 (
        doc = "max number of bounces to trace; Runtime changes not supported, yet."
    )
    float omni:sensor:WpmDmat:waveLengthMm = 3.9 (
        doc = "operational wavelength of the radar; Runtime changes not supported, yet."
    )
}

