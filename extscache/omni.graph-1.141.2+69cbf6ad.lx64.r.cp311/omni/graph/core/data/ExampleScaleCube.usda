#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
)

def Xform "World"
{
    def Xform "inputPrim"
    {
        custom float value = 0.5
    }

    def ComputeNode "SimpleNode"
    {
		custom float inputs:value
        prepend float inputs:value.connect = </World/inputPrim.value>
        custom float inputs:multiplier = 3
        custom token node:type = "omni.graph.examples.cpp.ScaleCube"
        
        custom double outputs:value
    }

    def Cube "Cube"
    {
        prepend double size.connect = </World/SimpleNode.outputs:value>    
    }
}

