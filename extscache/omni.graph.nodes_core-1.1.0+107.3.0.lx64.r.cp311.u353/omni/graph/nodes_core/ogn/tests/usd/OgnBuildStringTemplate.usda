        # 2 attributes
        custom token inputs:a (
            docs="""The string(s) to be appended to.  This input determines the output type."""
        )
        custom token inputs:b (
            docs="""The string to be appended."""
        )

        # 1 attribute
        custom token outputs:value (
            docs="""The new string(s)."""
        )
    }
}
