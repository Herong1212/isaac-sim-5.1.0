        )
        custom token inputs:value (
            docs="""The input value. Must be greater than zero or the compute will fail."""
        )

        # 1 attribute
        custom token outputs:result (
            docs="""The logarithm value. The shape and type of this output should match "Value"'s unless the input
            "Value" is not a decimal type, in which case the result should be of type double."""
        )
    }
