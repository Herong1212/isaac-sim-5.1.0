def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_RandomNumeric" (
        docs="""Generates a random numeric value in a range, using a uniform distribution. The range is specified with two inputs: "Minimum" and "Maximum". These inputs can be numbers, vectors, tuples or arrays of these. If one input has a higher dimension than the other, then the input with the lower dimension will be repeated to match the dimension of the other input (broadcasting)."""
    )
    {
        token node:type = "omni.graph.nodes.RandomNumeric"
        int node:typeVersion = 1

        # 6 attributes
        custom uint inputs:execIn (
            docs="""Signal to the graph that this node is ready to be executed."""
        )
        custom bool inputs:isNoise = false (
            docs="""Turn this node into a noise generator function
            For a given seed, it will always output the same number(s)."""
        )
        custom token inputs:max (
            docs="""The maximum of the random range,
            inclusive of integral numbers and
            exclusive for real numbers.
            Can be a number, vector, tuple, or array of these.
            The default value is double 1."""
        )
        custom token inputs:min (
            docs="""The minimum of the random range (inclusive).
            Can be a number, vector, tuple, or array of these.
            The default value is double 0."""
        )
        custom uint64 inputs:seed (
            docs="""The input seed value for the random number generator."""
        )
        custom bool inputs:useSeed = false (
            docs="""Use the custom seed instead of a random one."""
        )

        # 2 attributes
        custom uint outputs:execOut (
            docs="""Signal to the graph that execution can continue downstream."""
        )
        custom token outputs:random (
            docs="""The random numeric value that was generated."""
        )

        # 1 attribute
        custom matrix3d state:gen (
            docs="""Random number generator internal state. Not an actual matrix, the structure was chosen because
            it was large enough to hold the internal data required for the computation."""
        )
    }
