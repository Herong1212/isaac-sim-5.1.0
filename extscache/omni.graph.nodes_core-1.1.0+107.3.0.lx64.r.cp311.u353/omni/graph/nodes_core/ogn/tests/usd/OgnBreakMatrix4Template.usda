#usda 1.0
(
    doc ="""Generated from node description file OgnBreakMatrix4.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_BreakMatrix4" (
        docs="""Split matrix into 4 vectors. If the input is an array, the output will be arrays of vectors."""
    )
    {
        token node:type = "omni.graph.nodes.BreakMatrix4"
        int node:typeVersion = 1

        # 2 attributes
        custom token inputs:matrix (
            docs="""Input matrix(s)"""
        )
        custom token inputs:outputType = "double[4]" (
            docs="""The type of output vector: Double3 or Double4"""
        )

        # 4 attributes
        custom token outputs:w (
            docs="""The fourth row of the matrix"""
        )
        custom token outputs:x (
            docs="""The first row of the matrix"""
        )
        custom token outputs:y (
            docs="""The second row of the matrix"""
        )
        custom token outputs:z (
            docs="""The third row of the matrix"""
        )
    }
}
