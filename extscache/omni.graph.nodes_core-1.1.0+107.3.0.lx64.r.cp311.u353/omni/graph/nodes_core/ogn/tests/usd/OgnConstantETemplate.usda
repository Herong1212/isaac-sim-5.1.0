def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_ConstantE" (
        docs="""Computes the mathematical constant "e" to the power of "Exponent"."""
    )
    {
        token node:type = "omni.graph.nodes.ConstantE"
