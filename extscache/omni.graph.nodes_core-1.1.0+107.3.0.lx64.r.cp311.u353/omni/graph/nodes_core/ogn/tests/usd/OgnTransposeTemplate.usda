#usda 1.0
(
    doc ="""Generated from node description file OgnTranspose.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_Transpose" (
        docs="""Computes the transposed matrix from an input matrix (or array of matrices) and outputs the result in an entirely-new matrix (or array of matrices) - the original inputs are not mutated in-place. The transpose of a matrix is an operation that "flips" a matrix over its diagonal, i.e. it switches the rows the columns of the matrix. For example, the transpose of the 2x3 matrix [[0, 1], [2, 3], [4, 5]] is the 3x2 matrix [[0, 2, 4], [1, 3, 5]]."""
    )
    {
        token node:type = "omni.graph.nodes.Transpose"
        int node:typeVersion = 1

        # 1 attribute
        custom token inputs:matrix (
            docs="""Input matrix or matrices. For arrays of matrices, the transpose will be computed for each member
            matrix."""
        )

        # 1 attribute
        custom token outputs:result (
            docs="""The transposed matrix or matrices, with the same typing and size as the input(s)."""
        )
    }
}
