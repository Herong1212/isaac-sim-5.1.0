mdl 1.6;

import ::df::*;
import ::tex::*;
import ::math::*;
import ::state::*;
import ::anno::*;

// just a material to use for geometry without test cases
export material unused()
= material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.1),
            roughness: 0.0)));


//test that the object has correct uv/tangent
export material uv_grid_srgb()
= material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: tex::lookup_color(
                texture_2d("./grid.jpg", tex::gamma_srgb),
                float2(state::texture_coordinate(0).x, state::texture_coordinate(0).y)
                ),
            roughness: 0.0)));

//test that the object has correct uv/tangent
export material uv_grid_linear()
= material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: tex::lookup_color(
                texture_2d("./grid.jpg", tex::gamma_linear),
                float2(state::texture_coordinate(0).x, state::texture_coordinate(0).y)
                ),
            roughness: 0.0)));


export material simple_glossy_sr(
    float roughness = 0.5
)
= material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::simple_glossy_bsdf(
            tint: color(0.25, 0.5, 0.75),
			multiscatter_tint: color(1.0),
            mode: df::scatter_reflect,
            roughness_u: roughness)));

export material microfacet_ggx_smith_sr(
    float roughness_u = 0.5,
    float roughness_v = 0.5
)
= material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::microfacet_ggx_smith_bsdf(
            tint: color(0.25, 0.5, 0.75),
			multiscatter_tint: color(0.0),
            mode: df::scatter_reflect,
            roughness_u: roughness_u,
            roughness_v: roughness_v)));

export material touch_normal(
    float strength = 0.01
)
= material(
    ior: color(1.5),
    surface: material_surface(
        scattering: df::microfacet_ggx_smith_bsdf(
            tint: color(0.0, 0.75, 0.25),
			multiscatter_tint: color(0.0),
            mode: df::scatter_reflect,
            roughness_u: 0.1)),
    geometry: material_geometry(
        normal: math::normalize(state::normal() + strength * float3(state::texture_coordinate(0).x, state::texture_coordinate(0).y, 1.0))));


export material diffuse_black(
    float roughness = 1.0
)
= material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.0),
            roughness: roughness)));
