class "OmniSkelWeightedBlendAPI" (
    doc = "Provides API for authoring and extracting blend weights for a weighted blend skinning implementation of skeletal deformation."
)
{
    uniform float[] primvars:omni:skel:skinningBlendWeights (
        doc = """Weights for weighted blend skinning method used when OmniWeightedBlendAPI is applied to a prim
        The primvar can have either *constant* or *vertex* interpolation.
        Constant interpolation means every vertex shares the same blend weight.
        Vertex interpolation means every vertex has their own blend weight, and the element size should match the vertex count."""
    )
}

