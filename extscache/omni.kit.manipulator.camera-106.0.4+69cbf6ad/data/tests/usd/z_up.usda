#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            string boundCamera = "/World/Camera"
        }
    }
    defaultPrim = "World"
    metersPerUnit = 0.01
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float2 clippingRange = (1, 10000000)
        float focalLength = 24
        float focusDistance = 400
        custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -417.612260356422)
        double3 xformOp:rotateYXZ = (75, 0, 90)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (400, 0, 120)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ", "xformOp:scale"]
    }
}
