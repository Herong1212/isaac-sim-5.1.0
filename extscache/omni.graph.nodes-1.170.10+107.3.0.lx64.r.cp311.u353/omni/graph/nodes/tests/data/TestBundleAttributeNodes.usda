def ComputeGraph "graph"
{
    def ComputeGraphSettings "computegraphSettings"
    {
        custom token evaluator:type = "dirty_push"
        custom int2 fileFormatVersion = (1, 2)
    }

    def ComputeNode "copyattr"
    {
        rel inputs:fullData = </graph/inputDataReadBundle/outputs_primBundle>
        token inputs:inputAttrNames = "intAttr int64Attr halfAttr floatAttr doubleAttr boolAttr tokenAttr int2Attr half2Attr float2Attr double2Attr int3Attr half3Attr float3Attr double3Attr int4Attr half4Attr float4Attr double4Attr qhAttr qfAttr qdAttr m2dAttr m3dAttr m4dAttr intArrayAttr floatArrayAttr doubleArrayAttr int2ArrayAttr float2ArrayAttr double2ArrayAttr point3fArrayAttr boolArrayAttr tokenArrayAttr stringAttr"
        token inputs:outputAttrNames = "intAttr_copy int64Attr_copy halfAttr_copy floatAttr_copy doubleAttr_copy boolAttr_copy tokenAttr_copy int2Attr_copy half2Attr_copy float2Attr_copy double2Attr_copy int3Attr_copy half3Attr_copy float3Attr_copy double3Attr_copy int4Attr_copy half4Attr_copy float4Attr_copy double4Attr_copy qhAttr_copy qfAttr_copy qdAttr_copy m2dAttr_copy m3dAttr_copy m4dAttr_copy intArrayAttr_copy floatArrayAttr_copy doubleArrayAttr_copy int2ArrayAttr_copy float2ArrayAttr_copy double2ArrayAttr_copy point3fArrayAttr_copy boolArrayAttr_copy tokenArrayAttr_copy stringAttr_copy"
        rel inputs:partialData = </graph/inputDataReadBundle/outputs_primBundle>
        custom token node:type = "omni.graph.nodes.CopyAttribute"
        custom int node:typeVersion = 1

        def Output "outputs_data"
        {
        }
    }

    def ComputeNode "renameattr" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        rel inputs:data = </graph/copyattr/outputs_data>
        token inputs:inputAttrNames.connect = </graph/copyattr.inputs:outputAttrNames>
        token inputs:outputAttrNames = "intAttr_renamed int64Attr_renamed halfAttr_renamed floatAttr_renamed doubleAttr_renamed boolAttr_renamed tokenAttr_renamed int2Attr_renamed half2Attr_renamed float2Attr_renamed double2Attr_renamed int3Attr_renamed half3Attr_renamed float3Attr_renamed double3Attr_renamed int4Attr_renamed half4Attr_renamed float4Attr_renamed double4Attr_renamed qhAttr_renamed qfAttr_renamed qdAttr_renamed m2dAttr_renamed m3dAttr_renamed m4dAttr_renamed intArrayAttr_renamed floatArrayAttr_renamed doubleArrayAttr_renamed int2ArrayAttr_renamed float2ArrayAttr_renamed double2ArrayAttr_renamed point3fArrayAttr_renamed boolArrayAttr_renamed tokenArrayAttr_renamed stringAttr_renamed"
        custom token node:type = "omni.graph.nodes.RenameAttribute"
        custom int node:typeVersion = 1
        uniform float2 ui:nodegraph:node:pos = (-610.00464, 157.5)

        def Output "outputs_data"
