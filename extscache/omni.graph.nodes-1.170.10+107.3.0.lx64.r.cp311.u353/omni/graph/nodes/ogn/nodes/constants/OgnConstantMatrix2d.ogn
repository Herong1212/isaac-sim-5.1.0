{
    "ConstantMatrix2d": {
        "description": [
            "Container for a 2x2 double-precision floating-point matrix value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "version": 1,
        "categories": ["constants"],
        "scheduling": ["pure"],
        "inputs": {
            "value": {
                "type": "matrixd[2]",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
