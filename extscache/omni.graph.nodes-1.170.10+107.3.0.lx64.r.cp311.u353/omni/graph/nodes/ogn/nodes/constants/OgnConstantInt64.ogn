{
    "ConstantInt64": {
        "description": [
            "Container for a 64-bit signed integer value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "version": 1,
        "categories": ["constants"],
        "scheduling": ["pure"],
        "inputs": {
            "value": {
                "type": "int64",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
