{
    "ConstantColor3d": {
        "description": [
            "Container for a double-precision floating-point RGB color value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "categories": ["constants"],
        "scheduling": ["pure"],
        "version": 1,
        "inputs": {
            "value": {
                "type": "colord[3]",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
