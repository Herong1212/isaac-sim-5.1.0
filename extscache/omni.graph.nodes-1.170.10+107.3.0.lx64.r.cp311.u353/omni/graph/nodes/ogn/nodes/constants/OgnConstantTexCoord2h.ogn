{
    "ConstantTexCoord2h": {
        "description": [
            "Container for a 2-component half-precision floating-point UV texture coordinate value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "categories": ["constants"],
        "scheduling": ["pure"],
        "version": 1,
        "inputs": {
            "value": {
                "type": "texcoordh[2]",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
