{
    "ConstantColor4f": {
        "description": [
            "Container for a single-precision floating-point RGBA color value,",
            "mainly used to share a common value between several downstream nodes. The A (alpha) value is not premultiplied."
        ],
        "categories": ["constants"],
        "scheduling": ["pure"],
        "version": 1,
        "inputs": {
            "value": {
                "type": "colorf[4]",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
