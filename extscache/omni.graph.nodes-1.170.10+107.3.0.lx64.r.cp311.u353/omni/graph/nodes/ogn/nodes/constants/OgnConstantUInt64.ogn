{
    "ConstantUInt64": {
        "description": [
            "Container for a 64-bit unsigned integer value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "version": 1,
        "categories": ["constants"],
        "uiName": "Constant UInt64",
        "scheduling": ["pure"],
        "inputs": {
            "value": {
                "type": "uint64",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
