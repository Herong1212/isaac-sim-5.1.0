{
    "ConstantUChar": {
        "description": [
            "Container for an 8-bit unsigned integer, or character, value,",
            "mainly used to share a common value between several downstream nodes."
        ],
        "version": 1,
        "categories": ["constants"],
        "uiName": "Constant UChar",
        "scheduling": ["pure"],
        "inputs": {
            "value": {
                "type": "uchar",
                "description": "The value, acting as both input and output.",
                "uiName": "Value",
                "metadata": {
                    "outputOnly": "1"
                }
            }
        }
    }
}
