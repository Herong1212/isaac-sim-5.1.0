{
    "ToInt": {
        "version": 1,
        "description": [
            "Convert the given input to signed 32-bit integer. Array and tuple inputs",
            "are converted element-wise to arrays and tuples of the same shape.",
            "Conversion of floating-point values is performed by truncation towards zero."
        ],
        "uiName": "To Int",
        "categories": ["math:conversion"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "value": {
                "type": ["integrals", "decimals", "bool", "bool[]"],
                "uiName": "Value",
                "description": "The numeric or boolean value to convert."
             }
        },
        "outputs": {
            "converted": {
                "type": ["int", "int[2]", "int[3]", "int[4]", "int[]", "int[2][]", "int[3][]", "int[4][]"],
                "uiName": "Int",
                "description": "The value converted to 32-bit integer form."
             }
        },
        "tests" : [
            {
                "inputs:value": {"type": "bool", "value": true},
                "outputs:converted": {"type": "int", "value": 1}
            },
            {
                "inputs:value": {"type": "int", "value": 42},
                "outputs:converted": {"type": "int", "value": 42}
            },
            {
                "inputs:value": {"type": "uint", "value": 96},
                "outputs:converted": {"type": "int", "value": 96}
            },
            {
                "inputs:value": {"type": "int64", "value": 42},
                "outputs:converted": {"type": "int", "value": 42}
            },
            {
                "inputs:value": {"type": "uint64", "value": 0},
                "outputs:converted": {"type": "int", "value": 0}
            },
            {
                "inputs:value": {"type": "float", "value": 2.9},
                "outputs:converted": {"type": "int", "value": 2}
            },
            {
                "inputs:value": {"type": "double", "value": 2.1},
                "outputs:converted": {"type": "int", "value": 2}
            },
            {
                "inputs:value": {"type": "half", "value": 2.9},
                "outputs:converted": {"type": "int", "value": 2}
            },
            {
                "inputs:value": {"type": "uchar", "value": 35},
                "outputs:converted": {"type": "int", "value": 35}
            },
            {
                "inputs:value": {"type": "bool[]", "value": [true, false]},
                "outputs:converted": {"type": "int[]", "value": [1, 0]}
            },
            {
                "inputs:value": {"type": "int[]", "value": [2, 0, -4] },
                "outputs:converted": {"type": "int[]", "value": [2, 0, -4] }
            },
            {
                "inputs:value": {"type": "uint[]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "int64[]", "value": [2, 3, -4] },
                "outputs:converted": {"type": "int[]", "value": [2, 3, -4] }
            },
            {
                "inputs:value": {"type": "uint64[]", "value": [2, 0, 4] },
                "outputs:converted": {"type": "int[]", "value": [2, 0, 4] }
            },
            {
                "inputs:value": {"type": "float[]", "value": [] },
                "outputs:converted": {"type": "int[]", "value": []}
            },
            {
                "inputs:value": {"type": "double[]", "value": [2.1, 0, 4.7] },
                "outputs:converted": {"type": "int[]", "value": [2, 0, 4] }
            },
            {
                "inputs:value": {"type": "half[]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "uchar[]", "value": [2, 0, 4] },
                "outputs:converted": {"type": "int[]", "value": [2, 0, 4] }
            },
            {
                "inputs:value": {"type": "double[2]", "value": [2.1, 2.1] },
                "outputs:converted": {"type": "int[2]", "value": [2, 2]}
            },
            {
                "inputs:value": {"type": "float[2]", "value": [2.1, 2.1] },
                "outputs:converted": {"type": "int[2]", "value": [2, 2]}
            },
            {
                "inputs:value": {"type": "half[2]", "value": [2.5, 2.5] },
                "outputs:converted": {"type": "int[2]", "value": [2, 2]}
            },
            {
                "inputs:value": {"type": "int[2]", "value": [42, 42] },
                "outputs:converted": {"type": "int[2]", "value": [42, 42]}
            },
            {
                "inputs:value": {"type": "double[3]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "float[3]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "half[3]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[3]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "int[3]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "double[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "int[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "float[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "int[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "half[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "int[4]", "value": [2, 3, 4, 5] }
            },
            {
                "inputs:value": {"type": "int[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "int[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "double[2][]",  "value": [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "int[2][]", "value":  [[1, 2],[3, 4]] }
            },
            {
                "inputs:value": {"type": "float[2][]", "value":  [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "int[2][]", "value":  [[1, 2],[3, 4]] }
            },
            {
                "inputs:value": {"type": "half[2][]", "value":  [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "int[2][]", "value":  [[1, 2],[3, 4]] }
            },
            {
                "inputs:value": {"type": "int[2][]", "value": [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "int[2][]", "value": [[1, 2],[3, 4]] }
            },
            {
                "inputs:value": {"type": "double[3][]", "value": [[2, 3, 4]] },
                "outputs:converted": {"type": "int[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "float[3][]", "value": [[2, 3, 4]] },
                "outputs:converted": {"type": "int[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "half[3][]", "value": [[2, 3, 4]] },
                "outputs:converted": {"type": "int[3][]", "value": [[2, 3, 4]] }
            },
            {
                "inputs:value": {"type": "int[3][]", "value": [[2, 3, 4]] },
                "outputs:converted": {"type": "int[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "double[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "int[4][]", "value": [[2, 3, 4, 5]]}
            },
            {
                "inputs:value": {"type": "float[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "int[4][]", "value": [[2, 3, 4, 5]]}
            },
            {
                "inputs:value": {"type": "half[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "int[4][]", "value": [[2, 3, 4, 5]] }
            },
            {
                "inputs:value": {"type": "int[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "int[4][]", "value": [[2, 3, 4, 5]]}
            }
        ]
    }
}
