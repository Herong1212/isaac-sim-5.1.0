{
    "ConstructArray": {
        "version": 1,
        "description": [
            "Makes an output array attribute from input values, in the order of the inputs.",
            "If 'Array Size' is less than the number of input elements, the first 'Array Size' elements will be used.",
            "If 'Array Size' is greater than the number of input elements, the last input element will be repeated",
            "to fill the remaining space."
        ],
        "categories": ["math:array"],
        "uiName": "Make Array",
        "scheduling": ["threadsafe"],
        "inputs": {
            "input0": {
                "type": ["array_elements", "bool"],
                "description": "Input array element"
            },
            "arraySize": {
                "type": "int",
                "description": "The size of the array to construct.",
                "default": 1,
                "minimum": 0,
                "metadata": { "literalOnly": "1" }
            },
            "arrayType": {
                "type": "token",
                "description": [
                    "The type of the array to construct. A value of 'auto' infers the type from the",
                    "first connected and resolved input."
                ],
                "uiName": "Array Type",
                "default": "auto",
                "metadata": {
                    "literalOnly": "1",
                    "allowedTokens": {
                        "Auto": "auto",
                        "Bool": "bool[]",
                        "Double": "double[]",
                        "Float": "float[]",
                        "Half": "half[]",
                        "Int": "int[]",
                        "Int64": "int64[]",
                        "Token": "token[]",
                        "UChar": "uchar[]",
                        "UInt": "uint[]",
                        "UInt64": "uint64[]",
                        "Double_2": "double[2][]",
                        "Double_3": "double[3][]",
                        "Double_4": "double[4][]",
                        "Matrix_2": "matrixd[2][]",
                        "Double_9": "matrixd[3][]",
                        "Double_16": "matrixd[4][]",
                        "Float_2": "float[2][]",
                        "Float_3": "float[3][]",
                        "Float_4": "float[4][]",
                        "Half_2": "half[2][]",
                        "Half_3": "half[3][]",
                        "Half_4": "half[4][]",
                        "Int_2": "int[2][]",
                        "Int_3": "int[3][]",
                        "Int_4": "int[4][]",
                        "Timecode": "timecode[]",
                        "Frame": "frame[4][]",
                        "Colord_3": "colord[3][]",
                        "Colorf_3": "colorf[3][]",
                        "Colorh_3": "colorh[3][]",
                        "Colord_4": "colord[4][]",
                        "Colorf_4": "colorf[4][]",
                        "Colorh_4": "colorh[4][]",
                        "Normald": "normald[3][]",
                        "Normalf": "normalf[3][]",
                        "Normalh": "normalh[3][]",
                        "Pointd": "pointd[3][]",
                        "Pointf": "pointf[3][]",
                        "Pointh": "pointh[3][]",
                        "Quatd": "quatd[4][]",
                        "Quatf": "quatf[4][]",
                        "Quath": "quath[4][]",
                        "TexCoordd_2": "texcoordd[2][]",
                        "TexCoordf_2": "texcoordf[2][]",
                        "TexCoordh_2": "texcoordh[2][]",
                        "TexCoordd_3": "texcoordd[3][]",
                        "TexCoordf_3": "texcoordf[3][]",
                        "TexCoordh_3": "texcoordh[3][]",
                        "Vectord": "vectord[3][]",
                        "Vectorf": "vectorf[3][]",
                        "Vectorh": "vectorh[3][]"
                    }
                }
            }
        },
        "outputs": {
            "array": {
                "type": ["arrays", "bool[]"],
                "description": [
                    "The constructed array of size 'Array Size' with the data type specified in 'Array Type' and",
                    "values populated from the input array."
                ]
            }
        },
        "tests": [
            {
                "inputs:arraySize": 1, "inputs:arrayType": "bool[]",
                "inputs:input0": {"type": "bool", "value": true},
                "outputs:array": {"type": "bool[]", "value": [true]}
            },
            {
                "inputs:arraySize": 1, "inputs:arrayType": "double[]",
                "inputs:input0": {"type": "double", "value": 2.35423},
                "outputs:array": {"type": "double[]", "value": [2.35423]}
            },
            {
                "inputs:arraySize": 1, "inputs:arrayType": "float[]",
                "inputs:input0": {"type": "float", "value": 5.22},
                "outputs:array": {"type": "float[]", "value": [5.22]}
            },
            {
                "inputs:arraySize": 1, "inputs:arrayType": "half[]",
                "inputs:input0": {"type": "half", "value": 0.5},
                "outputs:array": {"type": "half[]", "value": [0.5]}
            },
            {
                "inputs:arraySize": 1, "inputs:arrayType": "int[]",
                "inputs:input0": {"type": "int", "value": -78},
                "outputs:array": {"type": "int[]", "value": [-78]}
            },
            {
                "inputs:arraySize": 1, "inputs:arrayType": "int64[]",
                "inputs:input0": {"type": "int64", "value": -8294},
                "outputs:array": {"type": "int64[]", "value": [-8294]}
            },
