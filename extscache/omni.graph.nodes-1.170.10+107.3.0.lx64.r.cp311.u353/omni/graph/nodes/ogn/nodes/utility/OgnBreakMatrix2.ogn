{
    "BreakMatrix2": {
        "version": 1,
        "description": [
            "Split matrix into 2 vectors.",
            "If the input is an array, the output will be arrays of vectors."
        ],
        "uiName": "Break Matrix2",
        "categories": ["math:conversion"],
        "tags": ["decompose", "separate", "isolate"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "matrix": {
                "type": ["matrixd[2]", "matrixd[2][]"],
                "uiName": "Matrix",
                "description": "Input matrix(s)"
            }
        },
        "outputs": {
            "x": {
                "type": ["double[2]", "double[2][]"],
                "uiName": "X",
                "description": "The first row of the matrix"
            },
            "y": {
                "type": ["double[2]", "double[2][]"],
                "uiName": "Y",
                "description": "The second row of the matrix"
            }
        },
        "tests": [
            {
                "inputs:matrix": {"type": "matrixd[2]", "value": [1, 2, 3, 4]},
                "outputs:x": {"type": "double[2]", "value": [1, 2]},
                "outputs:y": {"type": "double[2]", "value": [3, 4]}
            },
            {
                "inputs:matrix": {"type": "matrixd[2][]", "value": [[1, 2, 3, 4]]},
                "outputs:x": {"type": "double[2][]", "value": [[1, 2]]},
                "outputs:y": {"type": "double[2][]", "value": [[3, 4]]}
            }
        ]
    }
}
