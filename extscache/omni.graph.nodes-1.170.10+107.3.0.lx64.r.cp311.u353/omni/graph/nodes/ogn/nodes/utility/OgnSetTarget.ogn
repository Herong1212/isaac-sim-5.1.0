{
    "SetTarget": {
        "version": 1,
        "description": [
            "Sets a target in a target array at an index in range [-arrayLength, arrayLength).",
            "If the given index is negative it will be an offset from the end of the array."
        ],
        "uiName": "Set Target",
        "categories": ["sceneGraph"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "targets": {
                "type": "target",
                "description": "The input target array.",
                "metadata": {
                    "allowMultiInputs": "1"
                }
            },
            "index": {
                "type": "int",
                "description": [
                    "The index into the array in range [-arrayLength, arrayLength).",
                    "A negative value indexes from the end of the array."
                ]
            },
            "setTarget": {
                "type": "target",
                "description": "The target to set at the given index."
            }
        },
        "outputs": {
            "targets": {
                "type": "target",
                "description": "The modified target array."
            }
        },
        "tests": [
            {
                "inputs:targets": [],
                "inputs:setTarget": [],
                "outputs:targets": []
            },
            {
                "inputs:targets": ["/A", "/B", "/C"],
                "inputs:setTarget": [],
                "outputs:targets": ["/A", "/B", "/C"]
            },
            {
                "inputs:targets": ["/A", "/B", "/C"],
                "inputs:setTarget": "/X",
                "inputs:index": 0,
                "outputs:targets": ["/X", "/B", "/C"]
            },
            {
                "inputs:targets": ["/A", "/B", "/C"],
                "inputs:setTarget": "/X",
                "inputs:index": -1,
                "outputs:targets": ["/A", "/B", "/X"]
            }
        ]
    }
}
