{
    "ToHalf": {
        "version": 1,
        "description": [
            "Convert the given input to 16-bit floating-point. Array and tuple inputs",
            "are converted element-wise to arrays and tuples of the same shape."
        ],
        "uiName": "To Half",
        "categories": ["math:conversion"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "value": {
                "type": ["integrals", "decimals", "bool", "bool[]"],
                "uiName": "Value",
                "description": "The numeric or boolean value to convert."
             },
             "role": {
                 "type": "token",
                 "uiName": "role",
                 "description": [
                    "The attribute role to apply to the output type. If the role is",
                    "not supported by the output shape, a role of None is used."
                 ],
                 "default": "None",
                 "metadata": {
                     "literalOnly": "1",
                     "allowedTokens": {
                        "eNone" : "None",
                        "eColor" : "Color",
                        "eFrame" : "Frame",
                        "eNormal" : "Normal",
                        "ePosition" : "Point",
                        "eQuaternion" : "Quaternion",
                        "eTexCoord" : "TexCoord",
                        "eTimeCode" : "Timecode",
                        "eVector" : "Vector"
                    }
                 }
              }
        },
        "outputs": {
            "converted": {
                "type": ["half", "half[2]", "half[3]", "half[4]", "half[]", "half[2][]", "half[3][]", "half[4][]",
                    "colorh[3]", "colorh[3][]", "colorh[4]", "colorh[4][]", "normalh[3]", "normalh[3][]",
                    "pointh[3]", "pointh[3][]", "texcoordh[2]", "texcoordh[2][]", "texcoordh[3]", "texcoordh[3][]",
                    "quath[4]", "quath[4][]", "vectorh[3]", "vectorh[3][]"],
                "uiName": "Half",
                "description": "The value converted to 16-bit floating-point form with the role applied."
             }
        },
        "tests" : [
            {
                "inputs:value": {"type": "bool", "value": true},
                "outputs:converted": {"type": "half", "value": 1.0}
            },
            {
                "inputs:value": {"type": "double", "value": 2.5},
                "outputs:converted": {"type": "half", "value": 2.5}
            },
            {
                "inputs:value": {"type": "float", "value": 2.5},
                "outputs:converted": {"type": "half", "value": 2.5}
            },
            {
                "inputs:value": {"type": "half", "value": 2.5},
                "outputs:converted": {"type": "half", "value": 2.5}
            },
            {
                "inputs:value": {"type": "int", "value": 42},
                "outputs:converted": {"type": "half", "value": 42.0}
            },
            {
                "inputs:value": {"type": "int64", "value": 42},
                "outputs:converted": {"type": "half", "value": 42.0}
            },
            {
                "inputs:value": {"type": "uchar", "value": 42},
                "outputs:converted": {"type": "half", "value": 42.0}
            },
            {
                "inputs:value": {"type": "uint", "value": 42},
                "outputs:converted": {"type": "half", "value": 42.0}
            },
            {
                "inputs:value": {"type": "uint64", "value": 42},
                "outputs:converted": {"type": "half", "value": 42.0}
            },
            {
                "inputs:value": {"type": "bool[]", "value": [true, false]},
                "outputs:converted": {"type": "half[]", "value": [1.0, 0.0]}
            },
            {
                "inputs:value": {"type": "double[]", "value": 2.5},
                "outputs:converted": {"type": "half[]", "value": 2.5}
            },
            {
                "inputs:value": {"type": "float[]", "value": [] },
                "outputs:converted": {"type": "half[]", "value": []}
            },
            {
                "inputs:value": {"type": "half[]", "value": [2.5, 3.5]},
                "outputs:converted": {"type": "half[]", "value": [2.5, 3.5]}
            },
            {
                "inputs:value": {"type": "int[]", "value": [42, -99]},
                "outputs:converted": {"type": "half[]", "value": [42.0, -99.0]}
            },
            {
                "inputs:value": {"type": "int64[]", "value": [42, -99]},
                "outputs:converted": {"type": "half[]", "value": [42.0, -99.0]}
            },
            {
                "inputs:value": {"type": "uchar[]", "value": [42, 16]},
                "outputs:converted": {"type": "half[]", "value": [42.0, 16.0]}
            },
            {
                "inputs:value": {"type": "uint[]", "value": [42, 16]},
                "outputs:converted": {"type": "half[]", "value": [42.0, 16.0]}
            },
            {
                "inputs:value": {"type": "uint64[]", "value": [42, 16]},
                "outputs:converted": {"type": "half[]", "value": [42.0, 16.0]}
            },
            {
                "inputs:value": {"type": "double[2]", "value": [2.5, 2.5] }, "inputs:role": "TexCoord",
                "outputs:converted": {"type": "texcoordh[2]", "value": [2.5, 2.5]}
            },
            {
                "inputs:value": {"type": "float[2]", "value": [2.5, 2.5] },
                "outputs:converted": {"type": "half[2]", "value": [2.5, 2.5]}
            },
            {
                "inputs:value": {"type": "half[2]", "value": [2.5, 2.5] },
                "outputs:converted": {"type": "half[2]", "value": [2.5, 2.5]}
            },
            {
                "inputs:value": {"type": "int[2]", "value": [42, 42] },
                "outputs:converted": {"type": "half[2]", "value": [42.0, 42.0]}
            },
            {
                "inputs:value": {"type": "double[3]", "value": [2, 3, 4] }, "inputs:role": "Color",
                "outputs:converted": {"type": "colorh[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "float[3]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "half[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "half[3]", "value": [2, 3, 4] }, "inputs:role": "Vector",
                "outputs:converted": {"type": "vectorh[3]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "int[3]", "value": [2, 3, 4] }, "inputs:role": "Normal",
                "outputs:converted": {"type": "normalh[3]", "value": [2, 3, 4]}
            },
            {
                "inputs:value": {"type": "double[4]", "value": [2, 3, 4, 5] }, "inputs:role": "Quaternion",
                "outputs:converted": {"type": "quath[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "float[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "half[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "half[4]", "value": [2, 3, 4, 5] }, "inputs:role": "Color",
                "outputs:converted": {"type": "colorh[4]", "value": [2, 3, 4, 5] }
            },
            {
                "inputs:value": {"type": "int[4]", "value": [2, 3, 4, 5] },
                "outputs:converted": {"type": "half[4]", "value": [2, 3, 4, 5]}
            },
            {
                "inputs:value": {"type": "double[2][]",  "value": [[1, 2],[3, 4]] }, "inputs:role": "TexCoord",
                "outputs:converted": {"type": "texcoordh[2][]", "value":  [[1.0, 2.0],[3.0, 4.0]] }
            },
            {
                "inputs:value": {"type": "float[2][]", "value":  [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "half[2][]", "value":  [[1.0, 2.0],[3.0, 4.0]] }
            },
            {
                "inputs:value": {"type": "half[2][]", "value":  [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "half[2][]", "value":  [[1.0, 2.0],[3.0, 4.0]] }
            },
            {
                "inputs:value": {"type": "int[2][]", "value": [[1, 2],[3, 4]] },
                "outputs:converted": {"type": "half[2][]", "value": [[1.0, 2.0],[3.0, 4.0]] }
            },
            {
                "inputs:value": {"type": "double[3][]", "value": [[2, 3, 4]] }, "inputs:role": "Point",
                "outputs:converted": {"type": "pointh[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "float[3][]", "value": [[2, 3, 4]] }, "inputs:role": "TexCoord",
                "outputs:converted": {"type": "texcoordh[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "half[3][]", "value": [[2, 3, 4]] },
                "outputs:converted": {"type": "half[3][]", "value": [[2, 3, 4]] }
            },
            {
                "inputs:value": {"type": "int[3][]", "value": [[2, 3, 4]] }, "inputs:role": "Normal",
                "outputs:converted": {"type": "normalh[3][]", "value": [[2, 3, 4]]}
            },
            {
                "inputs:value": {"type": "double[4][]", "value": [[2, 3, 4, 5]] }, "inputs:role": "Quaternion",
                "outputs:converted": {"type": "quath[4][]", "value": [[2, 3, 4, 5]]}
            },
            {
                "inputs:value": {"type": "float[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "half[4][]", "value": [[2, 3, 4, 5]]}
            },
            {
                "inputs:value": {"type": "half[4][]", "value": [[2, 3, 4, 5]] }, "inputs:role": "Color",
                "outputs:converted": {"type": "colorh[4][]", "value": [[2, 3, 4, 5]] }
            },
            {
                "inputs:value": {"type": "int[4][]", "value": [[2, 3, 4, 5]] },
                "outputs:converted": {"type": "half[4][]", "value": [[2, 3, 4, 5]]}
            }
        ]
    }
}
