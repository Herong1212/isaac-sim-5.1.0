{
    "MakeMatrix3": {
        "version": 1,
        "description": [
            "Merge 3 row vectors into a matrix.",
            "If the inputs are arrays, the output will be an array of matrices."
        ],
        "uiName": "Make Matrix3",
        "categories": ["math:conversion"],
        "tags": ["compose", "combine", "join"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "x": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "First Row",
                "description": "The first row of the matrix"
            },
            "y": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "Second Row",
                "description": "The second row of the matrix"
            },
            "z": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "Third Row",
                "description": "The third row of the matrix"
            }
        },
        "outputs": {
            "matrix": {
                "type": ["matrixd[3]", "matrixd[3][]"],
                "uiName": "Matrix",
                "description": "Matrix formed from the input row vectors"
            }
        },
        "tests": [
            {
                "inputs:x": {"type": "double[3]", "value": [1, 2, 3] },
                "inputs:y": {"type": "double[3]", "value": [4, 5, 6] },
                "inputs:z": {"type": "double[3]", "value": [7, 8, 9] },
                "outputs:matrix": {"type": "matrixd[3]", "value": [1, 2, 3, 4, 5, 6, 7, 8, 9] }
            },
            {
                "inputs:x": {"type": "double[3][]", "value": [[1, 2, 3]] },
                "inputs:y": {"type": "double[3][]", "value": [[4, 5, 6]] },
                "inputs:z": {"type": "double[3][]", "value": [[7, 8, 9]] },
                "outputs:matrix": {"type": "matrixd[3][]", "value": [[1, 2, 3, 4, 5, 6, 7, 8, 9]] }
            }
        ]
    }
}
