                "inputs:b": {"type": "int[]", "value": [3, 0]},
                "inputs:operation": ">=",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "int64", "value": 9223372036854775807},
                "inputs:b": {"type": "int64", "value": 9223372036854775807},
