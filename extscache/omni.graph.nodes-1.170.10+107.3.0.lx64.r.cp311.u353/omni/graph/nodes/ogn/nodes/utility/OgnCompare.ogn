{
    "Compare": {
        "version": 1,
        "description": [
            "Outputs the truth value of a comparison operation. Tuples are compared in lexicographic order.",
            "If one input is an array and the other is a scalar, the scalar will be broadcast to the size of",
            "the array."
        ],
        "uiName": "Compare",
        "categories": ["math:condition"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "a": {
                "type": ["numerics", "string_types", "bool", "bool[]"],
                "description": "The first of the two inputs for which comparison will be invoked."
            },
            "b": {
                "type": ["numerics", "string_types", "bool", "bool[]"],
                "description": "The second of the two inputs for which comparison will be invoked."
            },
            "operation": {
                "type": "token",
                "description": "The comparison operation to perform (>,<,>=,<=,==,!=)",
                "uiName": "Operation",
                "default": ">",
                "metadata": {
                    "allowedTokens": {
                        "gt": ">",
                        "lt": "<",
                        "ge": ">=",
                        "le": "<=",
                        "eq": "==",
                        "ne": "!="
                    }
                }
            }
        },
        "outputs": {
            "result": {
                "type": ["bool", "bool[]"],
                "description": "The truth-value result of the comparison operation between inputs \"A\" and \"B\".",
                "uiName": "Result"
            }
        },
        "tests" : [
            {
                "inputs:a": {"type": "bool", "value": true},
                "inputs:b": {"type": "bool", "value": false},
                "inputs:operation": "==",
                "outputs:result": {"type": "bool", "value": false}
            },
            {
                "inputs:a": {"type": "bool", "value": true},
                "inputs:b": {"type": "bool[]", "value": [true, false]},
                "inputs:operation": "==",
                "outputs:result": {"type": "bool[]", "value": [true, false]}
            },
            {
                "inputs:a": {"type": "bool[]", "value": [true, false]},
                "inputs:b": {"type": "bool", "value": true},
                "inputs:operation": "!=",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "bool[]", "value": [true, false]},
                "inputs:b": {"type": "bool[]", "value": [true, false]},
                "inputs:operation": "==",
                "outputs:result": {"type": "bool[]", "value": [true, true]}
            },
            {
                "inputs:a": {"type": "double", "value": 1},
                "inputs:b": {"type": "double", "value": 2},
                "inputs:operation": ">",
                "outputs:result": {"type": "bool", "value": false}
            },
            {
                "inputs:a": {"type": "double", "value": 1},
                "inputs:b": {"type": "double[]", "value": [1, 2]},
                "inputs:operation": "<",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "double[]", "value": [1, 2]},
                "inputs:b": {"type": "double", "value": 1},
                "inputs:operation": "<=",
                "outputs:result": {"type": "bool[]", "value": [true, false]}
            },
            {
                "inputs:a": {"type": "double[]", "value": [2.0, 3.0]},
                "inputs:b": {"type": "double[]", "value": [2.0, 3.1]},
                "inputs:operation": "<=",
                "outputs:result": {"type": "bool[]", "value": [true, true]}
            },
            {
                "inputs:a": {"type": "float", "value": 42.0},
                "inputs:b": {"type": "float", "value": 1.0},
                "inputs:operation": ">",
                "outputs:result": {"type": "bool", "value": true}
            },
            {
                "inputs:a": {"type": "float", "value": 42.0},
                "inputs:b": {"type": "float", "value": 1.0},
                "inputs:operation": "<=",
                "outputs:result": {"type": "bool", "value": false}
            },

            {
                "inputs:a": {"type": "float", "value": 1},
                "inputs:b": {"type": "float[]", "value": [1, 2]},
                "inputs:operation": "<",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "float[]", "value": [1, 2]},
                "inputs:b": {"type": "float", "value": 1},
                "inputs:operation": "<=",
                "outputs:result": {"type": "bool[]", "value": [true, false]}
            },
            {
                "inputs:a": {"type": "float[]", "value": [1.0, 2.0]},
                "inputs:b": {"type": "float[]", "value": [1.0, 2.01]},
                "inputs:operation": "==",
                "outputs:result": {"type": "bool[]", "value": [true, false]}
            },
            {
                "inputs:a": {"type": "half", "value": 1},
                "inputs:b": {"type": "half", "value": 2},
                "inputs:operation": ">",
                "outputs:result": {"type": "bool", "value": false}
            },
            {
                "inputs:a": {"type": "half", "value": 1},
                "inputs:b": {"type": "half[]", "value": [1, 2]},
                "inputs:operation": "<",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "half[]", "value": [1, 2]},
                "inputs:b": {"type": "half", "value": 1},
                "inputs:operation": "<=",
                "outputs:result": {"type": "bool[]", "value": [true, false]}
            },
            {
                "inputs:a": {"type": "half[]", "value": [1, 2]},
                "inputs:b": {"type": "half[]", "value": [3, 0]},
                "inputs:operation": ">=",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "int", "value": 1},
                "inputs:b": {"type": "int", "value": 2},
                "inputs:operation": ">",
                "outputs:result": {"type": "bool", "value": false}
            },
            {
                "inputs:a": {"type": "int", "value": 1},
                "inputs:b": {"type": "int[]", "value": [1, 2]},
                "inputs:operation": "<",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "int[]", "value": [1, 2]},
