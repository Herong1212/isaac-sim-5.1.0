                "inputs:b": {"type": "int64[]", "value": [3, 0]},
                "inputs:operation": ">=",
                "outputs:result": {"type": "bool[]", "value": [false, true]}
            },
            {
                "inputs:a": {"type": "token", "value": ""},
                "inputs:b": {"type": "token", "value": ""},
                "inputs:operation": "==",
                "outputs:result": {"type": "bool", "value": true}
            },
