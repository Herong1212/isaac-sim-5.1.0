{
    "ToInt64": {
        "version": 1,
        "description": [
            "Convert the given input to signed 64-bit integer. Array and tuple inputs",
            "are converted element-wise to arrays and tuples of the same shape.",
            "Conversion of floating-point values is performed by truncation towards zero."
        ],
        "uiName": "To Int64",
        "categories": ["math:conversion"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "value": {
                "type": ["bool",   "int",   "uint",   "int64",   "uint64",   "float",   "double",   "half",   "uchar",
                         "bool[]", "int[]", "uint[]", "int64[]", "uint64[]", "float[]", "double[]", "half[]", "uchar[]"],
                "uiName": "Value",
                "description": "The numeric or boolean value to convert."
             }
        },
        "outputs": {
            "converted": {
                "type": ["int64", "int64[]"],
                "uiName": "Int64",
                "description": "The value converted to 64-bit integer form."
             }
        },
        "tests" : [
            {
                "inputs:value": {"type": "bool", "value": true},
                "outputs:converted": {"type": "int64", "value": 1}
            },
            {
                "inputs:value": {"type": "int", "value": 42},
                "outputs:converted": {"type": "int64", "value": 42}
            },
            {
                "inputs:value": {"type": "uint", "value": 96},
                "outputs:converted": {"type": "int64", "value": 96}
            },
            {
                "inputs:value": {"type": "int64", "value": 42},
                "outputs:converted": {"type": "int64", "value": 42}
            },
            {
                "inputs:value": {"type": "uint64", "value": 0},
                "outputs:converted": {"type": "int64", "value": 0}
            },
            {
                "inputs:value": {"type": "float", "value": 2.9},
                "outputs:converted": {"type": "int64", "value": 2}
            },
            {
                "inputs:value": {"type": "double", "value": 2.1},
                "outputs:converted": {"type": "int64", "value": 2}
            },
            {
                "inputs:value": {"type": "half", "value": 2.9},
                "outputs:converted": {"type": "int64", "value": 2}
            },
            {
                "inputs:value": {"type": "uchar", "value": 35},
                "outputs:converted": {"type": "int64", "value": 35}
            },
            {
                "inputs:value": {"type": "bool[]", "value": [true, false]},
                "outputs:converted": {"type": "int64[]", "value": [1, 0]}
            },
            {
                "inputs:value": {"type": "int[]", "value": [2, 0, -4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 0, -4] }
            },
            {
                "inputs:value": {"type": "uint[]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "int64[]", "value": [2, 3, -4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 3, -4] }
            },
            {
                "inputs:value": {"type": "uint64[]", "value": [2, 0, 4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 0, 4] }
            },
            {
                "inputs:value": {"type": "float[]", "value": [] },
                "outputs:converted": {"type": "int64[]", "value": []}
            },
            {
                "inputs:value": {"type": "double[]", "value": [2.1, 0, 4.7] },
                "outputs:converted": {"type": "int64[]", "value": [2, 0, 4] }
            },
            {
                "inputs:value": {"type": "half[]", "value": [2, 3, 4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 3, 4] }
            },
            {
                "inputs:value": {"type": "uchar[]", "value": [2, 0, 4] },
                "outputs:converted": {"type": "int64[]", "value": [2, 0, 4] }
            }
        ]
    }
}
