{
    "BreakMatrix3": {
        "version": 1,
        "description": [
            "Split matrix into 3 vectors.",
            "If the input is an array, the output will be arrays of vectors."
        ],
        "uiName": "Break Matrix3",
        "categories": ["math:conversion"],
        "tags": ["decompose", "separate", "isolate"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "matrix": {
                "type": ["matrixd[3]", "matrixd[3][]"],
                "uiName": "Matrix",
                "description": "Input matrix(s)"
            }
        },
        "outputs": {
            "x": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "X",
                "description": "The first row of the matrix"
            },
            "y": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "Y",
                "description": "The second row of the matrix"
            },
            "z": {
                "type": ["double[3]", "double[3][]"],
                "uiName": "Z",
                "description": "The third row of the matrix"
            }
        },
        "tests": [
            {
                "inputs:matrix": {"type": "matrixd[3]", "value": [1, 2, 3, 4, 5, 6, 7, 8, 9] },
                "outputs:x": {"type": "double[3]", "value": [1, 2, 3] },
                "outputs:y": {"type": "double[3]", "value": [4, 5, 6] },
                "outputs:z": {"type": "double[3]", "value": [7, 8, 9] }
            },
            {
                "inputs:matrix": {"type": "matrixd[3][]", "value": [[1, 2, 3, 4, 5, 6, 7, 8, 9]] },
                "outputs:x": {"type": "double[3][]", "value": [[1, 2, 3]] },
                "outputs:y": {"type": "double[3][]", "value": [[4, 5, 6]] },
                "outputs:z": {"type": "double[3][]", "value": [[7, 8, 9]] }
            }
        ]
    }
}
