{
    "Add": {
        "version": 2,
        "description": [
            "Add two or more values of any numeric type (element-wise). This includes simple values, tuples, arrays,",
            "and arrays of tuples. If one input has a higher dimension than the other, then the input with lower",
            "dimension will be added to each element of the higher-dimension input.\n",
            "Examples:\n",
            "- scalar + tuple = resultTuple (where resultTuple is formed by adding scalar to each element in tuple).\n",
            "- tuple + arrayOfTuples = resultArrayOfTuples (where resultArrayOfTuples is formed by adding each",
            "  element in tuple with each corresponding element of each tuple in arrayOfTuples).\n",
            "- scalar + arrayOfTuples = resultArrayOfTuples (where resultArrayOfTuples is formed by adding scalar to",
            "  each element of every tuple in arrayOfTuples).\n",
            "To add/remove addends on this node, select the node and press the small \"+\"/\"-\" buttons in the",
            "bottom-right corner of the \"Inputs\" widget in the \"Property\" window."
        ],
        "uiName": "Add",
        "categories": ["math:operator"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "a": {
                "type": ["numerics"],
                "description": "First number or collection of numbers to add."
            },
            "b": {
                "type": ["numerics"],
                "description": "Second number or collection of numbers to add."
            }
        },
        "outputs": {
            "sum": {
                "type": ["numerics"],
                "description": "The element-wise sum of the input numerical values (with preserved typing)."
            }
        },
        "tests": [
            {
                "inputs:a": {"type": "double", "value": 10},
                "inputs:b": {"type": "double", "value": 6},
                "outputs:sum": {"type": "double", "value": 16}
            },
            {
                "inputs:a": {"type": "float", "value": 10},
                "inputs:b": {"type": "float", "value": 6},
                "outputs:sum": {"type": "float", "value": 16}
