{
    "ToDeg": {
        "version": 1,
        "description": [
            "Convert radian input into degrees"
        ],
        "uiName": "To Degrees",
        "categories": ["math:conversion"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "radians": {
                "type": ["decimals"],
                "description": "Angle value in radians to be converted",
                "uiName": "Radians"
            }
        },
        "outputs": {
            "degrees": {
                "type": ["decimals"],
                "description": "Angle value in degrees",
                "uiName": "Degrees"
            }
        },
        "tests" : [
            {
                "inputs:radians": {"type": "double", "value": -1.0},
                "outputs:degrees": {"type": "double", "value": -57.2958}
            },
            {
                "inputs:radians": {"type": "float", "value": -1.0},
                "outputs:degrees": {"type": "float", "value": -57.2958}
            },
            {
                "inputs:radians": {"type": "half", "value": -1.0},
                "outputs:degrees": {"type": "half", "value": -57.2813}
            },
            {
                "inputs:radians": {"type": "double[2]", "value": [-1.0, -1.0]},
                "outputs:degrees": {"type": "double[2]", "value": [-57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "double[3]", "value": [-1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "double[3]", "value": [-57.2958, -57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "double[4]", "value": [-1.0, -1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "double[4]", "value": [-57.2958, -57.2958, -57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "float[2]", "value": [-1.0, -1.0]},
                "outputs:degrees": {"type": "float[2]", "value": [-57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "float[3]", "value": [-1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "float[3]", "value": [-57.2958, -57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "float[4]", "value": [-1.0, -1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "float[4]", "value": [-57.2958, -57.2958, -57.2958, -57.2958]}
            },
            {
                "inputs:radians": {"type": "half[2]", "value": [-1.0, -1.0]},
                "outputs:degrees": {"type": "half[2]", "value": [-57.2813, -57.2813]}
            },
            {
                "inputs:radians": {"type": "half[3]", "value": [-1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "half[3]", "value": [-57.2813, -57.2813, -57.2813]}
            },
            {
                "inputs:radians": {"type": "half[4]", "value": [-1.0, -1.0, -1.0, -1.0]},
                "outputs:degrees": {"type": "half[4]", "value": [-57.2813, -57.2813, -57.2813, -57.2813]}
            },
            {
                "inputs:radians": {"type": "double[]", "value": [3.14159, 6.28319]},
                "outputs:degrees": {"type": "double[]", "value": [180.0, 360.0]}
            },
            {
                "inputs:radians": {"type": "float[]", "value": [3.14159, 6.28319]},
                "outputs:degrees": {"type": "float[]", "value": [180.0, 360.0]}
            },
            {
                "inputs:radians": {"type": "half[]", "value": [3.14, 6.28]},
                "outputs:degrees": {"type": "half[]", "value": [180.0, 360.0]}
            },
            {
                "inputs:radians": {"type": "double[2][]", "value": [[3.14159, 6.28319]]},
                "outputs:degrees": {"type": "double[2][]", "value": [[180.0, 360.0]]}
            },
            {
                "inputs:radians": {"type": "double[3][]", "value": [[3.14159, 6.28319, 3.14159]]},
                "outputs:degrees": {"type": "double[3][]", "value": [[180.0, 360.0, 180.0]]}
            },
            {
                "inputs:radians": {"type": "double[4][]", "value": [[3.14159, 6.28319, 3.14159, 6.28319]]},
                "outputs:degrees": {"type": "double[4][]", "value": [[180.0, 360.0, 180.0, 360.0]]}
            },
            {
                "inputs:radians": {"type": "float[2][]", "value": [[3.14159, 6.28319]]},
                "outputs:degrees": {"type": "float[2][]", "value": [[180.0, 360.0]]}
            },
            {
                "inputs:radians": {"type": "float[3][]", "value": [[3.14159, 6.28319, 3.14159]]},
                "outputs:degrees": {"type": "float[3][]", "value": [[180.0, 360.0, 180.0]]}
            },
            {
                "inputs:radians": {"type": "float[4][]", "value": [[3.14159, 6.28319, 3.14159, 6.28319]]},
                "outputs:degrees": {"type": "float[4][]", "value": [[180.0, 360.0, 180.0, 360.0]]}
            },
            {
                "inputs:radians": {"type": "half[2][]", "value": [[3.14, 6.28]]},
                "outputs:degrees": {"type": "half[2][]", "value": [[180.0, 360.0]]}
            },
            {
                "inputs:radians": {"type": "half[3][]", "value": [[3.14, 6.28, 3.14]]},
                "outputs:degrees": {"type": "half[3][]", "value": [[180.0, 360.0, 180.0]]}
            },
            {
                "inputs:radians": {"type": "half[4][]", "value": [[3.14, 6.28, 3.14, 6.28]]},
                "outputs:degrees": {"type": "half[4][]", "value": [[180.0, 360.0, 180.0, 360.0]]}
            }
        ]
    }
}
