{
    "Maximum": {
        "version": 1,
        "description": [
            "Computes the maximum of two or more inputs.",
            "If one input has a higher dimension than the others, then the input with lower dimension will be repeated",
            "to match the dimension of the higher dimension input (broadcasting).",
            "Examples: scalar * tuple -> tuple, tuple * array of tuples -> array of tuples,",
            "scalar * array of tuples -> array of tuples.",
            "To add/remove extra inputs on this node, select the node and press the small \"+\"/\"-\" buttons in the",
            "bottom-right corner of the \"Inputs\" widget in the \"Property\" window."
        ],
        "uiName": "Maximum",
        "categories": ["math:operator"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "a": {
                "type": ["numerics"],
                "description": "First value in the set of all inputs from which the maximum will be computed."
            },
            "b": {
                "type": ["numerics"],
                "description": "Second value in the set of all inputs from which the maximum will be computed."
            }
        },
        "outputs": {
            "maximum": {
                "type": ["numerics"],
                "description": [
                    "Maximum of all input values \"A\", \"B\", etc. This attribute's dimension will match the highest-",
                    "dimensioned input (e.g. if \"A\" is an array of tuples while \"B\" is a double, then the output",
                    "will also be an array of tuples)."
                ]
            }
        },
        "tests": [
            {
                "inputs:a": {"type": "double", "value": 1.0},
                "inputs:b": {"type": "double", "value": 2.0},
                "outputs:maximum": {"type": "double", "value": 2.0}
            },
            {
                "inputs:a": {"type": "float", "value": 1.0},
                "inputs:b": {"type": "float", "value": 2.0},
                "outputs:maximum": {"type": "float", "value": 2.0}
            },
