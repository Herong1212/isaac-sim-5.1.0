{
    "HasVariantSet": {
        "version": 2,
        "categories": [
            "graph:action",
            "sceneGraph",
            "variants"
        ],
        "icon": {
            "path": "Variant.svg"
        },
        "scheduling": [
            "usd-read"
        ],
        "description": "Query the existence of a variantSet on a prim",
        "uiName": "Has Variant Set",
        "inputs": {
            "prim": {
                "type": "target",
                "description": "The prim with the variantSet"
            },
            "variantSetName": {
                "type": "token",
                "description": "The variantSet name"
            }
        },
        "outputs": {
            "exists": {
                "type": "bool",
                "description": "Variant exists"
            }
        }
    }
}
