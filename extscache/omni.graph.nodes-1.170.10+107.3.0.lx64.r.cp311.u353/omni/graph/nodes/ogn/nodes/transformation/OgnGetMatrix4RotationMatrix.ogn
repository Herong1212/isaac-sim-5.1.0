{
    "GetMatrix4RotationMatrix": {
        "version": 1,
        "description": [
            "Gets the rotation matrix of the given matrix4d, rotation angles or quaternion value",
            "which represents a linear transformation. Returns the matrix3d rotation matrix."
        ],
        "uiName": "Get Rotation Matrix",
        "categories": ["math:operator"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "matrix" : {
                "type": ["vectord[3]", "vectord[3][]", "quatd[4]", "quatd[4][]", "matrixd[4]", "matrixd[4][]"],
                "uiName": "Input",
                "description": "The matrix, rotation angles or quaternion to extract the rotation from."
            },
            "rotationOrder" : {
                "type": "token",
                "uiName": "Rotation Order",
                "description": "The order the rotation should be applied when using rotation angles.",
                "default" : "XYZ",
                "metadata": {
                    "allowedTokens": ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX"]
                }
            }
        },
        "outputs": {
            "rotation": {
                "type": ["matrixd[3]", "matrixd[3][]"],
                "uiName": "Rotation",
                "description": "The matrix representing the rotation of the transformation."
             }
        },
        "tests" : [
            {
                "inputs:matrix": {"type":"matrixd[4]", "value":
                    [1,0,0,0, 0,0.70711,0.70711,0, 0,-0.70711,0.70711,0, 50,0,0,1]},
                "outputs:rotation": {"type":"matrixd[3]", "value":
                    [1,0,0, 0,0.70711,0.70711, 0,-0.70711,0.70711]}
            },
            {
                "inputs:matrix": {"type":"matrixd[4][]", "value": [
                    [1,0,0,0, 0,0.70711,0.70711,0, 0,-0.70711,0.70711,0, 50,0,0,1],
                    [1,0,0,0, 0,0.70711,0.70711,0, 0,-0.70711,0.70711,0, 100,0,0,1]]},
                "outputs:rotation": {"type":"matrixd[3][]", "value": [
                    [1,0,0, 0,0.70711,0.70711, 0,-0.70711,0.70711],
                    [1,0,0, 0,0.70711,0.70711, 0,-0.70711,0.70711]]}
            },
            {
                "inputs:matrix": {"type":"vectord[3]", "value": [45, 45, 0]},
                "outputs:rotation": {"type":"matrixd[3]", "value":
                    [0.70711,0,-0.70711, 0.5,0.70711,0.5, 0.5,-0.70711,0.5]}
            },
            {
                "inputs:matrix": {"type":"vectord[3][]", "value": [[45, 45, 0], [0, 45, 45]]},
                "outputs:rotation": {"type":"matrixd[3][]", "value": [
                    [0.70711,0,-0.70711, 0.5,0.70711,0.5, 0.5,-0.70711,0.5],
                    [0.5,0.5,-0.70711, -0.70711,0.70711,0, 0.5,0.5,0.70711]]}
            },
            {
                "inputs:matrix": {"type":"quatd[4]", "value": [0.38268481, 0, 0, 0.9238804]},
                "outputs:rotation": {"type":"matrixd[3]", "value":
                    [1,0,0, 0,0.70711,0.70711, 0,-0.70711,0.70711]}
            },
            {
                "inputs:matrix": {"type":"quatd[4][]", "value": [
                    [0.38268481, 0, 0, 0.9238804],
                    [-0.5, 0, 0, 0.70711]]},
                "outputs:rotation": {"type":"matrixd[3][]", "value": [
                    [1,0,0, 0,0.70711,0.70711, 0,-0.70711,0.70711],
                    [1,0,0, 0,0.5,-0.70711, 0,0.70711,0.5]]}
            }
        ]
    }
}
