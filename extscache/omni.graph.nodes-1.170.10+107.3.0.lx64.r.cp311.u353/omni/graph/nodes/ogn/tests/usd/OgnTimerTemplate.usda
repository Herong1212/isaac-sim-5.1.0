            docs="""Value of the start of the duration."""
        )

        # 3 attributes
        custom uint outputs:finished (
            docs="""When the node has finished the playback,
            signal to the graph that execution can continue downstream on this path."""
        )
        custom uint outputs:updated (
            docs="""When the node is executed, and output value(s) resampled and updated,
            signal to the graph that execution can continue downstream on this path."""
        )
        custom double outputs:value = 0.0 (
            docs="""Progress of the Timer node, between 0.0 and 1.0."""
