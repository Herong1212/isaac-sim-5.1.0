    def OmniGraphNode "Template_omni_graph_nodes_RotateToOrientation" (
        docs="""Perform a smooth rotation maneuver, rotating a prim to a desired orientation given a speed and easing factor"""
    )
    {
        token node:type = "omni.graph.nodes.RotateToOrientation"
