def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_GetRelativePath" (
        docs="""Generates a path token relative to anchor from path.(ex. (/World, /World/Cube) -> /Cube)"""
    )
    {
        token node:type = "omni.graph.nodes.GetRelativePath"
        int node:typeVersion = 1

        # 2 attributes
        custom token inputs:anchor = "" (
            docs="""Path token to compute relative to (ex. /World)"""
        )
        custom token inputs:path (
            docs="""Path token to convert to a relative path (ex. /World/Cube)"""
        )

        # 1 attribute
        custom token outputs:relativePath (
            docs="""Relative path token (ex. /Cube)"""
        )

        # 2 attributes
        custom token state:anchor (
            docs="""Snapshot of previously seen rootPath"""
        )
        custom token state:path (
            docs="""Snapshot of previously seen path"""
        )
    }
}
