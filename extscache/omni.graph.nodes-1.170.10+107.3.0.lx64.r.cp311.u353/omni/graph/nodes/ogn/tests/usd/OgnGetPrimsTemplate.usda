#usda 1.0
(
    doc ="""Generated from node description file OgnGetPrims.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_GetPrims" (
        docs="""Filters primitives in the input bundle by path and type."""
    )
    {
        token node:type = "omni.graph.nodes.GetPrims"
        int node:typeVersion = 2

        # 5 attributes
        custom rel inputs:bundle (
            docs="""The bundle to be read from"""
        )
        custom bool inputs:inverse = false (
            docs="""By default all primitives matching the path patterns and types are added to the output bundle;
            when this option is on, all mismatching primitives will be added instead."""
        )
        custom string inputs:pathPattern = "*" (
            docs="""A list of wildcard patterns used to match primitive path.

            Supported syntax of wildcard pattern:
                `*` - match an arbitrary number of any characters
                `?` - match any single character
                `^` - (caret) is used to define a pattern that is to be excluded

            Example of wildcard patterns, input: ['/Cube0', '/Cube1', '/Box']
                '*' - match any
                '* ^/Box' - match any, but exclude '/Box'
                '* ^/Cube*' - match any, but exclude '/Cube0' and '/Cube1'"""
        )
        custom rel inputs:prims (
            docs="""The prim to be extracted from Multiple Primitives in Bundle."""
        )
        custom string inputs:typePattern = "*" (
            docs="""A list of wildcard patterns used to match primitive type.

            Supported syntax of wildcard pattern:
                `*` - match an arbitrary number of any characters
                `?` - match any single character
                `^` - (caret) is used to define a pattern that is to be excluded

            Example of wildcard patterns, input: ['Mesh', 'Cone', 'Cube']
                '*' - match any
                '* ^Mesh' - match any, but exclude 'Mesh'
                '* ^Cone ^Cube' - match any, but exclude 'Cone' and 'Cube'"""
        )

        # 1 attribute
        custom rel outputs_bundle (
            docs="""The output bundle that contains filtered primitives"""
        )
    }
}
