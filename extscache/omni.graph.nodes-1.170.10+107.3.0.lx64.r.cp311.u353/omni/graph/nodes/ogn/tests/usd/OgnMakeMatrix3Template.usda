def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_MakeMatrix3" (
        docs="""Merge 3 row vectors into a matrix. If the inputs are arrays, the output will be an array of matrices."""
    )
    {
        token node:type = "omni.graph.nodes.MakeMatrix3"
        int node:typeVersion = 1

        # 3 attributes
        custom token inputs:x (
            docs="""The first row of the matrix"""
        )
        custom token inputs:y (
            docs="""The second row of the matrix"""
        )
        custom token inputs:z (
            docs="""The third row of the matrix"""
        )

        # 1 attribute
        custom token outputs:matrix (
            docs="""Matrix formed from the input row vectors"""
        )
    }
}
