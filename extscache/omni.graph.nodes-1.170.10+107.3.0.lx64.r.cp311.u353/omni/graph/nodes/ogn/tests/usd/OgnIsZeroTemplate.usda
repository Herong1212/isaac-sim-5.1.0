#usda 1.0
(
    doc ="""Generated from node description file OgnIsZero.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_IsZero" (
        docs="""Outputs a boolean indicating if all of the input values are zero within a specified tolerance."""
    )
    {
        token node:type = "omni.graph.nodes.IsZero"
        int node:typeVersion = 1

        # 2 attributes
        custom double inputs:tolerance = 0.0 (
            docs="""How close the value must be to 0 to be considered "zero"."""
        )
        custom token inputs:value (
            docs="""Value(s) to check for zero."""
        )

        # 1 attribute
        custom bool outputs:result (
            docs="""If 'value' is a scalar then 'result' will be true if 'value' is zero. If 'value' is non-scalar
            (array, tuple, matrix, etc) then 'result' will be true if all of its elements/components are zero."""
        )
    }
}
