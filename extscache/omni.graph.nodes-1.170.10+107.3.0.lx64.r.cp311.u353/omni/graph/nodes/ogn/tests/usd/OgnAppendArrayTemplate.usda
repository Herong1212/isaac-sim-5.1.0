#usda 1.0
(
    doc ="""Generated from node description file OgnAppendArray.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_AppendArray" (
        docs="""Combines the input arrays into a single new array in order of the inputs and the elements within each input array."""
    )
    {
        token node:type = "omni.graph.nodes.AppendArray"
        int node:typeVersion = 1

        # 2 attributes
        custom token inputs:input0 (
            docs="""The first of the two arrays to combine. The elements in this array will come before all of the
            second input array's elements in the final output array."""
        )
        custom token inputs:input1 (
            docs="""The second of the two arrays to combine. The elements in this array will come after all of the
            first input array's elements in the final output array."""
        )

        # 1 attribute
        custom token outputs:array (
            docs="""A new array containing all of the elements in the "Input0" array followed by
            all of the elements in the "Input1" array."""
        )
    }
}
