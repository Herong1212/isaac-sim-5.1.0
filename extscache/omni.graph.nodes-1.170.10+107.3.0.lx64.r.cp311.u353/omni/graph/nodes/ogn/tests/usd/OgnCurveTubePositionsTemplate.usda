#usda 1.0
(
    doc ="""Generated from node description file OgnCurveTubePositions.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_CurveTubePositions" (
        docs="""Take the points on a curve and a subset of vertex ranges and generate point geometry corresponding to a tube that follows the curve positions. Imagine a curve that is the center of a straw. The tube is constructed by inflating subsections of the curve."""
    )
    {
        token node:type = "omni.graph.nodes.CurveTubePositions"
        int node:typeVersion = 1

        # 8 attributes
        custom int[] inputs:cols = [] (
            docs="""Index along the curve where the tube is to be constructed."""
        )
        custom float3[] inputs:curvePoints = [] (
            docs="""Points on the curve from which the tubes are to be constructed."""
        )
        custom int[] inputs:curveVertexCounts = [] (
            docs="""Vertex counts for each curve frame.
            Must have the same number of elements as 'Curve Vertex Starts'."""
        )
        custom int[] inputs:curveVertexStarts = [] (
            docs="""Vertex index starting points for each curve frame.
            Must have the same number of elements as 'Curve Vertex Counts'."""
        )
        custom float3[] inputs:out = [] (
            docs="""Out vector directions on the constructed tube."""
        )
        custom int[] inputs:tubePointStarts = [] (
            docs="""Tube starting point index values. Must have the same number of elements as 'Columns'."""
        )
        custom float3[] inputs:up = [] (
            docs="""Up vectors on the constructed tube."""
        )
        custom float[] inputs:width = [] (
            docs="""Width of the constructed tube."""
        )

        # 1 attribute
        custom float3[] outputs:points (
            docs="""Points on the tube that was constructed."""
        )
    }
}
