        # 2 attributes
        custom string inputs:delimiter = " " (
            docs="""The delimiter string used to join the elements."""
        )
        custom token[] inputs:elements = [] (
            docs="""The string elements to join."""
        )

        # 1 attribute
        custom string outputs:string (
            docs="""The output string."""
        )
    }
}
