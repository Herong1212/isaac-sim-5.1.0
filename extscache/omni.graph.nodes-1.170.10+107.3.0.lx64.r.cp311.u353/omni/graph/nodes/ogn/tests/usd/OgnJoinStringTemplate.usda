def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_JoinString" (
        docs="""Creates a string from an input array and a delimiter."""
    )
    {
        token node:type = "omni.graph.nodes.JoinString"
