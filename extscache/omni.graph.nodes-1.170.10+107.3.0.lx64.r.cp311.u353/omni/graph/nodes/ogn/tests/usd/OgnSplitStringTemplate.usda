(
    doc ="""Generated from node description file OgnSplitString.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_SplitString" (
        docs="""Returns a list of elements from a string based on a delimiter."""
    )
    {
        token node:type = "omni.graph.nodes.SplitString"
        int node:typeVersion = 1

        # 2 attributes
        custom string inputs:delimiter = " " (
            docs="""The string to use as a delimiter to split the string."""
        )
        custom string inputs:string = "" (
            docs="""The input string."""
        )

        # 1 attribute
        custom token[] outputs:elements (
            docs="""The string elements."""
        )
    }
}
