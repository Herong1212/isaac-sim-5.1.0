#usda 1.0
(
    doc ="""Generated from node description file OgnExponent.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_Exponent" (
        docs="""Computes the base input raised to the power of the exponent. The result is the same type as the base input for floating point types. The result is double for integral values to allow for negative exponents. If the input is a vector or matrix, then the node calculates the exponent for each element and computes a vector or matrix of the same size."""
    )
    {
        token node:type = "omni.graph.nodes.Exponent"
        int node:typeVersion = 1

        # 2 attributes
        custom token inputs:base (
            docs="""Base value that will be raised to the power of exponent."""
        )
        custom int inputs:exponent = 2 (
            docs="""Power to raise the base value "Base" to. If "Base" consists of an array, vector, or matrix,
            then the exponent will be applied to each member of the aforementioned data structures."""
        )

        # 1 attribute
        custom token outputs:result (
            docs="""Result of "Base" raised to the value in "Exponent"."""
        )
    }
}
