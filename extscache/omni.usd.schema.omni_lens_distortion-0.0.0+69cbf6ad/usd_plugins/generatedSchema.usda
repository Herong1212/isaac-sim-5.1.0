class "OmniLensDistortionLutAPI" (
    doc = """Defines lens distortion by a pre-generated lookup table, allowing any model to be mapped to the RTX camera
    by generating two lookup tables, one for the ray entering, one for the ray leaving, which are used by the renderer to transform rays entering or leaving
    the lens system.
    
    Use the example script provided to see how to convert a custom lens model to the table format.
    """
)
{
    float omni:lensdistortion:lut:nominalHeight = 1216 (
        displayName = "Nominal height"
        doc = "Height of the calibrated sensor"
    )
    float omni:lensdistortion:lut:nominalWidth = 1936 (
        displayName = "Nominal width"
        doc = "Width of the calibrated sensor"
    )
    float2 omni:lensdistortion:lut:opticalCenter = (970.94244, 600.3748) (
        displayName = "Optical center"
        doc = ""
    )
    asset omni:lensdistortion:lut:rayEnterDirectionTexture = @@ (
        doc = """Lookup table stored as an RGB image file where each RGB pixel value is the XYZ direction of rays entering 
        the lens system in local camera space."""
    )
    asset omni:lensdistortion:lut:rayExitPositionTexture = @@ (
        doc = """Lookup table stored as an RGB image file where each RG pixel value is the [0, 1] U,V coordinate in normalized 
        screen space where the ray for that pixel is emitted from on the image plane."""
    )
    token omni:lensdistortion:model = "lut" (
        allowedTokens = ["lut"]
    )
}

