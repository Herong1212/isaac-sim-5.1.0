def Xform "World"
{
    reorder nameChildren = ["PushGraph_All", "PushGraph_Enum", "PushGraph_List", "PushGraph_Enum_Mixed", "PushGraph_List_Mixed"]
    def OmniGraph "PushGraph_All"
    {
        reorder nameChildren = ["to_string_list", "to_string_list_match", "to_string_list_mixed", "to_string_enum", "to_string_enum_match", "to_string_enum_mixed"]
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 8)
        custom token[] graph:variable:TokenArray = ["A", "B", "C", "D"] (
            customData = {
                token scope = "private"
            }
            displayName = "TokenArray"
        )
        custom token[] graph:variable:TokenArray_Enum = ["A", "B", "C", "D"] (
            allowedTokens = ["A", "B", "C", "D", "E", "F"]
            customData = {
                token scope = "private"
            }
            displayName = "TokenArray_Enum"
        )
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "to_string_list" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:value = "[A, B, C]" (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            token[] attrValue = ["A", "B", "C"]
                            string resolvedType = "token[]"
                        }
                    }
                }
            )
            token node:type = "omni.graph.nodes.ToString"
            int node:typeVersion = 1
            custom string outputs:converted
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (443.85782, -255.79185)
        }

        def OmniGraphNode "to_string_list_mixed" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:value = "[A, B, C, D]" (
                customData = {
