                            token[] attrValue = ["A", "B", "C", "D"]
                            string resolvedType = "token[]"
                        }
                    }
                }
            )
            token node:type = "omni.graph.nodes.ToString"
            int node:typeVersion = 1
            custom string outputs:converted
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (451.09894, 228.59154)
        }

        def OmniGraphNode "to_string_enum" (
