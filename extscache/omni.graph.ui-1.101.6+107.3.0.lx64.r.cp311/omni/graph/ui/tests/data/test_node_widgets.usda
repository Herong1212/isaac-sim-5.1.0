def Xform "World"
{
    def OmniGraph "PushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 8)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "constant_quatd" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom quatd inputs:value
            token node:type = "omni.graph.nodes.ConstantQuatd"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (110.000084, 83.333336)
        }

        def OmniGraphNode "constant_quatf" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom quatf inputs:value
            token node:type = "omni.graph.nodes.ConstantQuatf"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (115.33333, 177.33328)
        }

        def OmniGraphNode "constant_quath" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom quath inputs:value
            token node:type = "omni.graph.nodes.ConstantQuath"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (118.66675, 277.3333)
        }

        def OmniGraphNode "constant_matrix2d" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom matrix2d inputs:value
            token node:type = "omni.graph.nodes.ConstantMatrix2d"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (121.15432, 405.8925)
        }

        def OmniGraphNode "constant_matrix3d" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom matrix3d inputs:value
            token node:type = "omni.graph.nodes.ConstantMatrix3d"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (126.487755, 499.2259)
        }

        def OmniGraphNode "constant_matrix4d" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom matrix4d inputs:value
            token node:type = "omni.graph.nodes.ConstantMatrix4d"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (133.82109, 597.89246)
        }

        def OmniGraphNode "constant_frame" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom frame4d inputs:value
            token node:type = "omni.graph.nodes.ConstantFrame"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (131.69423, 697.1421)
        }
    }
}

def Xform "Environment"
{
    double3 xformOp:rotateXYZ = (0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:intensity = 3000
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

