mdl 1.7;


import ::anno::*;
import ::math::*;
import ::tex::*;
import ::state::*;
import ::df::diffuse_edf;
import ::nvidia::support_definitions::texture_coordinate_2d;
import ::scene::*;
import ::OmniSurface::OmniImage::*;
import ::debug::*;

// Borrowed function to convert from sRGB to linear colors
// This should be in a library
float srgb_to_linear( float v ) uniform {
    if (v <= 0.04045)
        return v / 12.92;
    else
        return math::pow((v + 0.055) / 1.055, 2.4);
}

// Override that converts the R/G/B elements from sRGB to linear
color srgb_to_linear( float r, float g, float b ) uniform {
    return color( srgb_to_linear(r), srgb_to_linear(g), srgb_to_linear(b) );
}

// Override that converts a whole color struct from sRGB to linear
color srgb_to_linear( color c ) uniform {
    float3 vals = float3(c);
    return srgb_to_linear(vals.x, vals.y, vals.z);
}

// OM-44796: scale emission such that its value is the same as the exposed pixel value with our default camera exposure settings.
// ToDo: this should be a library function as it's used in multiple shaders
color emissiveColorToNits
(
    color c_In
)
{
    // Match HdStrom: scale by inverse of rendering camera exposure * PI (nits)
    uniform float cameraExposureInv = 1133.6f;
    return c_In * math::PI * cameraExposureInv;
}
color emissiveTextureColorToNits
(
    color c_In
)
{
    // Match HdStrom: scale by inverse of rendering camera exposure * PI (nits)
    uniform float cameraExposureInv = 1133.6f;
    return srgb_to_linear(c_In) * math::PI * cameraExposureInv;
}


export material OmniUIScene(
    uniform texture_2d sceneui_image = texture_2d() [[
        anno::display_name("Emissive Color Map"),
        anno::in_group("Emissive"),
        anno::description("The emissive color texture. Alpha is used as cutout if applicable.")
    ]],
    float emission_intensity = 1.f [[
        anno::display_name("Emission Intensity"),
        anno::in_group("Emissive"),
        anno::description("Emission Intensity Scale")
    ]]

) = let {
    bool use_texture = tex::texture_isvalid(sceneui_image);
    color color_mult = scene::data_lookup_color("displayColor", color(1.0));
    float alpha_mult = scene::data_lookup_float("displayOpacity", 1.0f);


    // look up input emissive color map
    float4 emissive_texture_result = use_texture ?
        tex::lookup_float4(
            tex: sceneui_image,
            coord: nvidia::support_definitions::texture_coordinate_2d(0),
            wrap_u: tex::wrap_clamp,
            wrap_v: tex::wrap_clamp,
            crop_u: float2(0.0, 1.0),
            crop_v: float2(0.0, 1.0),
            frame: 0.0
        ) :
        float4(1.0, 1.0, 1.0, 1.0);

    color emissive_color_result = color(
        emissive_texture_result.x,
        emissive_texture_result.y,
        emissive_texture_result.z);

    float emissive_alpha = use_texture ? emissive_texture_result.w : 1.f;
    // Weird hack, anything acquired from a primvar needs to be used in `material_surface` definition:
    // `+ alpha_mult - alpha_mult` - This cancels out and does not impact the color
    // But is necessary for the valeus to get captured properly in the final material.
    color emissiveAsNits = emissiveTextureColorToNits(emissive_color_result) * color_mult + alpha_mult - alpha_mult;

    // construct shader
    material_surface main(
        scattering: bsdf(),
        emission: material_emission(
            emission: df::diffuse_edf(""),
            intensity: emissiveAsNits * emission_intensity,
            mode: intensity_radiant_exitance
        )
    );
    material_geometry geometry(
        displacement: float3(0.f),
        cutout_opacity: emissive_alpha * alpha_mult,
        // normal: state::normal()
        normal: float3(0.f)
    );

}
in material(
    thin_walled: true,
    surface: main,
    backface: main,
    geometry: geometry
);

export material OmniUISceneOutline(
    float emission_intensity = 1.f [[
        anno::display_name("Emission Intensity"),
        anno::in_group("Emissive"),
        anno::description("Emission Intensity Scale")
    ]],
    color emissive_color = color(1.f) [[
		anno::display_name("Emissive Color"),
		anno::in_group("Emissive"),
		anno::description("The emissive color. This parameter is ignored if Emissive Color Map is used.")
	]],
        float geometry_opacity = float(1.0) [[
        anno::display_name("Opacity"),
        anno::in_group("Geometry"),
        anno::hard_range(0.0f, 1.0f)
    ]]
) = let {
    color display_color = scene::data_lookup_color("displayColor", emissive_color);
    float display_opacity = scene::data_lookup_float("displayOpacity", geometry_opacity);

    // Weird hack, anything acquired from a primvar needs to be used in `material_surface` definition:
    // `+ display_opacity - display_opacity` - This cancels out and does not impact the color
    // But is necessary for the valeus to get captured properly in the final material.
    color emissiveAsNits = emissiveColorToNits(display_color) + display_opacity - display_opacity;

    material_surface main(
        scattering: bsdf(),
        emission: material_emission(
            emission: df::diffuse_edf(""),
            intensity: emissiveAsNits * emission_intensity,
            mode: intensity_radiant_exitance
        )
    );
    material_geometry geometry(
        displacement: float3(0.f),
        cutout_opacity: display_opacity,
        // normal: state::normal()
        normal: float3(0.f)
    );

}
in material(
    thin_walled: true,
    surface: main,
    backface: main,
    geometry: geometry
);
