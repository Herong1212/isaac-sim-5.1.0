{
    "omni.graph.action.OnClosing": {
        "version": 2,
        "description": [
            "Activates an output signal when the USD stage is about to be closed.\n",
            "Note that only simple necessary actions should be taken during closing since the",
            "application is in the process of cleaning up the existing state and some",
            "systems may be in a transitional state."
        ],
        "uiName": "On Closing",
        "categories": ["graph:action", "event"],
        "scheduling": ["compute-on-request", "threadsafe"],
        "inputs": {
        },
        "outputs": {
            "execOut": {
                "type": "execution",
                "uiName": "Closing",
                "description": [
                    "After the file close event was received signal to the graph that execution",
                    "should continue downstream."
                ]
            }
        }
    }
}
