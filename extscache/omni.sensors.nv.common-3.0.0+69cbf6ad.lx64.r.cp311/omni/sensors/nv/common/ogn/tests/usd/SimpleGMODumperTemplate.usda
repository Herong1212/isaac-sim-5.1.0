#usda 1.0
(
    doc ="""Generated from node description file SimpleGMODumper.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_sensors_nv_common_SimpleGMODumper" (
        docs="""Dumps GMO buffer to bin file"""
    )
    {
        token node:type = "omni.sensors.nv.common.SimpleGMODumper"
        int node:typeVersion = 1

        # 7 attributes
        custom uint64 inputs:cudaStream = 0 (
            docs="""Cuda Stream Input"""
        )
        custom bool inputs:dumpPackets = false (
            docs="""Dump packets as dwBinFile"""
        )
        custom string inputs:fileName = "lidar.h5" (
            docs="""File name of the packets"""
        )
        custom bool inputs:isRadar = false (
            docs="""True for radar sensor"""
        )
        custom double inputs:simTime = 0 (
            docs="""Simulation time given from PostProcessEntryNode"""
        )
        custom uint64 inputs:src = 0 (
            docs="""RtSensor buffer id"""
        )
        custom uint64 inputs:srcMeta = 0 (
            docs="""Lidar Meta Data"""
        )
    }
}
