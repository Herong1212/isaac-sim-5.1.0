#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World" (
    variants = {
        string shadingVariant = "red"
    }
    prepend variantSets = "shadingVariant"
)
{
    def Sphere "Sphere"
    {
        color3f[] primvars:displayColor
    }

    variantSet "shadingVariant" = {
        "blue" {
            over "Sphere"
            {
                color3f[] primvars:displayColor = [(0, 0, 1)]
            }
        }

        "red" {
            over "Sphere"
            {
                color3f[] primvars:displayColor = [(1, 0, 0)]
            }
        }
    }
}
