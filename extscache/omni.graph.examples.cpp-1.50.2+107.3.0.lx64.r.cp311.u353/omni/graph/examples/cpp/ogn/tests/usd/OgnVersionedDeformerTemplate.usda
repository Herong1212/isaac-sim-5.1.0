#usda 1.0
(
    doc ="""Generated from node description file OgnVersionedDeformer.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_examples_cpp_VersionedDeformer" (
        docs="""Test node to confirm version upgrading works. Performs a basic deformation on some points."""
    )
    {
        token node:type = "omni.graph.examples.cpp.VersionedDeformer"
        int node:typeVersion = 2

        # 2 attributes
        custom point3f[] inputs:points = [] (
            docs="""Set of points to be deformed"""
        )
        custom float inputs:wavelength = 50.0 (
            docs="""Wavelength of sinusoidal deformer function"""
        )

        # 1 attribute
        custom point3f[] outputs:points (
            docs="""Set of deformed points"""
        )
    }
}
