#usda 1.0
(
    doc ="""Generated from node description file OgnScaleCube.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_examples_cpp_ScaleCube" (
        docs="""Example node that performs a simple multiplication"""
    )
    {
        token node:type = "omni.graph.examples.cpp.ScaleCube"
        int node:typeVersion = 1

        # 2 attributes
        custom float inputs:multiplier = 0.0 (
            docs="""2nd multiplicand"""
        )
        custom float inputs:value = 0.0 (
            docs="""1st multiplicand"""
        )

        # 1 attribute
        custom double outputs:value (
            docs="""Product of value and multiplier"""
        )
    }
}
