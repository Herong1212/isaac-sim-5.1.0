#usda 1.0
(
    doc ="""Generated from node description file OgnSpecializedBundleProducer.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_examples_cpp_SpecializedBundleProducer" (
        docs="""Minimal compute node example that produces specialized bundle"""
    )
    {
        token node:type = "omni.graph.examples.cpp.SpecializedBundleProducer"
        int node:typeVersion = 1

        # 2 attributes
        custom float inputs:diameter = 0.0 (
            docs="""Diameter of produced specialized bundle"""
        )
        custom token inputs:productType = "Circle" (
            docs="""Product type produced by this node"""
        )

        # 1 attribute
        custom rel outputs_bundle (
            docs="""Produced output"""
        )
    }
}
