mdl 1.8;

import ::state::*;
import ::tex::*;

export color test_texture2D
(
    uniform texture_2d param = texture_2d("./resources/one.png", ::tex::gamma_linear, "channelSelection")
)
{
    float3 tex_coord3 = state::texture_coordinate(0);
    return tex::lookup_color(param, float2(tex_coord3.x, tex_coord3.y));
}

export color test_texture3D
(
    uniform texture_3d param = texture_3d("./resources/one.vdb", ::tex::gamma_linear, "dataSetSelection")
)
{
    return tex::lookup_color(param, state::texture_coordinate(0));
}

export color test_textureCube
(
    uniform texture_cube param =  texture_cube("./resources/one.hdr", ::tex::gamma_linear)
)
{
    return tex::lookup_color(param, state::texture_coordinate(0));
}

export color test_texturePtex
(
    uniform texture_ptex param = texture_ptex("./resources/one.ptx", ::tex::gamma_linear)
)
{
    return tex::lookup_color(param);
}