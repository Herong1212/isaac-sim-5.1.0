#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"

    """
    This asset includes meshes that are outside of SkelRoot and not bound to any skeleton.
    """
)

def Xform "World" ()
{
    def "Root" (
        prepend references = @./baseSkeleton.usda@
    )
    {
        def Mesh "MeshWithoutSkeletonBinding" (
            prepend apiSchemas = ["SkelBindingAPI"]
        )
        {
        }

        def Mesh "MeshWithoutBindingAPI" {}
    }

    def Skeleton "SkeletonOutOfSkelRoot"
    {

    }

    def Mesh "MeshOutOfSkelRoot"
    {

    }
}
