#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"

    """
    This asset demonstrates a character that its skeleton is from another USD.
    """
)

def Xform "World" (
    prepend apiSchemas = ["SkelBindingAPI"]
) 
{
    def SkelRoot "Root" (prepend apiSchemas = ["SkelBindingAPI"])
    {
        def Skeleton "Skeleton" (
            prepend payload = @./baseSkeleton.usda@</Root/Skeleton>
        )
        {
        }

        def Mesh "torso" (prepend apiSchemas = ["SkelBindingAPI"])
        {
            prepend rel skel:skeleton = </World/Root/Skeleton>
        }
    }
}