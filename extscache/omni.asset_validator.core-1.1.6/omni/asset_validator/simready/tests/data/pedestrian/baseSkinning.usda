def Scope "Root"
{
    def Scope "Geometry"
    {
        def "torso" (references = </sources/torso>)
        {
            token[] xformOpOrder = ["xformOp:translate"]
            double3 xformOp:translate = (0, 0, 0.4)
        }

        def "neck" (references = </sources/neck>)
        {
            token[] xformOpOrder = ["xformOp:translate"]
            double3 xformOp:translate = (0, 0, 0.9)
