                            (-0.06, -0.05, 0.14), (-0.06, 0.05, 0.14), (0.06, 0.05, 0.14), (0.06, -0.05, 0.14)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2,
