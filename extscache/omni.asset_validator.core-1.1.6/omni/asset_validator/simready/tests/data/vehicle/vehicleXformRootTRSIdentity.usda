#usda 1.0
(
    defaultPrim = "vehicle"
    upAxis = "Z"
    metersPerUnit = 1
    subLayers = [
        @./vehicle.usda@
    ]

    """
    This USD presents a simready vehicle has TRS transformation as identity values on the default prim.
    """
)

over "vehicle" (
)
{
    # This transform operation includes identity values for TRS
    double3 xformOp:translate = (0, 0, 0)
    float3 xformOp:rotateXYZ = (0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)

    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}