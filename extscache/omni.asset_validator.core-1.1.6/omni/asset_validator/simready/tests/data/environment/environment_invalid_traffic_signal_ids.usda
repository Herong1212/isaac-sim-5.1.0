#usda 1.0
(
    """
    Invalid environment: invalid or duplicate traffic signal IDs.
    """
    defaultPrim = "RootNode"
)

def Xform "RootNode"
{
    custom uniform asset omni:simready:openDrive = @./road.xodr@

    def Xform "traffic_signal_invalid_id"
    {
        custom int64 omni:simready:signalID = -1
    }

    def Xform "traffic_signal_3050"
    {
        custom int64 omni:simready:signalID = 3050
    }

    def Xform "traffic_signal_3050_duplicate_id"
    {
        custom int64 omni:simready:signalID = 3050
    }

    def Xform "traffic_signal_no_id"
    {
        custom int64 omni:simready:signalID
    }

    def Xform "traffic_signal_wrong_type"
    {
        custom float omni:simready:signalID = 3050.0
    }

    def Xform "traffic_signal_time_varying"
    {
        int64 omni:simready:signalID = 1
        int64 omni:simready:signalID.timeSamples = {101: 2, 102: 3}
    }

    def Xform "traffic_signal_not_in_xodr"
    {
        custom int64 omni:simready:signalID = 9999
    }
}