#usda 1.0
(
    """
    SimReady Traffic Light asset: signalOrder attribute has incorrect type
    """
    defaultPrim = "RootNode"
)

def Xform "RootNode"
{
    custom token omni:simready:signalType = "trafficLight"
    custom string[] omni:simready:signalOrder = ["red", "amber", "green"]
    def DiskLight "signal_green"
    {
        custom token omni:simready:signal = "green"
    }
}
