#usda 1.0
(
    """
    SimReady Traffic Light asset: signalType attribute has incorrect value
    """
    defaultPrim = "RootNode"
)

def Xform "RootNode"
{
    custom string omni:simready:signalType = "incorrect value"
    custom token[] omni:simready:signalOrder = ["green"]

    def DiskLight "signal_green"
    {
        custom token omni:simready:signal = "green"
    }
}
