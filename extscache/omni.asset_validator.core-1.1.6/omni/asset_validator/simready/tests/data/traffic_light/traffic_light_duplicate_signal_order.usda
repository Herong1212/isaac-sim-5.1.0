#usda 1.0
(
    """
    SimReady Traffic Light asset: omni:simready:signalOrder has duplicate value
    """
    defaultPrim = "RootNode"
)

def Xform "RootNode"
{
    custom token omni:simready:signalType = "trafficLight"
    custom token[] omni:simready:signalOrder = ["amber", "green", "amber"]
    def DiskLight "signal_green"
    {
        custom token omni:simready:signal = "green"
    }

}
