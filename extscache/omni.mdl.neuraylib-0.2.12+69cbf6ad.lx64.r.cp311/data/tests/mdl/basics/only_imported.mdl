mdl 1.6;

import ::df::*;
import ::tex::*;
import ::math::*;
import ::state::*;
import ::anno::*;


export color get_cornflower_blue()
{
    return color(0.25, 0.5, 0.75);
}

export color get_cornflower_blue_param(color c = color(0.25, 0.5, 0.75))
{
    return c;
}
