def Xform "World"
{
    def Scope "Looks"
    {
        def Material "ColorArrayMaterialDefault"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/ColorArrayMaterialDefault/MainColorArray.outputs:out>
            token outputs:mdl:volume

            def Shader "MainColorArray" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./array_examples.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "MainColorArray"
                int inputs:index = 0
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "ColorArrayMaterialOverride"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/ColorArrayMaterialOverride/MainColorArray.outputs:out>
            token outputs:mdl:volume

            def Shader "MainColorArray" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./array_examples.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "MainColorArray"
                color3f[] inputs:data = [(0.1, 0.3, 0.1), (0.1, 0.5, 0.1), (0.1, 0.8, 0.1)]
                int inputs:index = 1
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "ColorArrayMaterialGraph"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/ColorArrayMaterialGraph/MainColorArray.outputs:out>
            token outputs:mdl:volume
            uniform token ui:nodegraph:node:expansionState = "open"

            def Shader "MainColorArray" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./array_examples.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "MainColorArray"
                color3f[] inputs:data.connect = </World/Looks/ColorArrayMaterialGraph/GetColorArrayThree.outputs:out>
                int inputs:index = 1
                token outputs:out (
                    renderType = "material"
                )
                uniform token ui:nodegraph:node:expansionState = "open"
            }

            def Shader "GetColorArrayThree" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./array_examples.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "GetColorArrayThree"
                color3f[] outputs:out
                uniform token ui:nodegraph:node:expansionState = "open"
            }
        }

        def Material "ColorArrayMaterialDefaultGraph"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/ColorArrayMaterialDefaultGraph/MainColorArray.outputs:out>
            token outputs:mdl:volume
            uniform token ui:nodegraph:node:expansionState = "open"

            def Shader "MainColorArray" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./array_examples.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "MainColorArrayDefaultGraph"
                int inputs:index = 2
                token outputs:out
                uniform token ui:nodegraph:node:expansionState = "open"
            }
        }
    }

    def Mesh "Mesh_ColorArrayMaterialDefault" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
