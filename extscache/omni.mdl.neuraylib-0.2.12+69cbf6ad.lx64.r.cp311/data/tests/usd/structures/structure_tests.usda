                uniform token info:mdl:sourceAsset:subIdentifier = "checker_texture(color,color,float3,float3,bool,float,float3,int)"
                float inputs:blur (
                    customData = {
                        float default = 0
                        dictionary range = {
                            float max = 1
                            float min = 0
                        }
                    }
                    displayGroup = "Checker parameters"
                    displayName = "Blur"
                    hidden = false
                    renderType = "float"
