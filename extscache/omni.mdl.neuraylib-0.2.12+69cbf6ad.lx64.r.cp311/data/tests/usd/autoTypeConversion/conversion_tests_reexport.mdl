mdl 1.7;

import ::anno::*;
import ::base::*;
import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;
import ::scene::*;
import ::limits::*;

export using .::conversion_tests import color_mode;
export using .::conversion_tests import lookup_value;

// returns a re-exported enum
// since they are basically the same types with different names, connections need to work without intermediate nodes
export color_mode get_color_mode_blue()
{
    return blue;
}

// ... same with re-exported structs
export lookup_value get_lookup_value_yellow()
{
    return lookup_value(valid: true, value: color(1.0, 1.0, 0.0));
}

// not used
export material main() = material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf()
    )
);
