def Xform "World"
{
    def Scope "Looks"
    {
        def Material "float4_to_color"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/float4_to_color/diffuse.outputs:out>
            token outputs:mdl:volume

            def Shader "diffuse" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/core_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "diffuse(color,float,float3)"
                color3f inputs:diffuse_color.connect = </World/Looks/float4_to_color/float4_const.outputs:out>
                token outputs:out
            }

            def Shader "float4_const" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "float4_const(float4)"
                float4 inputs:f4 = (0, 1, 0, 1)
                float4 outputs:out
            }
        }

        def Material "bultin_enums"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/bultin_enums/diffuse.outputs:out>
            token outputs:mdl:volume
            uniform token ui:nodegraph:node:expansionState = "open"

            def Shader "diffuse" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./conversion_tests.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "main_builtin_enums"
                int inputs:intensity_test (
                    customData = {
                        int default = 0
                    }
                    hidden = false
                    renderType = "intensity_mode"
                    sdrMetadata = {
                        string __SDR__enum_value = "intensity_radiant_exitance"
                        string options = "intensity_radiant_exitance:0|intensity_power:1"
                    }
                )
                int inputs:intensity_test.connect = </World/Looks/bultin_enums/wrap.outputs:out>
                int inputs:wrap_test (
                    customData = {
                        int default = 1
                    }
                    hidden = false
                    renderType = "wrap_mode"
                    sdrMetadata = {
                        string __SDR__enum_value = "wrap_repeat"
                        string options = "wrap_clamp:0|wrap_repeat:1|wrap_mirrored_repeat:2|wrap_clip:3"
                    }
                )
                int inputs:wrap_test.connect = </World/Looks/bultin_enums/intensity.outputs:out>
                token outputs:out
                uniform token ui:nodegraph:node:expansionState = "open"
            }

            def Shader "wrap" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./conversion_tests.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "get_wrap_clip"
                int outputs:out
                uniform token ui:nodegraph:node:expansionState = "open"
            }

            def Shader "intensity" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./conversion_tests.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "get_intensity_power"
                int outputs:out
                uniform token ui:nodegraph:node:expansionState = "open"
            }
        }

        def Material "fixed_arrays"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/fixed_arrays/diffuse.outputs:out>
            token outputs:mdl:volume

            def Shader "diffuse" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @./conversion_tests.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "main_lookup_value_array"
                token[] inputs:data.connect = </World/Looks/fixed_arrays/float4_const.outputs:out>
                token outputs:out
            }

            def Shader "float4_const" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "float4_const(float4)"
                float4 inputs:f4 = (0, 1, 0, 1)
                float4 outputs:out
            }
        }

        def Material "dynamic_arrays"
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/dynamic_arrays/diffuse.outputs:out>
