mdl 1.6;

import ::df::*;
import ::tex::*;
import ::math::*;
import ::state::*;
import ::anno::*;

// just a material to use for geometry without test cases
export material main()
= material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: color(0.25, 0.5, 0.75)
        )
    )
);
