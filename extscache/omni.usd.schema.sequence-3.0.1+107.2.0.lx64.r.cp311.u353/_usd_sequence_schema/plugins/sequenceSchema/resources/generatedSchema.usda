class "AssetClipBase" (
    doc = 'Base class of asset clips. An asset clip grabs time samples from "animation" prim and applies these time samples to "assetPrim". If "assetPrim" is Skeleton and "animation" is SkelAnimation, AssetClip sets "animation" to "skel:animationSource" relationship of "assetPrim".'
)
{
    rel animation (
        doc = "The prim from which the AssetClip grabs time samples. If it's empty, AssetClip grabs time samples from the \"assetPrim\". "
    )
    rel assetPrim (
        doc = "The prim to which the AssetClip applies animation."
    )
    uniform timecode endTime = 0 (
        doc = "Time when the clip stops."
    )
    uniform bool loop = 0 (
        doc = "Indicates whether animation loop."
    )
    uniform timecode playEnd = nan (
        doc = "End time of the range in animation that is used by clip."
    )
    uniform timecode playOffset = nan (
        doc = "The time of animation when the clip starts to play. It should be between playStart and playEnd."
