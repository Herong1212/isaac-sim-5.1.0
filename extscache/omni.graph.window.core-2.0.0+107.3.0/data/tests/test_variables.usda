            float3 "rtx:raytracing:inscattering:singleScatteringAlbedo" = (0.9, 0.9, 0.9)
            float3 "rtx:raytracing:inscattering:transmittanceColor" = (0.5, 0.5, 0.5)
            float3 "rtx:sceneDb:ambientLightColor" = (0.1, 0.1, 0.1)
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
)

def Xform "World"
{
    def OmniGraph "PushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 8)
        custom bool graph:variable:NewVariable (
            customData = {
                token scope = "private"
            }
            displayName = "NewVariable"
        )
        custom int graph:variable:NewVariable01 (
            customData = {
                token scope = "private"
            }
            displayName = "NewVariable01"
        )
        custom string graph:variable:test0 (
            customData = {
                token scope = "private"
            }
            displayName = "test0"
        )
        custom float graph:variable:test1 (
            customData = {
                token scope = "private"
            }
            displayName = "test1"
        )
        custom float graph:variable:test101 (
            customData = {
                token scope = "private"
            }
            displayName = "test101"
        )
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "constant_bool" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom bool inputs:value
            token node:type = "omni.graph.nodes.ConstantBool"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "write_variable" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:value (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            float attrValue = 0
                            string resolvedType = "float"
                        }
                    }
                }
            )
            custom token inputs:variableName = "test1"
            token node:type = "omni.graph.core.WriteVariable"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "read_variable_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:variableName = "test0"
            token node:type = "omni.graph.core.ReadVariable"
            int node:typeVersion = 2
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "read_variable_02" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:variableName = "test0"
            token node:type = "omni.graph.core.ReadVariable"
            int node:typeVersion = 2
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "write_variable_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:value (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string resolvedType = "string"
                        }
                    }
                }
            )
            custom token inputs:variableName = "test0"
            token node:type = "omni.graph.core.WriteVariable"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "read_variable_03" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:variableName = "test0"
            token node:type = "omni.graph.core.ReadVariable"
            int node:typeVersion = 2
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "write_variable_02" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn
            custom rel inputs:graph = </World/PushGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom token inputs:targetPath
            custom token inputs:value (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string resolvedType = "string"
                        }
                    }
                }
            )
            custom token inputs:variableName = "test0"
            token node:type = "omni.graph.core.WriteVariable"
            int node:typeVersion = 2
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom token outputs:value
            uniform token ui:nodegraph:node:expansionState = "open"
        }

        def OmniGraphNode "compound" (
            prepend apiSchemas = ["OmniGraphCompoundNodeAPI", "NodeGraphNodeAPI"]
        )
        {
            token node:type = "omni.graph.nodes.CompoundSubgraph"
            int node:typeVersion = 1
            rel omni:graph:compoundGraph = </World/PushGraph/compound/Subgraph>
            token omni:graph:compoundType = "subgraph"
            custom token outputs:value (
                customData = {
                    string ExtendedAttributeType = "Any"
                    dictionary omni = {
                        dictionary graph = {
                            string attrType = "Any"
                        }
                    }
                }
            )
            prepend token outputs:value.connect = </World/PushGraph/compound/Subgraph/read_variable.outputs:value>

            def OmniGraph "Subgraph" (
                no_delete = true
            )
            {
                token evaluationMode = "Automatic"
                int2 fileFormatVersion = (1, 8)
                uniform float2 ui:nodegraph:input:pos = (-326.4326, -161.14273)

                def OmniGraphNode "read_variable" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    custom rel inputs:graph = </World/PushGraph> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                    custom token inputs:targetPath
                    custom token inputs:variableName = "test1"
                    token node:type = "omni.graph.core.ReadVariable"
                    int node:typeVersion = 2
                    custom token outputs:value
                    uniform token ui:nodegraph:node:expansionState = "open"
                    uniform float2 ui:nodegraph:node:pos = (73.567406, -161.14273)
                }

                def OmniGraphNode "compound" (
                    prepend apiSchemas = ["OmniGraphCompoundNodeAPI", "NodeGraphNodeAPI"]
                )
                {
                    token node:type = "omni.graph.nodes.CompoundSubgraph"
                    int node:typeVersion = 1
                    rel omni:graph:compoundGraph = </World/PushGraph/compound/Subgraph/compound/Subgraph>
                    token omni:graph:compoundType = "subgraph"
                    uniform token ui:nodegraph:node:expansionState = "open"
                    uniform float2 ui:nodegraph:node:pos = (0, 0)

                    def OmniGraph "Subgraph" (
                        no_delete = true
                    )
                    {
                        token evaluationMode = "Automatic"
                        int2 fileFormatVersion = (1, 8)
                        uniform float2 ui:nodegraph:input:pos = (-600, 0)
                        uniform float2 ui:nodegraph:output:pos = (600, 0)

                        def OmniGraphNode "write_variable" (
                            prepend apiSchemas = ["NodeGraphNodeAPI"]
                        )
                        {
                            custom uint inputs:execIn (
                                customData = {
                                    bool isExecution = 1
                                }
                            )
                            custom rel inputs:graph = </World/PushGraph> (
                                customData = {
                                    dictionary omni = {
                                        dictionary graph = {
                                            string relType = "target"
                                        }
                                    }
                                }
                            )
                            custom token inputs:targetPath
                            custom token inputs:value (
                                customData = {
                                    dictionary omni = {
                                        dictionary graph = {
                                            string resolvedType = "int"
                                        }
                                    }
                                }
                            )
                            custom token inputs:variableName = "NewVariable01"
                            token node:type = "omni.graph.core.WriteVariable"
                            int node:typeVersion = 2
                            custom uint outputs:execOut (
                                customData = {
                                    bool isExecution = 1
                                }
                            )
                            custom token outputs:value
                            uniform token ui:nodegraph:node:expansionState = "open"
                            uniform float2 ui:nodegraph:node:pos = (-30.128845, -217.64111)
                        }
                    }
                }
            }
        }
    }
}

def Xform "Environment"
{
    double3 xformOp:rotateXYZ = (0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:intensity = 3000
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

