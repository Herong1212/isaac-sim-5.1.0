#usda 1.0
(
    doc ="""Generated from node description file OgnFlowSimTime.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_flowusd_FlowSimTime" (
        docs="""Node exposing simulation time to OG"""
    )
    {
        token node:type = "omni.flowusd.FlowSimTime"
        int node:typeVersion = 1

        # 3 attributes
        custom uint outputs:execOut (
            docs="""Executes when values are updated"""
        )
        custom double outputs:lastAbsoluteSimTime = 0.0 (
            docs="""Time when work submitted to Flow has flushed through"""
        )
        custom double outputs:lastFaultAbsoluteSimTime = 0.0 (
            docs="""Last time Flow hit max blocks"""
        )
    }
}
