        def OmniGraphNode "slang_update_batch_layers" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    int batchCurrentLayer = inputs_currentLayers_get(instanceId);
    int batchTargetLayer = inputs_targetLayers_get(instanceId);
    
    uint emitterCount = inputs_packedBatchLayers_size();
    for (uint emitterIdx = 0u; emitterIdx < emitterCount; emitterIdx++)
    {
        int4 packedBatchLayer = inputs_packedBatchLayers_get(emitterIdx);
        if (packedBatchLayer.x == int(instanceId))
        {
            batchCurrentLayer = packedBatchLayer.z;
        }
        if (packedBatchLayer.y == int(instanceId))
        {
            batchCurrentLayer = packedBatchLayer.w;
        }
    }
    
    outputs_currentLayers_set(instanceId, batchCurrentLayer);
    outputs_targetMatches_set(instanceId, batchCurrentLayer == batchTargetLayer);
}








