        }

        def OmniGraphNode "slang_update_cellSize" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom float inputs:cellSizeA
            prepend float inputs:cellSizeA.connect = </World/AutoCellSizeGraph/read_flowSimulateA_densityCellSize.outputs:value>
            custom float inputs:cellSizeB
            prepend float inputs:cellSizeB.connect = </World/AutoCellSizeGraph/read_flowSimulateB_densityCellSize.outputs:value>
            custom token inputs:code = """
static const int OP_NULL = 0;
static const int OP_TARGET_ALL_A = 1;
static const int OP_UPSIZE_A = 2;
static const int OP_DOWNSIZE_A = 3;
static const int OP_MIGRATE_A = 4;
static const int OP_REDUCE_A = 5;
static const int OP_TARGET_ALL_B = 6;
static const int OP_UPSIZE_B = 7;
static const int OP_DOWNSIZE_B = 8;
static const int OP_MIGRATE_B = 9;
static const int OP_REDUCE_B = 10;
static const int OP_CLEAR_ALL = 11;

void compute(uint instanceId)
{
    int op = inputs_streamingOperation_get();
    
    bool shouldExec = true;
    
    float cellSizeA = inputs_cellSizeA_get();
    float cellSizeB = inputs_cellSizeB_get();
    
    bool enabledA = true;
    bool enabledB = true;
    
    if (op == OP_UPSIZE_B)
    {
        enabledB = false;
        cellSizeB = pow(2.f, 1.f / 3.f) * cellSizeA;
    }
    else if (op == OP_DOWNSIZE_B)
    {
        enabledB = false;
        cellSizeB = pow(1.f / 2.f, 1.f / 3.f) * cellSizeA;
    }
    else if (op == OP_UPSIZE_A)
    {
        enabledA = false;
        cellSizeA = pow(2.f, 1.f / 3.f) * cellSizeB;
    }
    else if (op == OP_DOWNSIZE_A)
    {
        enabledA = false;
        cellSizeA = pow(1.f / 2.f, 1.f / 3.f)* cellSizeB;
    }
    
    outputs_cellSizeA_set(cellSizeA);
    outputs_cellSizeB_set(cellSizeB);
    outputs_enabledA_set(enabledA);
    outputs_enabledB_set(enabledB);
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
}













