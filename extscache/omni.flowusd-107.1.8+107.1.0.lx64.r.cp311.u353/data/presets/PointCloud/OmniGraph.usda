        def OmniGraphNode "slang_report_failures" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    double lastFaultAbsoluteTime = state_lastFaultAbsoluteTime_get();
    
    uint emitterCount = inputs_emitterStates_size();
    for (uint emitterIdx = 0u; emitterIdx < emitterCount; emitterIdx++)
    {
        int emitterState = inputs_emitterStates_get(emitterIdx);
        if (emitterState == 7) // commit failed
        {
            double2 emitterTimeRange = inputs_emitterTimeRanges_get(emitterIdx);
            if (emitterTimeRange.x > lastFaultAbsoluteTime)
            {
                lastFaultAbsoluteTime = emitterTimeRange.x;
            }
        }
    }
    
    state_lastFaultAbsoluteTime_set(lastFaultAbsoluteTime);
    outputs_lastFaultAbsoluteTime_set(lastFaultAbsoluteTime);
    
    outputs_execOut_set(EXEC_OUT_ENABLED);
}









