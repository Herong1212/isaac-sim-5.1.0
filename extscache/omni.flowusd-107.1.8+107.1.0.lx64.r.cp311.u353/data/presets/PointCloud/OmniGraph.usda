        def OmniGraphNode "slang_function_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:batchSize
            prepend uint inputs:batchSize.connect = </World/EmitterGraph/emitterDataReadAttrib_04.outputs:value>
            custom token inputs:code = """void compute(uint instanceId)
{
    bool shouldExec = false;
    
    uint count = state_count_get();
    uint64_t pointsStreamed = inputs_pointsStreamed_get();
    uint64_t batchSize = uint64_t(inputs_batchSize_get());
    
    int emitterIdx = -1;
    int minBatchIdx = -1;
    if (pointsStreamed < batchSize && count < 8)
    {
        for (uint idx = 0u; idx < inputs_emitterStates_size(); idx++)
        {
            int emitterState = inputs_emitterStates_get(idx);
            if (emitterState == 1 || emitterState == 3 || emitterState == 5)
            {
                int emitterBatchIdx = inputs_emitterBatchIndices_get(idx);
                if (minBatchIdx == -1 || emitterBatchIdx < minBatchIdx)
                {
                    shouldExec = true;
                    emitterIdx = int(idx);
                    minBatchIdx = emitterBatchIdx;
                }
            } 
        }
    }
    if (shouldExec)
    {
        state_count_set(count + 1u);
    }
    else
    {
        state_count_set(0u);
    }
    
    outputs_count_set(count);
    outputs_emitterIdx_set(emitterIdx);
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED_AND_PUSH : EXEC_OUT_DISABLED);
    outputs_reportCount_set(!shouldExec ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
}







