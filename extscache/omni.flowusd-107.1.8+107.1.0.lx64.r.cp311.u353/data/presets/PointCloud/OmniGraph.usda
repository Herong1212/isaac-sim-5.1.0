        def OmniGraphNode "slang_function" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:batchSize
            prepend uint inputs:batchSize.connect = </World/EmitterGraph/emitterDataReadAttrib_03.outputs:value>
            custom token inputs:code = """void compute(uint instanceId)
{
    uint64_t emitterPointOffset = inputs_emitterPointOffsets_get(instanceId);
    uint64_t emitterPointCount = inputs_emitterPointCounts_get(instanceId);
    
    if (instanceId == inputs_emitterIdx_get())
    {
        int emitterState = inputs_emitterStates_get(instanceId);
        
        emitterPointOffset += inputs_batchSize_get();
        if (emitterState == 1)
        {
            emitterPointCount = inputs_primPointCount_get();
        }
    }
    
    outputs_emitterPointOffsets_set(instanceId, emitterPointOffset);
    outputs_emitterPointCounts_set(instanceId, emitterPointCount);
    
    if (instanceId == 0u)
    {
        outputs_primPointCount_set(inputs_primPointCount_get());
