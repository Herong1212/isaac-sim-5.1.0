        emitterTimeRange.y = absoluteTime + emitTime;
    }
    else if (emitterState == 3)
    {
        emitterTimeRange.x = absoluteTime;
        emitterTimeRange.y = absoluteTime + emitTime;
    }
    else if (emitterState == 5)
    {
        emitterTimeRange.x = absoluteTime;
        emitterTimeRange.y = absoluteTime + emitTime;
    }
    
    outputs_emitterTimeRanges_set(instanceId, emitterTimeRange);
    
