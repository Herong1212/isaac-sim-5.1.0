        def OmniGraphNode "slang_function_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    if (inputs_finished_get() != EXEC_OUT_DISABLED)
    {
        float3 pointMin = state_pointMin_get();
        float3 pointMax = state_pointMax_get();
        
        float3 pointDiff = pointMax - pointMin;
        float volume = pointDiff.x * pointDiff.y * pointDiff.z;
        
        int maxBlocks = inputs_maxBlocks_get();
        if (maxBlocks <= 0)
        {
            maxBlocks = 4096;
        }
        
        float flowCellCount = float(maxBlocks) * 8192.f;
        
        float volumePerCell = volume / flowCellCount;
        
        float cellSize = pow(volumePerCell, 1.f / 3.f);
        
        cellSize = max(0.01f, cellSize);
        cellSize = min(10.f, cellSize);
        
        outputs_cellSize_set(cellSize);
        
        outputs_execOut_set(EXEC_OUT_ENABLED);
    }
    else
    {
        float3 pointMin = state_pointMin_get();
        float3 pointMax = state_pointMax_get();
        
        float4 localMin4 = float4(inputs_extent_get(0u), 1.f);
        float4 localMax4 = float4(inputs_extent_get(1u), 1.f);
        float4x4 mat = float4x4(inputs_localToWorld_get());
        float4 worldMin4 = mul(localMin4, mat);
        float4 worldMax4 = worldMin4;
        for (int i = 1; i < 8; i++)
        {
            float4 pos = float4(
                bool(i&1) ? localMax4.x : localMin4.x,
                bool(i&2) ? localMax4.y : localMin4.y,
                bool(i&4) ? localMax4.z : localMin4.z,
                1.f
            );
            pos = mul(pos, mat);
            worldMin4 = min(worldMin4, pos);
            worldMax4 = max(worldMax4, pos);
        }
        
        if (inputs_index_get() == 0u)
        {
            pointMin = worldMin4.xyz;
            pointMax = worldMax4.xyz;
        }
        pointMin = min(pointMin, worldMin4.xyz);
        pointMax = max(pointMax, worldMax4.xyz);
        
        state_pointMin_set(pointMin);
        state_pointMax_set(pointMax);
        
        outputs_cellSize_set(1.f);
        
        outputs_execOut_set(EXEC_OUT_DISABLED);
    }
}







