        def OmniGraphNode "slang_batch_index" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:batchSize
            prepend uint inputs:batchSize.connect = </World/EmitterGraph/emitterDataReadAttrib_02.outputs:value>
            custom token inputs:code = """void compute(uint instanceId)
{
    uint emitterIdx = uint(inputs_emitterIdx_get());
    
    bool shouldExec = false;
    
    int emitterState = inputs_emitterStates_get(emitterIdx);
    
    if (emitterState == 1 || emitterState == 3 || emitterState == 5)
    {
        shouldExec = true;
        
        uint batchIdx = uint(inputs_emitterBatchIndices_get(emitterIdx));
        Token emitterPrim = inputs_emitterPrims_get(emitterIdx);
        Token emitterXform = inputs_emitterXforms_get(emitterIdx);
        
        Token pointPrim = inputs_pointPrims_get(batchIdx);
        uint64_t batchRangeOffset = inputs_emitterPointOffsets_get(emitterIdx);
        uint64_t batchRangeSize = inputs_batchSize_get();
        
        outputs_emitterPrim_set(emitterPrim);
        outputs_emitterXform_set(emitterXform);
        outputs_pointCount_set(uint(batchRangeSize));
        outputs_pointPrim_set(pointPrim);
        outputs_rangeOffset_set(batchRangeOffset);
        outputs_rangeSize_set(batchRangeSize);
    }
    
    outputs_emitterIdx_set(int(emitterIdx));
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
}



















