        def OmniGraphNode "slang_update_targetLayers" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """
static const int OP_NULL = 0;
static const int OP_TARGET_ALL_A = 1;
static const int OP_UPSIZE_A = 2;
static const int OP_DOWNSIZE_A = 3;
static const int OP_MIGRATE_A = 4;
static const int OP_REDUCE_A = 5;
static const int OP_TARGET_ALL_B = 6;
static const int OP_UPSIZE_B = 7;
static const int OP_DOWNSIZE_B = 8;
static const int OP_MIGRATE_B = 9;
static const int OP_REDUCE_B = 10;
static const int OP_CLEAR_ALL = 11;

void compute(uint instanceId)
{
    int currentLayer = inputs_currentLayers_get(instanceId);
    int targetLayer = inputs_targetLayers_get(instanceId);
    
    int op = inputs_streamingOperation_get();
    
    if (op == OP_CLEAR_ALL)
    {
        targetLayer = 0;
    }
    else if (op == OP_TARGET_ALL_A)
    {
        targetLayer = 1;
    }
    else if (op == OP_MIGRATE_B)
    {
        if (currentLayer != 0)
        {
            targetLayer = 2;
        }
    }
    else if (op == OP_REDUCE_A)
    {
        if (instanceId == inputs_findIdx_get())
        {
            targetLayer = 0;
        }
        else
        {
            targetLayer = currentLayer < 0 ? -(currentLayer + 1) : currentLayer;
        }
    }
    else if (op == OP_TARGET_ALL_B)
    {
        targetLayer = 2;
    }
    else if (op == OP_MIGRATE_A)
    {
        if (currentLayer != 0)
        {
            targetLayer = 1;
        }
    }
    else if (op == OP_REDUCE_B)
    {
        if (instanceId == inputs_findIdx_get())
        {
            targetLayer = 0;
        }
        else
        {
            targetLayer = currentLayer < 0 ? -(currentLayer + 1) : currentLayer;
        }
    }
    
    outputs_targetLayers_set(instanceId, targetLayer);
}


















