        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    uint idx = state_idx_get();
    state_idx_set((idx + 1) % 8);
    
    outputs_emitterPrim_set(inputs_emitterPrim_get());
    outputs_pointPrim_set(inputs_pointPrim_get());
    outputs_rangeOffset_set(inputs_rangeOffset_get());
    outputs_rangeSize_set(inputs_rangeSize_get());
    
    outputs_execOut1_set(idx == 0 ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
    outputs_execOut2_set(idx == 1 ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
    outputs_execOut3_set(idx == 2 ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
    outputs_execOut4_set(idx == 3 ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
