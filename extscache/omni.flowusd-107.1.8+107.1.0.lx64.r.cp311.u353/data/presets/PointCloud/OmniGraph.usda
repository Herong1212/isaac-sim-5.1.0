        def OmniGraphNode "slang_finalize_state" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    int emitterState = inputs_emitterStates_get(instanceId);
    
    if (instanceId == inputs_emitterIdx_get())
    {
        if (emitterState == 1)
        {
            emitterState = 2;
        }
        else if (emitterState == 3)
        {
            emitterState = 4;
        }
        else if (emitterState == 5)
        {
            emitterState = 6;
        }
    }
    
    outputs_emitterStates_set(instanceId, emitterState);
    
    if (instanceId == 0u)
    {
        outputs_execOut_set(EXEC_OUT_ENABLED);
    }
}


