        def OmniGraphNode "slang_compute_progress" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    uint sum = 0u;
    uint count = inputs_targetMatches_size();
    for (uint idx = 0u; idx < count; idx++)
    {
        bool targetMatch = inputs_targetMatches_get(idx);
        if (targetMatch)
        {
            sum = sum + 1u;
        }
    }
    
    double progress = count > 0u ? (double(sum) / double(count)) : 0.0;
    
    outputs_progress_set(progress);
}





