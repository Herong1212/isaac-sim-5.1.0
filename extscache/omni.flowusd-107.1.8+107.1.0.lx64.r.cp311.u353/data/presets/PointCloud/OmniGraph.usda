        def OmniGraphNode "slang_update_state" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom double inputs:blockUsage
            prepend double inputs:blockUsage.connect = </World/AutoCellSizeGraph/read_emitterData_outputs_blockUsage.outputs:value>
            custom token inputs:code = """
static const int STATE_INITIAL = 0;
static const int STATE_UP_STREAM_A = 1;
static const int STATE_UP_RESIZE_B = 2;
static const int STATE_UP_MIGRATE_B = 3;
static const int STATE_UP_REDUCE_A = 4;
static const int STATE_UP_STREAM_B = 5;
static const int STATE_UP_RESIZE_A = 6;
static const int STATE_UP_MIGRATE_A = 7;
static const int STATE_UP_REDUCE_B = 8;
static const int STATE_DOWN_STREAM_A = 9;
static const int STATE_DOWN_RESIZE_B = 10;
static const int STATE_DOWN_STREAM_B = 11;
static const int STATE_DOWN_RESIZE_A = 12;
static const int STATE_COMPLETE = 13;
static const int STATE_CLEAR = 14;

static const int OP_NULL = 0;
static const int OP_TARGET_ALL_A = 1;
static const int OP_UPSIZE_A = 2;
static const int OP_DOWNSIZE_A = 3;
static const int OP_MIGRATE_A = 4;
static const int OP_REDUCE_A = 5;
static const int OP_TARGET_ALL_B = 6;
static const int OP_UPSIZE_B = 7;
static const int OP_DOWNSIZE_B = 8;
static const int OP_MIGRATE_B = 9;
static const int OP_REDUCE_B = 10;
static const int OP_CLEAR_ALL = 11;

void compute(uint instanceId)
{
    int streamingState = inputs_streamingState_get();
    int streamingOperation = 0;
    
    double lastFaultAbsoluteTime = state_lastFaultAbsoluteTime_get();
    double newLastFaultAbsoluteTime = inputs_lastFaultAbsoluteTime_get();
    state_lastFaultAbsoluteTime_set(newLastFaultAbsoluteTime);
    
    bool didFault = newLastFaultAbsoluteTime > lastFaultAbsoluteTime;
    
    bool softFault = inputs_blockUsage_get() > 0.75;
    
    double progressAbsoluteTime = state_progressAbsoluteTime_get();
    double newProgressAbsoluteTime = inputs_progressAbsoluteTime_get();
    state_progressAbsoluteTime_set(progressAbsoluteTime);
    
    bool didComplete = false;
    if (newProgressAbsoluteTime > progressAbsoluteTime)
    {
        if (inputs_progress_get() >= 1.0)
        {
            didComplete = true;
        }
    }
    
    bool shouldClear = inputs_shouldClear_get();
    
    if (shouldClear)
    {
        streamingState = STATE_CLEAR;
        streamingOperation = OP_CLEAR_ALL;
    }
    else if (streamingState == STATE_CLEAR)
    {
        if (!shouldClear)
        {
            streamingState = STATE_INITIAL;
        }
    }
    else if (streamingState == STATE_INITIAL)
    {
       streamingState = STATE_UP_STREAM_A;
       streamingOperation = OP_TARGET_ALL_A;
    }
    else if (streamingState == STATE_UP_STREAM_A)
    {
        if (didFault || softFault)
        {
            streamingState = STATE_UP_RESIZE_B;
            streamingOperation = OP_UPSIZE_B;
        }
        else if (didComplete)
        {
            streamingState = STATE_DOWN_RESIZE_B;
            streamingOperation = OP_DOWNSIZE_B;
        }
    }
    else if (streamingState == STATE_UP_RESIZE_B)
    {
        streamingState = STATE_UP_MIGRATE_B;
        streamingOperation = OP_MIGRATE_B;
    }
    else if (streamingState == STATE_UP_MIGRATE_B)
    {
        if (didFault)
        {
            streamingState = STATE_UP_REDUCE_A;
            streamingOperation = OP_REDUCE_A;
        }
        else if (didComplete)
        {
            streamingState = STATE_UP_STREAM_B;
            streamingOperation = OP_TARGET_ALL_B;
        }
    }
    else if (streamingState == STATE_UP_REDUCE_A)
    {
        if (didComplete)
        {
            streamingState = STATE_UP_MIGRATE_B;
            streamingOperation = OP_MIGRATE_B;
        }
    }
    else if (streamingState == STATE_UP_STREAM_B)
    {
        if (didFault || softFault)
        {
            streamingState = STATE_UP_RESIZE_A;
            streamingOperation = OP_UPSIZE_A;
        }
        else if (didComplete)
        {
            streamingState = STATE_DOWN_RESIZE_A;
            streamingOperation = OP_DOWNSIZE_A;
        }
    }
    else if (streamingState == STATE_UP_RESIZE_A)
    {
        streamingState = STATE_UP_MIGRATE_A;
        streamingOperation = OP_MIGRATE_A;
    }
    else if (streamingState == STATE_UP_MIGRATE_A)
    {
        if (didFault)
        {
            streamingState = STATE_UP_REDUCE_B;
            streamingOperation = OP_REDUCE_B;
        }
        else if (didComplete)
        {
            streamingState = STATE_UP_STREAM_A;
            streamingOperation = OP_TARGET_ALL_A;
        }
    }
    else if (streamingState == STATE_UP_REDUCE_B)
    {
        if (didComplete)
        {
            streamingState = STATE_UP_MIGRATE_A;
            streamingOperation = OP_MIGRATE_A;
        }
    }
    else if (streamingState == STATE_DOWN_STREAM_A)
    {
        if (didFault)
        {
            streamingState = STATE_COMPLETE;
            streamingOperation = OP_TARGET_ALL_B;
        }
        else if (didComplete)
        {
            streamingState = STATE_DOWN_RESIZE_B;
            streamingOperation = OP_DOWNSIZE_B;
        }
    }
    else if (streamingState == STATE_DOWN_RESIZE_B)
    {
        streamingState = STATE_DOWN_STREAM_B;
        streamingOperation = OP_TARGET_ALL_B;
    }
    else if (streamingState == STATE_DOWN_STREAM_B)
    {
        if (didFault)
        {
            streamingState = STATE_COMPLETE;
            streamingOperation = OP_TARGET_ALL_A;
        }
        else if (didComplete)
        {
            streamingState = STATE_DOWN_RESIZE_A;
            streamingOperation = OP_DOWNSIZE_A;
        }
    }
    else if (streamingState == STATE_DOWN_RESIZE_A)
    {
        streamingState = STATE_DOWN_STREAM_A;
        streamingOperation = OP_TARGET_ALL_A;
    }
    
    outputs_streamingState_set(streamingState);
    outputs_streamingOperation_set(streamingOperation);
    
    outputs_execOut_set(EXEC_OUT_ENABLED);
}










































""" (
                customData = {
                    int version = 1
                }
            )
            custom uint inputs:execIn (
                customData = {
                    bool ExecutionType = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/AutoCellSizeGraph/sequence.outputs:output0>
