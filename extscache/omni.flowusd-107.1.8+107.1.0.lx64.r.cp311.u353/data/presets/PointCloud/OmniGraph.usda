        def OmniGraphNode "slang_function_02" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    if (inputs_reset_get() != EXEC_OUT_DISABLED)
    {
        state_hasInit_set(false);
        
        outputs_once_set(EXEC_OUT_DISABLED);
        outputs_after_set(EXEC_OUT_DISABLED);
    }
    else
    {
        bool hasInit = state_hasInit_get();
        
        outputs_once_set(!hasInit ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
        outputs_after_set(hasInit ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
        
        hasInit = true;
        state_hasInit_set(hasInit);
    }
}

