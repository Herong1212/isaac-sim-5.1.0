        def OmniGraphNode "slang_function_03" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    bool shouldExec = false;
    
    const double minTimeDiff = 0.100;
    
    double absoluteTime = inputs_progressAbsoluteTime_get();
    double targetAbsoluteTime = state_targetAbsoluteTime_get();
    
    if (targetAbsoluteTime == 0.0)
    {
        targetAbsoluteTime = absoluteTime + minTimeDiff;
    }
    
    double lastAbsoluteTime = inputs_lastAbsoluteTime_get();
    
    if (targetAbsoluteTime < lastAbsoluteTime)
    {
        shouldExec = true;
        targetAbsoluteTime = absoluteTime + minTimeDiff;
    }
    
    state_targetAbsoluteTime_set(targetAbsoluteTime);
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
}





