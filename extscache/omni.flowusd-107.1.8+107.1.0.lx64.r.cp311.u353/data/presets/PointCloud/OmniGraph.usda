        def OmniGraphNode "slang_pick_batch" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    if (instanceId != 0u)
    {
        return;
    }
    
    // sequential to avoid race to currentLayers
    uint batchIdx = 0u;
    uint batchCount = inputs_currentLayers_size();
    
    uint emitterCount = inputs_emitterStates_size();
    for (uint emitterIdx = 0u; emitterIdx < emitterCount; emitterIdx++)
    {
        int emitterState = inputs_emitterStates_get(emitterIdx);
        int emitterBatchIndex = inputs_emitterBatchIndices_get(emitterIdx);
        int2 emitterLayerPair = inputs_emitterLayerPairs_get(emitterIdx);
        
        int4 packedBatchLayers = int4(-1, -1, -1, -1);
        
        bool wasActive = emitterState == 7 || emitterState == 8;
        
        if (emitterState == 7) // commit fail
        {
            packedBatchLayers.y = emitterBatchIndex;
            packedBatchLayers.w = emitterLayerPair.x; // back to old layer
            emitterState = 0;
        }
        else if (emitterState == 8) // commit success
        {
            packedBatchLayers.y = emitterBatchIndex;
            packedBatchLayers.w = emitterLayerPair.y; // commit target layer
            emitterState = 0;
        }
        
        if (emitterState == 0) // emitter idle
        {
            emitterBatchIndex = -1; // default to no selected batch
            
            for(;batchIdx < batchCount; batchIdx++)
            {
                int batchCurrentLayer = inputs_currentLayers_get(batchIdx);
                int batchTargetLayer = inputs_targetLayers_get(batchIdx);
                
                if (batchCurrentLayer >= 0 && batchCurrentLayer != batchTargetLayer) // needs update
                {
                    // transition to splat state
                    emitterState = 1; 
                    emitterBatchIndex = int(batchIdx);
                    emitterLayerPair.x = batchCurrentLayer;
                    emitterLayerPair.y = batchTargetLayer;
                    
                    // mark batch as pending
                    packedBatchLayers.x = int(batchIdx);
                    packedBatchLayers.z = -(batchCurrentLayer + 1);
                    
                    batchIdx++; // to avoid repeats
                    
                    break;
                }
            }
        }
        
        if (emitterState == 0 && wasActive)
        {
            emitterState = -2; // clear emitter
        }
        
        outputs_emitterStates_set(emitterIdx, emitterState);
        outputs_emitterBatchIndices_set(emitterIdx, emitterBatchIndex);
        outputs_emitterLayerPairs_set(emitterIdx, emitterLayerPair);
        
        outputs_packedBatchLayers_set(emitterIdx, packedBatchLayers);
    }
    
    
    outputs_execOut_set(EXEC_OUT_ENABLED);
}





























