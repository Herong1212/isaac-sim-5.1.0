        def OmniGraphNode "slang_emitter_config" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    uint emitterIdx = uint(inputs_emitterIdx_get());
    
    bool shouldExec = false;
    
    int emitterState = inputs_emitterStates_get(emitterIdx);
    
    if (emitterState == 1 || emitterState == 3 || emitterState == 5)
    {
        shouldExec = true;
        
        int2 emitterLayerPair = inputs_emitterLayerPairs_get(emitterIdx);
        Token emitterPrim = inputs_emitterPrims_get(emitterIdx);
        int emitterState = inputs_emitterStates_get(emitterIdx);
        
        bool allocate;
        int layer;
        float opacity;
        if (emitterState == 1)
        {
            // splat to target layer
            allocate = true;
            layer = emitterLayerPair.y;
            opacity = 1.f;
        }
        else if (emitterState == 3)
        {
            // unsplate to old layer
            allocate = false;
            layer = emitterLayerPair.x;
            opacity = 0.f;
        }
        else //if (emitterState == 5)
        {
            // had a fault, unsplat target to ensure cleanup
            allocate = false;
            layer = emitterLayerPair.y;
            opacity = 0.f;
        }
        
        outputs_allocate_set(allocate);
        outputs_emitterPrim_set(emitterPrim);
        outputs_layer_set(layer);
        outputs_opacity_set(opacity);
    }
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED : EXEC_OUT_DISABLED);
}



