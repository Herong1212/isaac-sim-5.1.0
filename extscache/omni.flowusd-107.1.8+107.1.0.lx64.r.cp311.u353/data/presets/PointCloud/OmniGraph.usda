        def OmniGraphNode "slang_function_04" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    bool shouldExec = false;
    
    int emitterIdx = state_emitterIdx_get();
    
    int outEmitterIdx = -1;
    for (; emitterIdx < inputs_emitterStates_size(); emitterIdx++)
    {
        int emitterState = inputs_emitterStates_get(emitterIdx);
        if (emitterState == -2)
        {
            shouldExec = true;
            outEmitterIdx = emitterIdx;
            break;
        }
    }
    
    state_emitterIdx_set(shouldExec ? emitterIdx + 1 : 0);
    outputs_emitterIdx_set(outEmitterIdx);
    
    outputs_execOut_set(shouldExec ? EXEC_OUT_ENABLED_AND_PUSH : EXEC_OUT_DISABLED);
}




""" (
                customData = {
                    int version = 1
                }
            )
            custom int[] inputs:emitterStates
            prepend int[] inputs:emitterStates.connect = </World/EmitterGraph/read_variable_12.outputs:value>
