        def OmniGraphNode "slang_flow_timing" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:code = """void compute(uint instanceId)
{
    int emitterState = inputs_emitterStates_get(instanceId);
    uint64_t emitterPointCount = inputs_emitterPointCounts_get(instanceId);
    uint64_t emitterPointOffset = inputs_emitterPointOffsets_get(instanceId);
    
    if (emitterState == 2 || // waiting for splat
        emitterState == 4 || // waiting for unsplat
        emitterState == 6 || // waiting for fault unsplat
        emitterState == -1 ) // startup delay
    {
        double2 emitterTimeRange = inputs_emitterTimeRanges_get(instanceId);
        
        bool isComplete = emitterTimeRange.y <= inputs_lastAbsolute_get();
        bool hasFault = inputs_lastFaultAbsolute_get() >= emitterTimeRange.x/* &&
                        inputs_lastFaultAbsolute_get() <= emitterTimeRange.y */;
        
        int2 emitterLayerPair = inputs_emitterLayerPairs_get(instanceId);
        
        bool streamingComplete = emitterPointOffset >= emitterPointCount;
        
        if (emitterState == 2 && hasFault && emitterLayerPair.y != 0)
        {
           emitterState = 5;  // go to fault state to schedule unsplat
           emitterPointCount = emitterPointOffset;
           emitterPointOffset = 0llu;
        }
        else if (isComplete)
        {
            if (emitterState == 2)
            {
                if (streamingComplete)
                {
                    emitterState = 3; // unsplat
                    emitterPointCount = emitterPointOffset;
                    emitterPointOffset = 0llu;
                }
                else
                {
                    emitterState = 1; // splat next batch
                }
            }
            else if (emitterState == 4)
            {
                if (streamingComplete)
                {
                    emitterState = 8; //commit success
                    emitterPointCount = ~0llu;
                    emitterPointOffset = 0llu;
                }
                else
                {
                    emitterState = 3; // unsplat next batch
                }
            }
            else if (emitterState == 6)
            {
                if (streamingComplete)
                {
                    emitterState = 7; // commit fail
                    emitterPointCount = ~0llu;
                    emitterPointOffset = 0llu;
                }
                else
                {
                    emitterState = 5; // upsplat next batch
                }
            }
            else if (emitterState == -1)
            {
                emitterState = 0; // idle
                emitterPointCount = ~0llu;
                emitterPointOffset = 0llu;
            }
        }
    }
    
    outputs_emitterStates_set(instanceId, emitterState);
    outputs_emitterPointCounts_set(instanceId, emitterPointCount);
    outputs_emitterPointOffsets_set(instanceId, emitterPointOffset);
    
    if (instanceId == 0u)
    {
        outputs_lastAbsolute_set(inputs_lastAbsolute_get());
        outputs_execOut_set(EXEC_OUT_ENABLED);
    }
}
























