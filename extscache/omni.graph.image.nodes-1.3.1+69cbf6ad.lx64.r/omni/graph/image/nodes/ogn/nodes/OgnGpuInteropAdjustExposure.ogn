{
    "omni.graph.examples.cpp.GpuInteropAdjustExposure": {
        "version": 2,
        "categories": ["examples", "graph:postRender", "rendering"],
        "description": [
            "RTX Renderer Postprocess Example: adjust the exposure of the rendered image.",
            "The node can be used in a post-render graph to change the brightness of the rendered image.",
            "As a CUDA interop node, the node is scheduled for execution as a CUDA command.",
            "If the input RenderVar is not a valid texture, the node does not produce a result."
        ],
        "metadata": {
            "uiName": "GPU Interop Example: Adjust Render Exposure"
        },
        "inputs": {
            "cudaMipmappedArray": {
                "type": "uint64",
                "description": "The RenderVar data, defined as a CUDA Mipmapped Array.",
                "uiName": "RenderVar Data"
            },
            "width": {
                "type": "uint",
                "description": "The width of the input image.",
                "uiName": "Width"
            },
            "height": {
                "type": "uint",
                "description": "The height of the input image.",
                "uiName": "Height"
            },
            "mipCount": {
                "type": "uint",
                "description": "The number of levels of detail encoded in 'RenderVar Data'.",
                "uiName": "Mip Count"
            },
            "format": {
                "type": "uint64",
                "description": "The texture format of the input image, matching the values of the enum carb::graphics::Format.",
                "uiName": "Texture Format"
            },
            "stream": {
                "type": "uint64",
                "description": "The CUDA Stream used to order the CUDA commands scheduled by this graph execution.",
                "uiName": "Stream"
            },
            "exposure": {
                "type": "float",
                "description": [
                    "Exposure value (in stops). Positive values increase the brightness of the image, while negative values result in darker images. ",
                    "The default exposure value of 0 results in an unmodified image. ",
                    "Increasing the value by one unit, results in a doubling of the exposure and a brigher image; ",
                    "decreasing the value by one unit results in a halving of the exposure, thus a darker image. "
                ],
                "uiName": "Exposure",
                "default": 0
            },
            "simTime": {
                "type": "double",
                "description": "The delta time of the simulation.",
                "uiName": "Simulation Time"
            },
            "hydraTime": {
                "type": "double",
                "description": "The delta time of the renderer in stage.",
                "uiName": "Renderer Time"
            }
        }
    }
}
