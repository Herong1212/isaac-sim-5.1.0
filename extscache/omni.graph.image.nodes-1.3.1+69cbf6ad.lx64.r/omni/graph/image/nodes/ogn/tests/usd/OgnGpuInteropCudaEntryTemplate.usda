#usda 1.0
(
    doc ="""Generated from node description file OgnGpuInteropCudaEntry.ogn
Contains templates for node types found in that file."""
)

def OmniGraph "TestGraph"
{
    token evaluator:type = "push"
    int2 fileFormatVersion = (1, 3)
    token flatCacheBacking = "Shared"
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "Template_omni_graph_nodes_GpuInteropCudaEntry" (
        docs="""Entry node for post-processing hydra render results for a single view.  It outputs the properties of a RenderVar as attributes accessible to downstream nodes.  All downstream nodes are scheduled as CUDA commands."""
    )
    {
        token node:type = "omni.graph.nodes.GpuInteropCudaEntry"
        int node:typeVersion = 3

        # 1 attribute
        custom string inputs:sourceName = "ldrColor" (
            docs="""The name of the source RenderVar (AOV). The properties of this AOV are the output of this node."""
        )

        # 14 attributes
        custom uint outputs:bufferSize (
            docs="""Size of the buffer, if the selected RenderVar is a buffer, otherwise it represents the texture depth."""
        )
        custom uint64 outputs:cudaMipmappedArray (
            docs="""The RenderVar data, which is represented as a CUDA Mipmapped Array."""
        )
        custom int64 outputs:externalTimeOfSimFrame (
            docs="""The external time on the master node, matching the simulation frame used to render this frame. 
            It is only valid if the simulation and rendering are performed at the same, or different but constant rates."""
        )
        custom uint64 outputs:format (
            docs="""The texture format of the input image, matching the values of the enum carb::graphics::Format. 
            If the RenderVar is a buffer, the value is unknown."""
        )
        custom int64 outputs:frameId (
            docs="""The frame number. 
            It is only valid if the simulation and rendering are performed at the same, or different but constant rates."""
        )
        custom uint outputs:height (
            docs="""The width of the selected texture RenderVar. 
            If the RenderVar is an arbitrary buffer, it is 0."""
        )
        custom double outputs:hydraTime (
            docs="""The time difference since the last rendered frame."""
        )
        custom bool outputs:isBuffer (
            docs="""True if the entry exposes an arbitrary buffer RenderVar as opposed to a texture RenderVar."""
        )
        custom uint outputs:mipCount (
            docs="""The number of levels of detail encoded in 'RenderVar Data'. If the RenderVar is not a texture, the value is 0."""
        )
        custom uint64 outputs:rationalTimeOfSimDenominator (
            docs="""The denominator of the simulation time expressed as rational time. 
            It is always valid and may be used to fetch data from Fabric during the node compute."""
        )
        custom int64 outputs:rationalTimeOfSimNumerator (
            docs="""The numerator of the simulation time expressed as rational time. 
            It is always valid and may be used to fetch data from Fabric during the node compute."""
        )
        custom double outputs:simTime (
            docs="""The time difference since the last simulation frame.
            May suffer from loss of precision and cannot be used as a deterministic identifier, 
            for example for fetching data from Fabric during the node compute - 
            use the Rational Time instead in that case."""
        )
        custom uint64 outputs:stream (
            docs="""The CUDA Stream used to order the CUDA commands scheduled by this graph execution."""
        )
        custom uint outputs:width (
            docs="""The width of the selected texture RenderVar. 
            If the RenderVar is an arbitrary buffer, it is 0."""
        )
    }
}
