            int node:typeVersion = 2
            custom double outputs:absoluteSimTime
            custom double outputs:deltaSeconds = 0
            custom double outputs:frame = 0
            custom bool outputs:isPlaying = 0
            custom uint outputs:tick = 0 (
                customData = {
                    bool isExecution = 1
