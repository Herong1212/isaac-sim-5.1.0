def Xform "World"
{
    def AnimationGraph "AnimationGraph"
    {
        custom uniform float3[] anim:graph:variable:PathPoints
        delete rel inputs:pose = [
            </World/AnimationGraph/stand_walk_loop_skelanim>,
            </World/AnimationGraph/stand_idle_loop_skelanim>,
            </World/AnimationGraph/stand_idle_wave_loop_skelanim>,
            </World/AnimationGraph/Blend>,
        ]
        prepend rel inputs:pose = </World/AnimationGraph/MotionMatching>
        rel skel:skeleton = </World/Character/Root>

        def MotionMatching "MotionMatching"
        {
            prepend rel inputs:clips = [
                </World/Animations/stand_walk_1_skelanim>,
                </World/Animations/stand_walk_1_mirror_skelanim>,
                </World/Animations/stand_walk_2_skelanim>,
                </World/Animations/stand_walk_2_mirror_skelanim>,
                </World/Animations/stand_walk_3_skelanim>,
                </World/Animations/stand_walk_3_mirror_skelanim>,
                </World/Animations/stand_walk_4_skelanim>,
                </World/Animations/stand_walk_4_mirror_skelanim>,
                </World/Animations/stand_walk_5_skelanim>,
                </World/Animations/stand_walk_5_mirror_skelanim>,
                </World/Animations/stand_walk_7_skelanim>,
                </World/Animations/stand_walk_7_mirror_skelanim>,
            ]
            token[] inputs:joints = ["L_Ball", "R_Ball", "Pelvis"]
            float[] inputs:jointsPositionWeights = [0.75, 0.75, 0]
            prepend rel inputs:pathPoints = </World/AnimationGraph/PathPoints>
            custom uniform float2 ui:position = (-269.65387, 5.830662)
        }

        def ReadVariable "PathPoints"
        {
            token inputs:variableName = "PathPoints"
            custom uniform float2 ui:position = (-561.08496, 24.885159)
        }
    }

    def OmniGraph "ActionGraph"
    {
        token evaluator:type = "execution"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageOnDemand"

        def ComputeGraphSettings "computegraphSettings" (
            active = false
        )
        {
            custom token evaluator:type = "execution"
            custom int2 fileFormatVersion = (1, 3)
            custom token flatCacheBacking = "Shared"
            custom token pipelineStage = "pipelineStageOnDemand"
        }

        def OmniGraphNode "write_animation_graph_variable" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn = 0
            prepend uint inputs:execIn.connect = </World/ActionGraph/on_tick_01.outputs:tick>
            custom rel inputs:graph = </World/AnimationGraph> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "bundle"
                        }
                    }
                }
            )
            custom token inputs:skelRootPath = ""
            prepend token inputs:skelRootPath.connect = </World/ActionGraph/graph_target.outputs:primPath>
            custom token inputs:value = ""
            prepend token inputs:value.connect = [
                </World/ActionGraph/make_array.outputs:array>,
                </World/ActionGraph/make_array_01.outputs:array>,
            ]
            custom token inputs:variableName = "PathPoints"
            token node:type = "omni.anim.graph.WriteAnimationGraphVariable"
            int node:typeVersion = 1
            custom uint outputs:execOut = 1 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (964.66, 82.56509)
        }

        def OmniGraphNode "graph_target" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:targetPath = "/World/biped_demo"
            token node:type = "omni.graph.nodes.GraphTarget"
            int node:typeVersion = 1
            custom token outputs:primPath
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (566, 173)
        }

        def OmniGraphNode "get_translation" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:matrix
            prepend token inputs:matrix.connect = </World/ActionGraph/get_prim_local_to_world_transform.outputs:localToWorldTransform>
            token node:type = "omni.graph.nodes.GetMatrix4Translation"
            int node:typeVersion = 1
            custom token outputs:translation
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (69.8606, 283.30356)
        }

        def OmniGraphNode "to_float" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:role (
                allowedTokens = ["None", "Color", "Normal", "Point", "Quaternion", "TexCoord", "Vector"]
            )
            custom token inputs:value = ""
            prepend token inputs:value.connect = </World/ActionGraph/get_translation.outputs:translation>
            token node:type = "omni.graph.nodes.ToFloat"
            int node:typeVersion = 1
            custom token outputs:converted
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (307.94388, 282.89343)
        }

