def Xform "World"
{
    def "biped_demo" (
        prepend apiSchemas = ["AnimationGraphAPI", "OmniGraphAPI"]
        prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Characters/NVIDIA/biped_demo_no_material.usd@
    )
    {
        custom quatf _worldOrientation = (1, 0, 0, 0)
        custom double3 _worldPosition = (0, 0, 0)
        custom vector3f _worldScale = (1, 1, 1)
        custom float anim:graph:variable:Action
        custom string anim:graph:variable:State
        rel animationGraph = </World/AnimationGraph>
        custom float graph:variable:Action
        custom string graph:variable:State
        rel omniGraphs = </World/ActionGraph>

        over "Body_Mesh"
        {
            rel material:binding = None
        }
    }

    def AnimationGraph "AnimationGraph"
    {
        custom uniform string anim:graph:variable:Action
        custom uniform string anim:graph:variable:State
        delete rel inputs:pose = [
            </World/AnimationGraph/stand_walk_loop_skelanim>,
            </World/AnimationGraph/stand_idle_loop_skelanim>,
            </World/AnimationGraph/stand_idle_wave_loop_skelanim>,
            </World/AnimationGraph/Blend>,
        ]
        prepend rel inputs:pose = </World/AnimationGraph/StateMachine>
        rel skel:skeleton = </World/biped_demo/Root>
        custom uniform float2 ui:position = (-211.4043, 4.450616)

        def StateMachine "StateMachine"
        {
            rel inputs:startState = </World/AnimationGraph/StateMachine/Idle>
            custom uniform float2 ui:position = (-481.63937, 3.011539)

            def State "Walk"
            {
                prepend rel inputs:pose = </World/AnimationGraph/StateMachine/Walk/stand_walk_loop_skelanim>
                custom uniform float2 ui:position = (-134.76785, 101.76619)

                def AnimationClip "stand_walk_loop_skelanim"
                {
                    rel inputs:animationSource = </World/Animations/stand_walk_loop_skelanim>
                    custom uniform float2 ui:position = (-238.92578, 1.5484396)
                }
            }

            def State "Idle"
            {
                prepend rel inputs:pose = </World/AnimationGraph/StateMachine/Idle/stand_idle_loop_skelanim>
                custom uniform float2 ui:position = (32.784042, -3.8569467)
                custom uniform float2 ui:subGraphPosition = (208.93277, 6.267982)

                def AnimationClip "stand_idle_loop_skelanim"
                {
                    rel inputs:animationSource = </World/Animations/stand_idle_loop_skelanim>
                    custom uniform float2 ui:position = (-29.640766, 8.055215)
                }
            }

            def State "Wave"
            {
                prepend rel inputs:pose = </World/AnimationGraph/StateMachine/Wave/stand_idle_wave_loop_skelanim>
                custom uniform float2 ui:position = (191.78351, 101.4903)

                def AnimationClip "stand_idle_wave_loop_skelanim"
                {
                    rel inputs:animationSource = </World/Animations/stand_idle_wave_loop_skelanim>
                    bool inputs:loop = 0
                    custom uniform float2 ui:position = (-264.03488, 0.79784316)
                }
            }

            def Transition "Transition"
            {
                prepend rel inputs:condition = </World/AnimationGraph/StateMachine/Transition/ConditionAND>
                rel inputs:state = </World/AnimationGraph/StateMachine/Idle>
                rel outputs:state = </World/AnimationGraph/StateMachine/Walk>

                def ConditionAND "ConditionAND"
                {
                    prepend rel inputs:condition0 = </World/AnimationGraph/StateMachine/Transition/ConditionCompareVariable>
                    prepend rel inputs:condition1 = </World/AnimationGraph/StateMachine/Transition/ConditionCompareVariable_01>
                    custom uniform float2 ui:position = (-219.82753, 5.4244843)
                }

                def ConditionCompareVariable "ConditionCompareVariable"
                {
                    custom uniform string inputs:value = "Move"
                    token inputs:variableName = "State"
                    custom uniform float2 ui:position = (-495.51324, 6.3614655)
                }

                def ConditionCompareVariable "ConditionCompareVariable_01"
                {
                    token inputs:operator = "!="
                    custom uniform string inputs:value = "Wave"
                    token inputs:variableName = "Action"
                    custom uniform float2 ui:position = (-513.8366, 107.7953)
                }
            }

            def Transition "Transition_01"
            {
                prepend rel inputs:condition = </World/AnimationGraph/StateMachine/Transition_01/ConditionOR>
                rel inputs:state = </World/AnimationGraph/StateMachine/Walk>
                rel outputs:state = </World/AnimationGraph/StateMachine/Idle>

                def ConditionOR "ConditionOR"
                {
                    prepend rel inputs:condition0 = </World/AnimationGraph/StateMachine/Transition_01/ConditionCompareVariable>
                    prepend rel inputs:condition1 = </World/AnimationGraph/StateMachine/Transition_01/ConditionCompareVariable_01>
                    custom uniform float2 ui:position = (-223.83879, -0.14685631)
                }

                def ConditionCompareVariable "ConditionCompareVariable"
                {
                    token inputs:operator = "!="
                    custom uniform string inputs:value = "Move"
                    token inputs:variableName = "State"
                    custom uniform float2 ui:position = (-515.42114, 1.0977162)
                }

                def ConditionCompareVariable "ConditionCompareVariable_01"
                {
                    token inputs:operator = "=="
                    custom uniform string inputs:value = "Wave"
                    token inputs:variableName = "Action"
                    custom uniform float2 ui:position = (-542.05255, 97.113335)
                }
            }

            def Transition "Transition_02"
            {
                prepend rel inputs:condition = </World/AnimationGraph/StateMachine/Transition_02/ConditionCompareVariable>
                rel inputs:state = </World/AnimationGraph/StateMachine/Idle>
                rel outputs:state = </World/AnimationGraph/StateMachine/Wave>
                custom uniform float2 ui:subGraphPosition = (0.1846722, 0)

                def ConditionCompareVariable "ConditionCompareVariable"
                {
                    custom uniform string inputs:value = "Wave"
                    token inputs:variableName = "Action"
                    custom uniform float2 ui:position = (-254.99583, -0.11167151)
                }
            }

            def Transition "Transition_03"
            {
                prepend rel inputs:condition = </World/AnimationGraph/StateMachine/Transition_03/ConditionTimeFractionCrossed>
                rel inputs:state = </World/AnimationGraph/StateMachine/Wave>
                rel outputs:state = </World/AnimationGraph/StateMachine/Idle>
                custom uniform float2 ui:subGraphPosition = (214.67848, 19.848618)

                def ConditionTimeFractionCrossed "ConditionTimeFractionCrossed"
                {
                    float inputs:fraction = 0.9
                    custom uniform float2 ui:position = (-86.279564, 20.74528)
                }
            }
        }
    }

    def OmniGraph "ActionGraph"
    {
        token evaluator:type = "execution"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 6)
        token pipelineStage = "pipelineStageOnDemand"

        def ComputeGraphSettings "computegraphSettings" (
            active = false
        )
        {
            custom token evaluator:type = "execution"
            custom int2 fileFormatVersion = (1, 3)
            custom token flatCacheBacking = "Shared"
            custom token pipelineStage = "pipelineStageOnDemand"
        }

        def OmniGraphNode "write_animation_graph_variable_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn = 0
            prepend uint inputs:execIn.connect = </World/ActionGraph/on_tick.outputs:tick>
            custom rel inputs:graph = </World/AnimationGraph>
            custom token inputs:skelRootPath = ""
            prepend token inputs:skelRootPath.connect = </World/ActionGraph/graph_target.outputs:primPath>
            custom token inputs:value = ""
            prepend token inputs:value.connect = </World/ActionGraph/constant_string_01.inputs:value>
            custom token inputs:variableName = "State"
            token node:type = "omni.anim.graph.WriteAnimationGraphVariable"
            int node:typeVersion = 1
            custom uint outputs:execOut = 1 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-257.93213, -539.6388)
        }

        def OmniGraphNode "write_animation_graph_variable_02" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn = 0
            custom rel inputs:graph = </World/AnimationGraph>
            custom token inputs:skelRootPath = ""
            prepend token inputs:skelRootPath.connect = </World/ActionGraph/graph_target.outputs:primPath>
            custom token inputs:value = ""
            prepend token inputs:value.connect = </World/ActionGraph/constant_string.inputs:value>
            custom token inputs:variableName = "State"
            token node:type = "omni.anim.graph.WriteAnimationGraphVariable"
            int node:typeVersion = 1
            custom uint outputs:execOut = 1 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-262.3646, -302.17578)
        }

        def OmniGraphNode "write_animation_graph_variable_03" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn = 0
            custom rel inputs:graph = </World/AnimationGraph>
            custom token inputs:skelRootPath = ""
            prepend token inputs:skelRootPath.connect = </World/ActionGraph/graph_target_01.outputs:primPath>
            custom token inputs:value = ""
            prepend token inputs:value.connect = </World/ActionGraph/constant_string_02.inputs:value>
            custom token inputs:variableName = "Action"
            token node:type = "omni.anim.graph.WriteAnimationGraphVariable"
            int node:typeVersion = 1
            custom uint outputs:execOut = 1 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-232.79778, 104.68081)
        }

        def OmniGraphNode "graph_target" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:targetPath = "/World/biped_demo"
            token node:type = "omni.graph.nodes.GraphTarget"
            int node:typeVersion = 1
            custom token outputs:primPath = "/World/biped_demo"
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-1115.0985, -564.1085)
        }

        def OmniGraphNode "graph_target_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:targetPath = "/World/biped_demo"
            token node:type = "omni.graph.nodes.GraphTarget"
            int node:typeVersion = 1
            custom token outputs:primPath = "/World/biped_demo"
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-1095.3945, 5.6779175)
        }

        def OmniGraphNode "write_animation_graph_variable" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn = 0
            prepend uint inputs:execIn.connect = </World/ActionGraph/delay.outputs:finished>
            custom rel inputs:graph = </World/AnimationGraph>
            custom token inputs:skelRootPath = ""
            prepend token inputs:skelRootPath.connect = </World/ActionGraph/graph_target_01.outputs:primPath>
            custom token inputs:value = ""
            prepend token inputs:value.connect = </World/ActionGraph/constant_string_03.inputs:value>
            custom token inputs:variableName = "Action"
            token node:type = "omni.anim.graph.WriteAnimationGraphVariable"
            int node:typeVersion = 1
            custom uint outputs:execOut = 1 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (484.37225, 109.521545)
        }

        def OmniGraphNode "delay" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom double inputs:duration = 0.5
            custom uint inputs:execIn = 0
            prepend uint inputs:execIn.connect = </World/ActionGraph/write_animation_graph_variable_03.outputs:execOut>
            token node:type = "omni.graph.action.Delay"
            int node:typeVersion = 1
            custom uint outputs:finished = 4 (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (190.81189, 116.420044)
        }

        def OmniGraphNode "constant_string" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom string inputs:value = "Idle"
            token node:type = "omni.graph.nodes.ConstantString"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-541.1883, -185.58005)
        }

        def OmniGraphNode "constant_string_01" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom string inputs:value = "Move"
            token node:type = "omni.graph.nodes.ConstantString"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-549.73584, -404.366)
        }

        def OmniGraphNode "constant_string_02" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom string inputs:value = "Wave"
            token node:type = "omni.graph.nodes.ConstantString"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-499.1883, 252.42004)
        }

        def OmniGraphNode "constant_string_03" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom string inputs:value = "None"
            token node:type = "omni.graph.nodes.ConstantString"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (232.81189, 292.4201)
        }

        def OmniGraphNode "on_tick" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:framePeriod = 0
            custom bool inputs:onlyPlayback = 1
            token node:type = "omni.graph.action.OnTick"
            int node:typeVersion = 1
            custom double outputs:absoluteSimTime = 30694.90304726269
            custom double outputs:deltaSeconds = 0.010924000293016434
            custom double outputs:frame = 1.0229196548461914
            custom bool outputs:isPlaying = 1
            custom uint outputs:tick = 0 (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time = 0.04262164980173111
            custom double outputs:timeSinceStart = 30722.60546875
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-897.7825, -384.52252)
        }
    }

    def Scope "Animations"
    {
        def "stand_walk_loop_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_loop.skelanim.usd@
        )
        {
        }

        def "stand_idle_loop_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_idle_loop.skelanim.usd@
        )
        {
        }

        def "stand_idle_wave_loop_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_idle_wave_loop.skelanim.usd@
        )
        {
        }
    }

    def DistantLight "DistantLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float angle = 1
        float intensity = 3000
        float shaping:cone:angle = 180
        float shaping:cone:softness
        float shaping:focus
        color3f shaping:focusTint
        asset shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

