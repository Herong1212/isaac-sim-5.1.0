            custom double outputs:deltaSeconds = 0.014918999746441841
            custom double outputs:frame = 43.71418380737305
            custom bool outputs:isPlaying = 1
            custom uint outputs:tick = 0 (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time = 1.8214243650436401
            custom double outputs:timeSinceStart = 608.3399658203125
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-765.421, 97.8051)
        }

