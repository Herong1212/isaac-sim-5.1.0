#usda 1.0
(
    customLayerData = {
        dictionary audioSettings = {
            double dopplerLimit = 2
            double dopplerScale = 1
            token enableDistanceDelay = "off"
            token enableDoppler = "off"
            token enableInterauralDelay = "off"
            double nonSpatialTimeScale = 1
            double spatialTimeScale = 1
            double speedOfSound = 340
        }
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 50000)
                double radius = 500
            }
            dictionary Perspective = {
                double3 position = (-372.1866275511657, 238.93109887098183, 624.3257046464565)
                double3 target = (292.50244715162734, 5.870229439761595, -44.785272758454845)
            }
            dictionary Right = {
                double3 position = (-50000, 0, -1.1102230246251565e-11)
                double radius = 500
            }
            dictionary Top = {
                double3 position = (-4.329780281177466e-12, 50000, 1.1102230246251565e-11)
                double radius = 500
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
            bool "rtx:raytracing:fractionalCutoutOpacity" = 1
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def AnimationGraph "AnimationGraph"
    {
        custom uniform float3 anim:graph:variable:ForwardDirection = (0, 0, 0) (
            doc = ""
        )
        custom uniform float3 anim:graph:variable:MovementDirection = (0, 0, 0) (
            doc = ""
        )
        prepend rel inputs:pose = </World/AnimationGraph/MotionMatching>
        rel skel:skeleton = </World/Character/Root>

        def MotionMatching "MotionMatching"
        {
            prepend rel inputs:clips = [
                </World/Animations/stand_walk_1_skelanim>,
                </World/Animations/stand_walk_1_mirror_skelanim>,
                </World/Animations/stand_walk_2_skelanim>,
                </World/Animations/stand_walk_2_mirror_skelanim>,
                </World/Animations/stand_walk_3_skelanim>,
                </World/Animations/stand_walk_3_mirror_skelanim>,
                </World/Animations/stand_walk_4_skelanim>,
                </World/Animations/stand_walk_4_mirror_skelanim>,
                </World/Animations/stand_walk_5_skelanim>,
                </World/Animations/stand_walk_5_mirror_skelanim>,
                </World/Animations/stand_walk_7_skelanim>,
                </World/Animations/stand_walk_7_mirror_skelanim>,
            ]
            prepend rel inputs:forwardDirection = </World/AnimationGraph/ForwardDirection>
            token[] inputs:joints = ["L_Ball", "R_Ball", "Pelvis"]
            float[] inputs:jointsPositionWeights = [0.75, 0.75, 0]
            prepend rel inputs:movementDirection = </World/AnimationGraph/MovementDirection>
            delete rel inputs:pathPoints = </World/AnimationGraph/PathPoints>
            custom uniform float2 ui:position = (-255.65697, 14.578764)
        }

        def ReadVariable "MovementDirection"
        {
            token inputs:variableName = "MovementDirection"
            custom uniform float2 ui:position = (-519.09406, 82.54014)
        }

        def ReadVariable "ForwardDirection"
        {
            token inputs:variableName = "ForwardDirection"
            custom uniform float2 ui:position = (-493.72455, 185.76776)
        }
    }

    def Scope "Animations"
    {
        def "stand_walk_1_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_1.skelanim.usd@
        )
        {
        }

        def "stand_walk_1_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_1_mirror.skelanim.usd@
        )
        {
        }

        def "stand_walk_2_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_2.skelanim.usd@
        )
        {
        }

        def "stand_walk_2_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_2_mirror.skelanim.usd@
        )
        {
        }

        def "stand_walk_3_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_3.skelanim.usd@
        )
        {
        }

        def "stand_walk_3_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_3_mirror.skelanim.usd@
        )
        {
        }

        def "stand_walk_4_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_4.skelanim.usd@
        )
        {
        }

        def "stand_walk_4_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_4_mirror.skelanim.usd@
        )
        {
        }

        def "stand_walk_5_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_5.skelanim.usd@
        )
        {
        }

        def "stand_walk_5_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_5_mirror.skelanim.usd@
        )
        {
        }

        def "stand_walk_7_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_7.skelanim.usd@
        )
        {
        }

        def "stand_walk_7_mirror_skelanim" (
            prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Animations/NVIDIA/biped_demo/stand_walk_7_mirror.skelanim.usd@
        )
        {
        }
    }

    def "Character" (
        prepend apiSchemas = ["AnimationGraphAPI"]
        prepend references = @https://omniverse-content-staging.s3.us-west-2.amazonaws.com/Assets/AnimGraph/105.0/Characters/NVIDIA/biped_demo.usd@
    )
    {
        rel animationGraph = </World/AnimationGraph>
        custom float anim:graph:variable:ForwardDirection
        custom float anim:graph:variable:MovementDirection
        rel omniGraphs = None

        over "Body_Mesh"
        {
            rel material:binding = None
        }

        def BehaviorScript "BehaviorScript"
        {
            uniform asset scriptPath = @./mm.py@
            rel target = </World/Character>
        }
    }

    def DistantLight "DistantLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float angle = 1
        float intensity = 3000
        float shaping:cone:angle = 180
        float shaping:cone:softness
        float shaping:focus
        color3f shaping:focusTint
        asset shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}
