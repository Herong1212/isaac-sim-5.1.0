        custom uint inputs:hide (
            docs="""Signal to the graph that this node is ready to hide the widget and all its child widgets."""
        )
        custom float inputs:max = 0.0 (
            docs="""The maximum value of the slider"""
        )
        custom float inputs:min = 0.0 (
            docs="""The minimum value of the slider"""
        )
        custom token inputs:parentWidgetPath (
            docs="""The absolute path to the parent widget.
            If empty, this widget will be created as a direct child of Viewport."""
        )
        custom uint inputs:show (
            docs="""Signal to the graph that this node is ready to show the widget and all its child widgets after they become hidden."""
        )
        custom float inputs:step = 0.01 (
            docs="""The step size of the slider"""
        )
        custom uint inputs:tearDown (
            docs="""Signal to the graph that this node is ready to tear down the widget and all its child widgets."""
        )
        custom token inputs:widgetIdentifier (
            docs="""An optional unique identifier for the widget.
            Can be used to refer to this widget in other places such as the OnWidgetClicked node."""
