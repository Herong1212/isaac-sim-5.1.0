        # 12 attributes
        custom uint inputs:create (
            docs="""Signal to the graph that this node is ready to create and show the widget."""
        )
        custom uint inputs:disable (
            docs="""Signal to the graph that this node is ready to disable this button so that it cannot be pressed."""
