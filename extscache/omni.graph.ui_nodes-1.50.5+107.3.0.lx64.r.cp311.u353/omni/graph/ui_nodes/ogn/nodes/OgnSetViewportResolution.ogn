{
    "SetViewportResolution": {
        "version": 1,
        "description": "Sets the resolution of the target viewport.",
        "language": "Python",
        "uiName": "Set Viewport Resolution",
        "categories": [ "graph:action", "viewport" ],
        "exclude": ["tests"],
        "inputs": {
            "exec": {
                "type": "execution",
                "description": "Signal to the graph that this node is ready to be executed."
            },
            "resolution": {
                "type": "int[2]",
                "uiName": "Resolution",
                "description": "The new resolution of the target viewport",
                "default": [512, 512]
            },
            "viewport": {
                "type": "token",
                "description": "Name of the viewport, or empty for the default viewport",
                "uiName": "Viewport",
                "default": "Viewport"
            }
        },
        "outputs": {
            "exec": {
                "type": "execution",
                "description": "Signal to the graph that execution can continue downstream."
            }
        }
    }
}
