def Xform "World"
{
    def Scope "Looks"
    {
        def Material "mtl_test" (
            customData = {
                dictionary position = {
                    dictionary mdl = {
                        double[] output = [27.17398452758789, -37.95730972290039]
                    }
                }
            }
        )
        {
            token outputs:mdl:displacement
            token outputs:mdl:surface.connect = </World/Looks/mtl_test/scratched_metal_v2.outputs:out>
            token outputs:mdl:volume
            token outputs:mtlx:displacement
            token outputs:mtlx:surface
            token outputs:mtlx:volume

            def Shader "scratched_metal_v2" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/core_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "scratched_metal_v2"
                float inputs:anisotropy = 0.45
                float inputs:anisotropy_rotation.connect = </World/Looks/mtl_test/float_const.outputs:out>
                color3f inputs:metal_color = (1, 0, 0)
                float3 inputs:normal.connect = </World/Looks/mtl_test/normal.outputs:out>
                token outputs:out
                uniform float2 ui:nodegraph:node:pos = (-225.24939, -57.52408)
            }

            def Shader "float_const" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "float_const"
                float inputs:f = 0.123
                float outputs:out
                uniform float2 ui:nodegraph:node:pos = (-505.74384, -101.452675)
            }

            def Shader "normal" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "normal"
                float3 outputs:out
                uniform float2 ui:nodegraph:node:pos = (-646.85046, 135.73846)
            }
        }
    }
}

