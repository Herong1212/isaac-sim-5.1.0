#usda 1.0
(
    subLayers = [
        @usdGeom/schema.usda@,
    ]
)

over "GLOBAL" (
	customData = {
	string libraryName = "navSchema"
	string libraryPath = "./"
	string libraryPrefix = "NavSchema"
    bool useLiteralIdentifier = 0
	}
)
{
}

class NavMeshVolume "NavMeshVolume"
(
    doc = """The navigation mesh volume is used to volumetrically filter geometry to be included or excluded in the baked navigation mesh."""
    inherits = </Boundable>
)
{
    token nav:volume:type  = "Include" (
        allowedTokens = ["Include", "Exclude"]
        doc = """The type of the navigation mesh volume."""
        displayName = "Volume Type"
    )
}


class "NavMeshAreaAPI"
(
    doc = """This api can be applied on any USDGeom.Mesh to mark it as being specifically exluded in the baking of the navigation mesh."""
    inherits =</APISchemaBase>
)
{
     string nav:area = "Walkable" (
        doc = """The name of the navigation area to apply to polygons."""
        displayName = "Navigation Area"
    )
}


class "NavMeshExcludeAPI"
(
    doc = """This api can be applied on any UsdGeomXformable or UsdGeomMesh to mark it as being specifically excluded in the baking of the navigation mesh."""
    inherits =</APISchemaBase>
)
{
}
