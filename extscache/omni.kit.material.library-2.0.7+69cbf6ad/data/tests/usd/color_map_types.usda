def Xform "World"
{
    double3 xformOp:rotateXYZ = (0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "OmniPBR"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @../mtl/OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                bool inputs:enable_emission = 1
                token outputs:out
            }
        }

        def Material "OmniPBR_raw_types"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniPBR_raw_types/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniPBR_raw_types/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniPBR_raw_types/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @../mtl/OmniPBR_raw_types.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:ao_texture = @@ (
                    colorSpace = "raw"
                )
                asset inputs:diffuse_texture = @@ (
                    colorSpace = "sRGB"
                )
                bool inputs:enable_emission = 1
                asset inputs:metallic_texture = @@ (
                    colorSpace = "raw"
                )
                asset inputs:normalmap_texture = @@ (
                    colorSpace = "raw"
                )
                asset inputs:opacity_texture = @@ (
                    colorSpace = "raw"
                )
                asset inputs:reflectionroughness_texture = @@ (
                    colorSpace = "raw"
                )
                token outputs:out
            }
        }
    }

    def Sphere "Sphere"
    {
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
        rel material:binding = </World/Looks/OmniPBR> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 50
        custom bool refinementEnableOverride = 1
        custom int refinementLevel = 2
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (27.1489, 59.1469, -86.2958)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cone "Cone"
    {
        uniform token axis = "Y"
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
        double height = 100
        rel material:binding = </World/Looks/OmniPBR_raw_types> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 50
        custom bool refinementEnableOverride = 1
        custom int refinementLevel = 2
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-137.43, 77.6959, 59.7336)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

