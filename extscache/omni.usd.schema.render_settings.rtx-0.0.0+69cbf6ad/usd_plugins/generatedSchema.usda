class "OmniRtxSettingsRtAdvancedAPI_1" (
    apiSchemas = ["OmniRtxSettingsRtAPI_1"]
    doc = "Advanced settings for the RTX Real-Time render mode."
)
{
    bool omni:rtx:rt:caustics:enabled = 0 (
        displayName = "Enabled"
        doc = """Enables the caustics photon tracing pass.
        (deprecated carb setting path: '/rtx/caustics/enabled')"""
    )
    int omni:rtx:rt:caustics:filterIterations = 5 (
        displayName = "Filter iterations"
        doc = """Number of iterations for the denoiser applied to the results of the caustics tracing pass.
       (deprecated carb setting path: '/rtx/raytracing/caustics/eawFilteringSteps')"""
    )
    int omni:rtx:rt:caustics:photonCount = 20 (
        displayName = "Photon count"
        doc = """Number of photons (thousands) to shoot from each light.
       (deprecated carb setting path: '/rtx/raytracing/caustics/photonCountMultiplier')"""
    )
    int omni:rtx:rt:caustics:photonMaxBounces = 4 (
        displayName = "Photon max bounces"
        doc = """Maximum number of bounces to compute for each photon path.
        (deprecated carb setting path: '/rtx/raytracing/caustics/photonMaxBounces')"""
    )
    bool omni:rtx:rt:directLighting:enabled = 1 (
        displayName = "Sampled direct lighting"
        doc = """Use sampled direct lighting for area lights instead of the LTC approximation.
        (deprecated carb setting path: '/rtx/directLighting/enabled')"""
    )
    float omni:rtx:rt:directLighting:maxRayUnexposedIntensity = 6400 (
        displayName = "Max ray intensity"
        doc = """Clamps the brightness of each ray when sampling direct lighting. Lower values reduce noise but increase bias. This value is automatically scaled with the exposure.
        (deprecated carb setting path: '/rtx/directLighting/sampledLighting/maxRayUnexposedIntensity')"""
    )
    bool omni:rtx:rt:directLighting:meshLightSampling = 0 (
        displayName = "Mesh light lighting"
        doc = """Enables direct illumination sampling of geometry with emissive materials.
        (deprecated carb setting path: '/rtx/directLighting/sampledLighting/ris/meshLights')"""
    )
    bool omni:rtx:rt:reflections:enabled = 1 (
        displayName = "Enabled"
        doc = """Enables the glossy reflections pass.
        (deprecated carb setting path: '/rtx/reflections/enabled')"""
    )
    float omni:rtx:rt:reflections:maxRayUnexposedIntensity = 19200 (
        displayName = "Max ray intensity"
        doc = """Clamps the brightness of each ray when sampling reflections. Lower values reduce noise but increase bias. This value is automatically scaled with the exposure.
        (deprecated carb setting path: '/rtx/reflections/sampledLighting/maxRayUnexposedIntensity')"""
    )
    bool omni:rtx:rt:refractions:depthCorrection = 1 (
        displayName = "Depth correction"
        doc = """Improves DoF for translucent (refractive) objects, but can result in worse performance.
        (deprecated carb setting path: '/rtx/translucency/virtualDepth')"""
    )
    bool omni:rtx:rt:refractions:enabled = 1 (
        displayName = "Enabled"
        doc = """Enables the refraction (transmission) pass.
        (deprecated carb setting path: '/rtx/translucency/enabled')"""
    )
    float omni:rtx:rt:refractions:maxRayUnexposedIntensity = 19200 (
        displayName = "Max ray intensity"
        doc = """Clamps the brightness of each ray when sampling refractions. Lower values reduce noise but increase bias. This value is automatically scaled with the exposure.
        (deprecated carb setting path: '/rtx/translucency/maxRayUnexposedIntensity')"""
    )
    bool omni:rtx:rt:refractions:motionCorrection = 1 (
        displayName = "Motion vector correction"
        doc = """Enables motion vectors for translucent (refractive) objects, which can improve temporal rendering such as denoising, but can result in worse performance.
        (deprecated carb setting path: '/rtx/translucency/virtualMotion')"""
    )
    bool omni:rtx:rt:refractions:reflectionInRefraction = 0 (
        displayName = "Reflections in refraction"
        doc = """Enables the calculation of reflections when seen through a refractive object. Enabling this is more correct but leads to worse performance.
        (deprecated carb setting path: '/rtx/translucency/reflectAtAllBounce')"""
    )
    bool omni:rtx:rt:refractions:roughnessSampling = 0 (
        displayName = "Roughness sampling (experimental)"
        doc = """Enables the calculation of glossy (rough) refractions.
        (deprecated carb setting path: '/rtx/translucency/sampleRoughness')"""
    )
    bool omni:rtx:rt:sss:fireflyFiltering = 1 (
        displayName = "Firefly filtering"
        doc = """Enables firefly filtering for the subsurface scattering. This clamps the sss rays to the value of omni:rtx:rt:directLighting:maxRayIntensity
        (deprecated carb setting path: '/rtx/raytracing/subsurface/fireflyFiltering/enabled')"""
    )
    bool omni:rtx:rt:sss:transmission:enabled = 1 (
        displayName = "Enabled"
        doc = """Enables sampling of transmissive subsurface scattering (i.e. light scattering through an object from behind). More accurate, but increases noise and render time.
        (deprecated carb setting path: '/rtx/raytracing/subsurface/transmission/enabled')"""
    )
    int omni:rtx:rt:sss:transmission:samples = 1 (
        displayName = "Samples"
        doc = """Number of samples to trace when evaluating transmissive subsurface scattering. Higher numbers improve image quality at the cost of render time.
        (deprecated carb setting path: '/rtx/raytracing/subsurface/transmission/bsdfSampleCount')"""
    )
    int omni:rtx:rt:sss:transmission:scatteringSamples = 1 (
        displayName = "Scattering samples"
        doc = """Number of connections to the surface to make to evalute in-scattered light for each transmission sample. Higher numbers improve image quality at the cost of render time.
        (deprecated carb setting path: '/rtx/raytracing/subsurface/transmission/perBsdfScatteringSampleCount')"""
    )
}

class "OmniRtxSettingsPtAPI_1" (
    apiSchemas = ["OmniRtxSettingsCommonAPI_1"]
)
{
    bool omni:rtx:pt:adaptiveSampling:enabled = 0 (
        displayName = "Enabled"
        doc = """When enabled, the renderer measures the noise of each pixel and stops sampling when 'Target error' is reached.
