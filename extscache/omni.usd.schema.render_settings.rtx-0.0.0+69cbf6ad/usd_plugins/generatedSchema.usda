        (deprecated carb setting path: '/rtx/pathtracing/ris/meshLights')"""
    )
    bool omni:rtx:pt:radianceCache:enabled = 1 (
        displayName = "Enabled"
        doc = """Enable the reuse of computed radiance via the radiance cache. This can reduce noise at the cost of increased bias.
        (deprecated carb setting path: '/rtx/pathtracing/cached/enabled')"""
    )
    int omni:rtx:pt:samplesPerIteration = 1 (
        displayName = "Samples per iteration"
        doc = """Number of samples rendered by each kernel launch. Larger numbers are more efficient at the cost of latency.
        (deprecated carb setting path: '/rtx/pathtracing/spp')"""
    )
    int omni:rtx:pt:volumes:tracking:maxScatteringSteps = 1024 (
        displayName = "Max scattering steps"
        doc = """Maximum delta tracking steps between bounces. Increase to more than 32 for highly scattering volumes like clouds.
        (deprecated carb setting path: '/rtx/pathtracing/ptvol/maxCollisionCount')"""
    )
    int omni:rtx:pt:volumes:tracking:maxShadowSteps = 32 (
        displayName = "Max scattering steps"
        doc = """Maximum ratio tracking delta steps for shadow rays. Increase to more than 32 for highly scattering volumes like clouds.
        (deprecated carb setting path: '/rtx/pathtracing/ptvol/maxLightCollisionCount')"""
    )
    token omni:rtx:pt:volumes:transmittanceMethod = "biasedRayMarching" (
        allowedTokens = ["biasedRayMarching", "ratioTracking"]
        displayName = "Transmittance method"
        doc = """
        (deprecated carb setting path: '/rtx/pathtracing/ptvol/transmittanceMethod')"""
    )
}

class "OmniRtxCameraExposureAPI_1" (
    doc = """This will be removed in favour of UsdGeomCamera exposure settings in
    24.11, which provides properties with the same names."""
)
{
    float exposure:fStop = 5 (
        doc = """f-stop of the aperture when calculating exposure. Smaller numbers
                 create a brighter image, larger numbers darker.
                 Note that the `fStop` attribute also models the diameter of the camera
                 aperture, but for specifying depth of field.  For practical
                 purposes it is useful to keep the exposure and the depth of field
                 controls separate.
                 (deprecated carb setting path: '/rtx/post/tonemap/fNumber')"""
    )
    float exposure:iso = 100 (
        doc = """The speed rating of the sensor or film when calculating exposure.
                 Higher numbers give a brighter image, lower numbers darker.
                 (deprecated carb setting path: '/rtx/post/tonemap/filmIso')"""
    )
    float exposure:responsivity = 1 (
        doc = """Scalar multiplier representing overall responsivity of the
                 sensor system to light when calculating exposure. Intended to be
                 used as a per camera/lens system measured scaling value.
                 Note: RTX needs this to be 0.8821367311933349 to match the USD
                 result.
                 (deprecated carb setting path: '/rtx/post/tonemap/cm2Factor')"""
    )
    float exposure:time = 1 (
        doc = """Time in seconds that the sensor is exposed to light when calculating exposure.
                 Longer exposure times create a brighter image, shorter times darker.
                 Note that shutter:open and shutter:close model essentially the
                 same property of a physical camera, but are for specifying the
                 size of the motion blur streak which is for practical purposes
                 useful to keep separate.
                 (deprecated carb default value: 0.02)
                 (deprecated carb setting path: '/rtx/post/tonemap/exposureTime')"""
    )
}

class "OmniRtxCameraAutoExposureAPI_1"
{
    float omni:rtx:autoExposure:adaptationSpeed = 3.5 (
        displayName = "Adaptation speed"
        doc = """How fast automatic exposure compensation adapts to changes in image exposure.
        (deprecated carb setting path: '/rtx/post/histogram/tau')"""
    )
    bool omni:rtx:autoExposure:enabled = 0 (
        displayName = "Enabled"
        doc = """Enables auto-exposure on this camera.
        (deprecated carb setting path: '/rtx/post/histogram/enabled')"""
    )
    bool omni:rtx:autoExposure:histogramClamping:enabled = 1 (
        displayName = "Enabled"
        doc = """Enabled clamping of the luminance values fed into the auto-exposure histogram.
        (deprecated carb setting path: '/rtx/post/histogram/useExposureClamping')"""
    )
    float omni:rtx:autoExposure:histogramClamping:maxLuminance = 100000 (
        displayName = "Max luminance"
        doc = """The maximum luminance of the histogram
        (deprecated carb setting path: '/rtx/post/histogram/maxEV')"""
    )
    float omni:rtx:autoExposure:histogramClamping:minLuminance = 50 (
        displayName = "Min luminance"
        doc = """The minimum luminance of the histogram
        (deprecated carb setting path: '/rtx/post/histogram/minEV')"""
    )
    token omni:rtx:autoExposure:histogramFilter = "median" (
        allowedTokens = ["median", "average"]
        displayName = "Histogram filter"
        doc = """Method used to filter the exposure histogram.
       (deprecated carb setting path: '/rtx/post/histogram/filterType')"""
    )
    float omni:rtx:autoExposure:whitePointScale = 10 (
        displayName = "White point scale"
        doc = """Controls the target brightness the auto-exposure aims for. Lower values give a darker image, higher values brighter.
        (deprecated carb setting path: '/rtx/post/histogram/whiteScale')"""
    )
}

class "OmniRtxPostColorGradingAPI_1"
{
    color3f omni:rtx:post:grade:blackPoint = (0, 0, 0) (
        displayName = "Black point"
        doc = """Remaps the range of the image. Raising the black point increases contrast by crushing the shadow tones.
        (deprecated carb setting path: '/rtx/post/colorgrad/blackpoint')"""
    )
    color3f omni:rtx:post:grade:contrast = (1, 1, 1) (
        displayName = "Contrast"
        doc = """Modifies contrast of the image.
        (deprecated carb setting path: '/rtx/post/colorgrad/contrast')"""
    )
    bool omni:rtx:post:grade:enabled = 0 (
        displayName = "Enabled"
        doc = """Enable the color grading pass
        (deprecated carb setting path: '/rtx/post/colorgrad/enabled')"""
    )
    color3f omni:rtx:post:grade:gain = (1, 1, 1) (
        displayName = "Gain"
        doc = """Multiplies the image by the given color. Affected by Lift.
        (deprecated carb setting path: '/rtx/post/colorgrad/gain')"""
    )
    color3f omni:rtx:post:grade:gamma = (1, 1, 1) (
        displayName = "Gamma"
        doc = """Applies a gamma to the image.
        (deprecated carb setting path: '/rtx/post/colorgrad/gamma')"""
    )
    color3f omni:rtx:post:grade:lift = (0, 0, 0) (
        displayName = "Lift"
        doc = """Lifts the toe of the image, pivoting around white, so raising the lift reduces the brightness of values above 1.
        (deprecated carb setting path: '/rtx/post/colorgrad/lift')"""
    )
    color3f omni:rtx:post:grade:multiply = (1, 1, 1) (
        displayName = "Multiply"
        doc = """Multiplies the image by the given color. Not affected by Lift.
        (deprecated carb setting path: '/rtx/post/colorgrad/multiply')"""
    )
    color3f omni:rtx:post:grade:offset = (0, 0, 0) (
        displayName = "Offset"
        doc = """Adds a constant term to the image.
        (deprecated carb setting path: '/rtx/post/colorgrad/offset')"""
    )
    color3f omni:rtx:post:grade:saturation = (1, 1, 1) (
        displayName = "Saturation"
        doc = """Modifies saturation of the image.
        (deprecated carb setting path: '/rtx/post/colorcorr/saturation')"""
    )
    color3f omni:rtx:post:grade:whitePoint = (1, 1, 1) (
        displayName = "White point"
        doc = """Remaps the range of the image. Lowering the white point increases contrast by burning the highlight tones.
        (deprecated carb setting path: '/rtx/post/colorgrad/whitepoint')"""
    )
}

class "OmniRtxPostChromaticAberrationAPI_1"
{
    token omni:rtx:post:chromab:algorithm = "radial" (
        allowedTokens = ["radial", "barrel"]
        displayName = "Algorithm"
        doc = """Choose the shape of the distortion applied to each channel.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/modeR')"""
    )
    float omni:rtx:post:chromab:boundaryBlend:blendFalloff = 0.75 (
        displayName = "Blend falloff"
        doc = """Falloff of the blend region at the boundary of the image
        (deprecated carb setting path: '/rtx/post/chromaticAberration/boundaryBlendFalloff')"""
    )
    float omni:rtx:post:chromab:boundaryBlend:blendSize = 0.25 (
        displayName = "Blend size"
        doc = """Size of the blend region at the boundary of the image
        (deprecated carb setting path: '/rtx/post/chromaticAberration/boundaryBlendRegionSize')"""
    )
    bool omni:rtx:post:chromab:boundaryBlend:mirror = 1 (
        displayName = "Mirror"
        doc = """When enabled, mirrors the image when sampling outside the image extent. With this disabled, the sampler will pull in black at the edges of the image depending on the direction of the distortion.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/mirroredRepeat')"""
    )
    bool omni:rtx:post:chromab:enabled = 0 (
        displayName = "Enabled"
        doc = """Enable the chromatic aberration pass.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/enabled')"""
    )
    float omni:rtx:post:chromab:strengthB = 0.015 (
        displayName = "Strength B"
        doc = """Amount of distortion to apply to the blue channel.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/strengthB')"""
    )
    float omni:rtx:post:chromab:strengthG = -0.075 (
        displayName = "Strength G"
        doc = """Amount of distortion to apply to the green channel.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/strengthG')"""
    )
    float omni:rtx:post:chromab:strengthR = -0.055 (
        displayName = "Strength R"
        doc = """Amount of distortion to apply to the red channel.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/strengthR')"""
    )
    bool omni:rtx:post:chromab:useLanczosSampler = 0 (
        displayName = "Use Lanczos sampler"
        doc = """Use a Lanczos sampler when sampling the image for distortion.
        (deprecated carb setting path: '/rtx/post/chromaticAberration/enableLanczos')"""
    )
}

class "OmniRtxPostBloomPhysicalAPI_1"
{
    float omni:rtx:post:bloom:alphaChannelScale = 1 (
        displayName = "Alpha channel scale"
        doc = """How present the bloom is in the alpha channel.
       (deprecated carb setting path: '/rtx/post/lensFlares/alphaExposureScale')"""
    )
    int omni:rtx:post:bloom:aperture:blades = 5 (
        displayName = "Blades"
        doc = """Number of blades in the aperture diaphragm, resulting in a star with twice that many points. Values less than three will result in a circular aperture.
        (deprecated carb setting path: '/rtx/post/lensFlares/blades')"""
    )
    float omni:rtx:post:bloom:aperture:dust = 0 (
        displayName = "Dust"
        doc = """Adds spots to the aperture shape to simulate dust on the lens.
        (deprecated carb setting path: '/rtx/post/lensFlares/dustStrength')"""
    )
    float omni:rtx:post:bloom:aperture:noise = 0 (
        displayName = "Noise"
        doc = """Adds high-frequency noise to the aperture shape to simulate fine particles on the lens.
        (deprecated carb setting path: '/rtx/post/lensFlares/noiseStrength')"""
    )
    float omni:rtx:post:bloom:aperture:rotation = 5 (
        displayName = "Rotation"
        doc = """Rotation of the aperture diaphragm, in degrees.
        (deprecated carb setting path: '/rtx/post/lensFlares/apertureRotation')"""
    )
    float omni:rtx:post:bloom:aperture:scratches = 0 (
        displayName = "Scratches"
        doc = """Adds lines to the aperture shape to simulate scratches on the lens.
        (deprecated carb setting path: '/rtx/post/lensFlares/scratchStrength')"""
    )
    float omni:rtx:post:bloom:aspectRatio = 1.5 (
        displayName = "Aspect ratio"
        doc = """Aspect ratio of the image projected by the lens. Higher values give a horizontally stretched bloom, lower values give a horizontally squeezed bloom.
        (deprecated carb setting path: '/rtx/post/lensFlares/sensorAspectRatio')"""
    )
    float3 omni:rtx:post:bloom:cutoff = (2, 2, 2) (
        displayName = "Cutoff point"
        doc = """Pixels in the image below the cutoff value will not contribute to the bloom effect.
        (deprecated carb setting path: '/rtx/post/lensFlares/cutoffPoint')"""
    )
    float omni:rtx:post:bloom:cutoffFuzziness = 0.5 (
        displayName = "Cutoff fuzziness"
        doc = """If greater than zero, smoothly blends off the contribution of pixels around the cutoff point. The fuzziness value determines the size of the blend region.
        (deprecated carb setting path: '/rtx/post/lensFlares/cutoffFuzziness')"""
    )
    bool omni:rtx:post:bloom:enabled = 0 (
        displayName = "Enabled"
        doc = """Enable the bloom pass.
        (deprecated carb setting path: '/rtx/post/lensFlares/enabled')"""
    )
    bool omni:rtx:post:bloom:energyConservingBlend = 0 (
        displayName = "Energy-conserving blend"
        doc = """...
        (deprecated carb setting path: '/rtx/post/lensFlares/energyConstrainingBlend')"""
    )
    float omni:rtx:post:bloom:focalLength = 35 (
        displayName = "Focal length"
        doc = """Focal length of the simulated lens, in mm.
        (deprecated carb setting path: '/rtx/post/lensFlares/focalLength')"""
    )
    float omni:rtx:post:bloom:fStop = 5 (
        displayName = "f-stop"
        doc = """f-stop of the simulated lens.
        (deprecated carb setting path: '/rtx/post/lensFlares/fNumber')"""
    )
    float omni:rtx:post:bloom:scale = 1 (
        displayName = "Scale"
        doc = """Brightness of the bloom effect.
        (deprecated carb setting path: '/rtx/post/lensFlares/flareScale')"""
    )
    float omni:rtx:post:bloom:sensorDiagonal = 60 (
        displayName = "Sensor diagonal"
        doc = """Diagonal length of the sensor, in mm.
        (deprecated carb setting path: '/rtx/post/lensFlares/sensorDiagonal')"""
    )
    token omni:rtx:post:bloom:spectral:debugVisualization = "off" (
        allowedTokens = ["off", "aperture", "starburst"]
        displayName = "Debug visualization"
        doc = """Shows a visualization of the aperture shape or its resulting bloom starburst pattern to help when tweaking values.
       (deprecated carb setting path: '/rtx/post/lensFlares/debugVisMode')"""
    )
    float omni:rtx:post:bloom:spectral:samples = 0 (
        displayName = "Samples"
        doc = """Number of samples to take when calculating spectral diffraction.
        (deprecated carb setting path: '/rtx/post/lensFlares/spectralBlurSamples')"""
    )
    float omni:rtx:post:bloom:spectral:scale = 10 (
        displayName = "Scale"
        doc = """Scale of the spectral diffraction to match the size of the non-spectral bloom.
        (deprecated carb setting path: '/rtx/post/lensFlares/spectralBlurIntensity')"""
    )
    float3 omni:rtx:post:bloom:spectral:wavelengths = (380, 550, 770) (
        displayName = "Wavelengths"
        doc = """Wavelengths to use when calculating the spectral diffraction.
        (deprecated carb setting path: '/rtx/post/lensFlares/spectralBlurWavelengthRange')"""
    )
}

class "OmniRtxPostMatteObjectAPI_1"
{
    float omni:rtx:post:matteobject:compositeShift = 0 (
        displayName = "Composite shift"
        doc = """Bias the matte object compositing so it blends into the background better
        (deprecated carb setting path: '/rtx/matteObject/blend/shift')"""
    )
    bool omni:rtx:post:matteobject:enabled = 1 (
        displayName = "Enabled"
        doc = """Enables the matte/shadow pass that composites foreground shadows against the background dome light or image plane when they are received by an object with the matte object property set.
        (deprecated carb setting path: '/rtx/matteObject/enabled')"""
    )
    float omni:rtx:post:matteobject:fadeOut = 0 (
        displayName = "Fade out"
        doc = """Blends the matte object gradually into the background
        (deprecated carb setting path: '/rtx/matteObject/blend/fadeOut')"""
    )
    float omni:rtx:post:matteobject:shadowContrast = 0 (
        displayName = "Shadow contrast"
        doc = """Increases the contrast of the matte shadow
        (deprecated carb setting path: '/rtx/matteObject/blend/contrast')"""
    )
    bool omni:rtx:post:matteobject:shadowsOnly = 0 (
        displayName = "Shadows only"
        doc = """Matte objects only calculate shadows and not reflections which improves performance.
        (deprecated carb setting path: '/rtx/post/matteObject/enableShadowCatcher')"""
    )
    bool omni:rtx:post:matteobject:useApproximateIBL = 0 (
        displayName = "Use approximate IBL"
        doc = """Uses the fast approximate IBL mode for matte objects. This is less accurate, but faster and the difference is often not noticeable.
        (deprecated carb setting path: '/rtx/domeLight/forceMatteUseApproximateIbl')"""
    )
}

class "OmniRtxPostCompositingAPI_1"
{
    bool omni:rtx:post:compositing:blackBackground = 0 (
        displayName = "Force black background"
        doc = """Force the background in the composited image to be black
        (deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/blackBackgroundInComposite')"""
    )
    bool omni:rtx:post:compositing:doComposite = 1 (
        displayName = "Do composite"
        doc = """Composite the foreground render over the backplate texture
        (deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/backgroundComposite')"""
    )
    bool omni:rtx:post:compositing:enabled = 0 (
        displayName = "Enabled"
        doc = """Enables the compositing pass which allows generating an alpha channel and compositing the foreground objects over a backplate image
        (deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/enabled')"""
    )
    bool omni:rtx:post:compositing:outputAlpha = 0 (
        displayName = "Output alpha"
        doc = """Outputs the generated alpha
        (deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/outputAlphaInComposite')"""
    )
    bool omni:rtx:post:compositing:premultiply = 0 (
        displayName = "Premultiply color by alpha"
        doc = """Premultiples the color in the composited image by the alpha channel, as expected by most image formats
        (deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/premultiplyColorByAlpha')"""
    )
}

class "OmniRtxPostTonemapAPI_1"
{
    float omni:rtx:post:tonemap:dither = 0 (
        displayName = "Dither strength"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/dither')"
    )
    token omni:rtx:post:tonemap:operator = "acesApproximation" (
        allowedTokens = ["raw", "none", "reinhard", "modifiedReinhard", "hejiHableAlu", "hableUc2", "acesApproximation", "iray"]
        displayName = "Operator"
        doc = """none: apply no tone-mapping operation in the renderer, handing off to OCIO
        reinhard: Operator based on Erik Reinhard's tone mapping work.
        acesApproximation: The old RTX 'ACES' tonemapper, an approximation of the ACES RRT. Deprecated in favour of the Views supplied by OCIO.
        iray: Reinhard-based operator that matches the operator used by NVIDIA Iray by default.
        (deprecated carb setting path: '/rtx/post/tonemap/op')"""
    )
}

class "OmniRtxPostTonemapIrayReinhardAPI_1" (
    apiSchemas = ["OmniRtxPostTonemapAPI_1"]
)
{
    float omni:rtx:post:tonemap:irayReinhard:burnHighlights = 0.7 (
        displayName = "Burn Highlights"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/irayReinhard/burnHighlights')"
    )
    bool omni:rtx:post:tonemap:irayReinhard:burnHighlightsMaxComponent = 0 (
        displayName = "Burn Highlights max Component"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/irayReinhard/burnHighlightsMaxComponent')"
    )
    bool omni:rtx:post:tonemap:irayReinhard:burnHighlightsPerComponent = 1 (
        displayName = "Burn Highlights per Component"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/irayReinhard/burnHighlightsPerComponent')"
    )
    float omni:rtx:post:tonemap:irayReinhard:crushBlacks = 0.5 (
        displayName = "Crush Blacks"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/irayReinhard/crushBlacks')"
    )
    float omni:rtx:post:tonemap:irayReinhard:saturation = 1 (
        displayName = "Saturation"
        doc = "(deprecated carb setting path: '/rtx/post/tonemap/irayReinhard/saturation')"
    )
}

class "OmniRtxPostDofAPI_1"
{
    float omni:rtx:post:dof:anisotropy = 0 (
        displayName = "Anisotropy"
        doc = """Anisotropy of the lens. A value of -0.5 simulates the depth of field of an anamorphic lens.\r
        (deprecated carb setting path: '/rtx/post/dof/anisotropy')"""
    )
    bool omni:rtx:post:dof:enabled = 0 (
        displayName = "Enabled"
        doc = """Enables Depth of Field. If disabled, camera parameters affecting Depth of Field are ignored.\r
        (deprecated carb setting path: '/rtx/post/dof/enabled')"""
    )
    int omni:rtx:post:dof:focalLength = 100 (
        displayName = "Focal length"
        doc = """The focal length of the lens (in mm). The focal length divided by the f-stop is the aperture diameter.\r
        (deprecated carb setting path: '/rtx/post/dof/focalLength')"""
    )
    int omni:rtx:post:dof:fStop = 1 (
        displayName = "f-stop"
        doc = """f-stop (aperture) of the lens. Lower f-stop numbers decrease the distance range from the Subject Distance where objects remain in focus.\r
        (deprecated carb setting path: '/rtx/post/dof/fNumber')"""
    )
    float omni:rtx:post:dof:subjectDistance = 400 (
        displayName = "Subject distance"
        doc = """Objects at this distance from the camera will be in focus.\r
        (deprecated carb setting path: '/rtx/post/dof/subjectDistance')"""
    )
}

class "OmniRtxPostMotionBlurAPI_1"
{
    bool omni:rtx:post:motionblur:enabled = 0 (
        displayName = "Enabled"
        doc = """Enable the post-processed motion blur pass.
       (deprecated carb setting path: '/rtx/post/motionblur/enabled')"""
    )
    float omni:rtx:post:motionblur:exposureFraction = 1 (
        displayName = "Exposure Fraction"
        doc = """Exposure time fraction in frames (1.0 = one frame duration) to sample.
       (deprecated carb setting path: '/rtx/post/motionblur/exposureFraction')"""
    )
    float omni:rtx:post:motionblur:maxBlurDiameterFraction = 0.02 (
        displayName = "Blur Diameter Fraction"
        doc = """The fraction of the largest screen dimension to use as the maximum motion blur diameter.
       (deprecated carb setting path: '/rtx/post/motionblur/maxBlurDiameterFraction')"""
    )
    int omni:rtx:post:motionblur:numSamples = 8 (
        displayName = "Number of Samples"
        doc = """Number of samples to use in the filter. A higher number improves quality at the cost of performance.
       (deprecated carb setting path: '/rtx/post/motionblur/numSamples')"""
    )
}

class "OmniRtxPostTvNoiseAPI_1"
{
    float omni:rtx:post:tvNoise:colorAmount = 0.6 (
        displayName = "Color Amount"
        doc = """The amount of color offset each grain will be allowed to use.
(deprecated carb setting path: '/rtx/post/tvNoise/colorAmount')"""
    )
    bool omni:rtx:post:tvNoise:enabled = 0 (
        displayName = "TV Noise"
        doc = "(deprecated carb setting path: '/rtx/post/tvNoise/enabled')"
    )
    float omni:rtx:post:tvNoise:filmGrain:amount = 0.05 (
        displayName = "Grain Amount"
        doc = """The intensity of the film grain effect.
(deprecated carb setting path: '/rtx/post/tvNoise/grainAmount')"""
    )
    bool omni:rtx:post:tvNoise:filmGrain:enabled = 1 (
        displayName = "Enable Film Grain"
        doc = """Enables a film grain effect to emulate the graininess in high speed (ISO) film.
(deprecated carb setting path: '/rtx/post/tvNoise/enableFilmGrain')"""
    )
    float omni:rtx:post:tvNoise:filmGrain:size = 1.6 (
        displayName = "Grain Size"
        doc = """The size of the film grains.\r
(deprecated carb setting path: '/rtx/post/tvNoise/grainSize')"""
    )
    bool omni:rtx:post:tvNoise:fixedTime:seed = 0 (
        doc = "(deprecated carb setting path: '/rtx/post/tvNoise/fixedTimeSeed')"
    )
    float omni:rtx:post:tvNoise:fixedTime:seedCount = 0 (
        doc = "(deprecated carb setting path: '/rtx/post/tvNoise/fixedTimeSeedCount')"
    )
    bool omni:rtx:post:tvNoise:ghostFlickering:enabled = 0 (
        displayName = "Enable Ghost Flickering"
        doc = """Introduces a blurred flicker to help emulate an old television.
(deprecated carb setting path: '/rtx/post/tvNoise/enableGhostFlickering')"""
    )
    float omni:rtx:post:tvNoise:lumAmount = 1 (
        displayName = "Luminance Amount"
        doc = """The amount of offset in luminance each grain will be allowed to use.
(deprecated carb setting path: '/rtx/post/tvNoise/lumAmount')"""
    )
    bool omni:rtx:post:tvNoise:randomSplotches:enabled = 0 (
        displayName = "Enable Random Splotches"
        doc = """Introduces random splotches typical of old dirty television.
(deprecated carb setting path: '/rtx/post/tvNoise/enableRandomSplotches')"""
    )
    bool omni:rtx:post:tvNoise:scanlines:enabled = 0 (
        displayName = "Enable Scanlines"
        doc = """Emulates a Scanline Distortion typical of old televisions.
(deprecated carb setting path: '/rtx/post/tvNoise/enableScanlines')"""
    )
    float omni:rtx:post:tvNoise:scanlines:spread = 1 (
        displayName = "Scanline Spreading"
        doc = """How wide the Scanline distortion will be.
(deprecated carb setting path: '/rtx/post/tvNoise/scanlineSpread')"""
    )
    bool omni:rtx:post:tvNoise:scrollBug:enabled = 0 (
        displayName = "Enable Scroll Bug"
        doc = """Emulates sliding typical on old televisions.
(deprecated carb setting path: '/rtx/post/tvNoise/enableScrollBug')"""
    )
    bool omni:rtx:post:tvNoise:verticalLines:enabled = 0 (
        displayName = "Enable Vertical Lines"
        doc = """Introduces random vertical lines to emulate an old television.
(deprecated carb setting path: '/rtx/post/tvNoise/enableVerticalLines')"""
    )
    bool omni:rtx:post:tvNoise:vignetting:enabled = 0 (
        displayName = "Enable Vignetting"
        doc = """Blurred darkening around the screen edges.
(deprecated carb setting path: '/rtx/post/tvNoise/enableVignetting')"""
    )
    bool omni:rtx:post:tvNoise:vignetting:flickering:enabled = 0 (
        displayName = "Enable Vignetting Flickering"
        doc = """Enables a slight flicker effect on the vignette.
(deprecated carb setting path: '/rtx/post/tvNoise/enableVignettingFlickering')"""
    )
    float omni:rtx:post:tvNoise:vignetting:size = 107 (
        displayName = "Vignetting Size"
        doc = """Controls the size of vignette region.
(deprecated carb setting path: '/rtx/post/tvNoise/vignettingSize')"""
    )
    float omni:rtx:post:tvNoise:vignetting:strength = 0.7 (
        displayName = "Vignetting Strength"
        doc = """Controls the intensity of the vignette.
(deprecated carb setting path: '/rtx/post/tvNoise/vignettingStrength')"""
    )
    bool omni:rtx:post:tvNoise:waveDistortion:enabled = 0 (
        displayName = "Enable Wavy Distortion"
        doc = """Introduces a Random Wave Flicker to emulate an old television.
(deprecated carb setting path: '/rtx/post/tvNoise/enableWaveDistortion')"""
    )
}

