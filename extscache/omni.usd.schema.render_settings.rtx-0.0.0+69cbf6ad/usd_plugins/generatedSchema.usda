    )
    float omni:rtx:pt:adaptiveSampling:targetError = 0.001 (
        displayName = "Target error"
        doc = """The noise value treshold after which each pixel will no longer be sampled when adaptive sampling is enabled.
        (deprecated carb setting path: '/rtx/pathtracing/adaptiveSampling/targetError')"""
    )
    float omni:rtx:pt:denoising:blendFactor = 0 (
        displayName = "Blend factor"
        doc = """Radius of the pixel filter. Larger values give a blurrier, less noisy result.
        (deprecated carb setting path: '/rtx/pathtracing/optixDenoiser/blendFactor')"""
    )
    bool omni:rtx:pt:denoising:enabled = 1 (
        displayName = "Enabled"
        doc = """Runs the selected denoiser on the image.
        (deprecated carb setting path: '/rtx/pathtracing/optixDenoiser/enabled')"""
    )
    bool omni:rtx:pt:denoising:optix:denoiseAOVs = 1 (
        displayName = "Temporal mode"
        doc = """Uses motion information to reduce frame-to-frame flickering artifacts in the denoiser.
        (deprecated carb setting path: '/rtx/pathtracing/optixDenoiser/AOV')"""
    )
    bool omni:rtx:pt:denoising:optix:temporal = 0 (
        displayName = "Temporal mode"
        doc = """Uses motion information to reduce frame-to-frame flickering artifacts in the denoiser.
        (deprecated carb setting path: '/rtx/pathtracing/optixDenoiser/temporalMode/enabled')"""
    )
    int omni:rtx:pt:limits:maxBounces = 4 (
        displayName = "Max bounces"
        doc = """Maximum number of ray bounces for any ray type. Higher values give more accurate results, but worse performance.
        (deprecated carb setting path: '/rtx/pathtracing/maxBounces')"""
    )
    int omni:rtx:pt:limits:maxFogBounces = 2 (
        displayName = "Max fog bounces"
        doc = """Maximum number of ray bounces for fog volumes. Higher values give more accurate results, but worse performance.
        (deprecated carb setting path: '/rtx/pathtracing/ptfog/maxBounces')"""
    )
    int omni:rtx:pt:limits:maxGlossyBounces = 6 (
        displayName = "Max glossy bounces"
        doc = """Maximum number of ray bounces for glossy reflection and transmission rays. Higher values give more accurate results, but worse performance.
        (deprecated carb setting path: '/rtx/pathtracing/maxSpecularAndTransmissionBounces')"""
    )
    int omni:rtx:pt:limits:maxVolumeBounces = 2 (
        displayName = "Max volume bounces"
        doc = """Maximum number of ray bounces for non-uniform volumes. Higher values give more accurate results, but worse performance.
        (deprecated carb setting path: '/rtx/pathtracing/ptvol/maxBounces')"""
    )
    token omni:rtx:pt:pixelFilter:filter = "triangle" (
        allowedTokens = ["box", "triangle", "gaussian", "uniform"]
        displayName = "Filter"
        doc = """Sampling pattern for pixel filtering.
        (deprecated carb setting path: '/rtx/pathtracing/aa/op')"""
    )
    float omni:rtx:pt:pixelFilter:radius = 1 (
        displayName = "Radius"
        doc = """Radius of the pixel filter. Larger values give a blurrier, less noisy result.
        (deprecated carb setting path: '/rtx/pathtracing/aa/filterRadius')"""
    )
    int omni:rtx:pt:samplesPerPixel = 512 (
        displayName = "Samples per pixel"
        doc = """Maximum number of samples per pixel. Higher numbers improve image quality at the cose of longer render time.
        (deprecated carb setting path: '/rtx/pathtracing/totalSpp')"""
    )
}

