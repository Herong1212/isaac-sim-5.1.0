        doc = "(deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/backplateLuminanceScale')"
    )
    bool omni:rtx:post:backgroundZeroAlpha:lensDistortionCorrection:enabled = 0 (
        displayName = "Lens Distortion"
        doc = """Enables distortion of the rendered image using a set of lens distortion and undistortion maps.\r
Each of these should refer to a <UDIM> EXR texture set, containing one image for each\r
of the discrete focal length values specified in the array of float settings under\r
/rtx/post/lensDistortion/lensFocalLengthArray (not currently exposed).\r
(deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/enableLensDistortionCorrection')"""
    )
    int omni:rtx:post:backgroundZeroAlpha:sdiio:enabled = 0 (
        doc = "(deprecated carb setting path: '/rtx/post/backgroundZeroAlpha/sdiio/enabled')"
