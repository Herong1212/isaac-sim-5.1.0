class "OmniRtxPostDebugSettingsAPI_1"
{
    token omni:rtx:post:aa:autoExposureMode = "prioritizePPAutoexposure" (
        allowedTokens = ["internal", "prioritizePPAutoexposure", "fixed"]
        doc = "(deprecated carb setting path: '/rtx/post/aa/autoExposureMode')"
    )
    float omni:rtx:post:aa:exposure = 1 (
        doc = "(deprecated carb setting path: '/rtx/post/aa/exposure')"
    )
    float omni:rtx:post:aa:exposureMultiplier = 0.1 (
        doc = "(deprecated carb setting path: '/rtx/post/aa/exposureMultiplier')"
    )
    bool omni:rtx:post:aa:limitedOps = 1 (
        displayName = "Limits AA Ops"
        doc = "(deprecated carb setting path: '/rtx-transient/post/aa/limitedOps')"
    )
    token omni:rtx:post:aa:op = "dlss" (
        allowedTokens = ["none", "taa", "fxaa", "dlss", "rtxaa"]
        displayName = "Super Resolution"
        doc = """DLSS Super Resolution boosts performance by using AI to output higher resolution frames from a lower resolution input.\r
DLSS samples multiple lower resolution images and uses motion data and feedback from prior frames to reconstruct native quality images.\r
(deprecated carb setting path: '/rtx/post/aa/op')"""
    )
    float omni:rtx:post:aa:sharpness = 0.5 (
        doc = "(deprecated carb setting path: '/rtx/post/aa/sharpness')"
    )
